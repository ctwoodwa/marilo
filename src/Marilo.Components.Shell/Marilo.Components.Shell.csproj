<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Marilo.Components.Shell</PackageId>
    <Version>1.0.0</Version>
    <Description>Reusable application shell components (sidebar, slide-overs, layout) for Marilo apps. Server- and WebAssembly-compatible.</Description>
    <PackageTags>blazor;app-shell;layout;sidebar;razor-class-library</PackageTags>
    <IsPackable>true</IsPackable>
    <RootNamespace>Marilo.Components.Layout.AppShell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
