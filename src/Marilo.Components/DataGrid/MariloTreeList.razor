@typeparam TItem
@inherits MariloComponentBase
@implements IColumnHost

<div class="@CombineClasses("mar-treelist")"
     style="@CombineStyles()"
     @attributes="AdditionalAttributes">

    @* Column definitions (hidden, registers via CascadingValue) *@
    <CascadingValue Value="(IColumnHost)this" IsFixed="true">
        @ChildContent
    </CascadingValue>

    <table class="mar-treelist__table" role="treegrid">
        <thead>
            <tr>
                @foreach (var col in EffectiveColumns)
                {
                    <th class="mar-treelist__th" style="@(col.Width != null ? $"width:{col.Width};" : "")">
                        @col.DisplayTitle
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @RenderRows(_rootItems, 0)
        </tbody>
    </table>
</div>
