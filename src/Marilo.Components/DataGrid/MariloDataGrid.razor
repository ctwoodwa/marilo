@using Marilo.Core.Data
@typeparam TItem
@inherits MariloComponentBase

<div id="@_gridId"
     class="@CombineClasses(CssProvider.DataGridClass())"
     style="@CombineStyles(RootStyle)"
     role="grid"
     aria-rowcount="@_displayedItems.Count"
     aria-colcount="@_visibleColumns.Count"
     aria-busy="@(IsLoading ? "true" : null)"
     @attributes="AdditionalAttributes">

    @* Toolbar area *@
    @if (ToolbarTemplate != null)
    {
        <CascadingValue Value="this" IsFixed="true">
            @ToolbarTemplate
        </CascadingValue>
    }

    @* Search box *@
    @if (ShowSearchBox)
    {
        <div class="mar-datagrid-searchbox" role="search">
            <input type="text"
                   class="mar-datagrid-searchbox-input"
                   placeholder="@SearchBoxPlaceholder"
                   value="@_searchText"
                   aria-label="Search grid"
                   @onchange="OnSearchChanged" />
        </div>
    }

    @* Column definitions (hidden, just registers via CascadingValue) *@
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>

    @* Loading overlay *@
    @if (IsLoading)
    {
        <div class="mar-datagrid-loading-overlay" aria-live="polite">
            <div class="mar-datagrid-loading-spinner" role="status">
                <span class="mar-datagrid-loading-text">Loading…</span>
            </div>
        </div>
    }

    <div class="mar-datagrid-content" style="@ContentStyle">
        <table>
            @* Header row *@
            <thead>
                <tr class="@CssProvider.DataGridHeaderClass()" role="row">
                    @if (DetailTemplate != null)
                    {
                        <th class="mar-datagrid-detail-cell" role="columnheader" style="width:40px;"></th>
                    }
                    @if (ShowCheckboxColumn)
                    {
                        <th class="mar-datagrid-checkbox-cell" role="columnheader" style="width:40px;">
                            @if (SelectionMode == GridSelectionMode.Multiple)
                            {
                                <input type="checkbox"
                                       checked="@(_selectedItems.Count > 0 && _selectedItems.Count == _displayedItems.Count)"
                                       aria-label="Select all rows"
                                       @onchange="OnSelectAllChanged" />
                            }
                        </th>
                    }
                    @foreach (var column in _visibleColumns)
                    {
                        var isSortable = Sortable && column.Sortable;
                        var isSorted = _state.SortDescriptors.Any(s => s.Field == column.Field);
                        var sortDir = _state.SortDescriptors.FirstOrDefault(s => s.Field == column.Field);
                        var headerCellClass = CssProvider.DataGridHeaderCellClass(isSortable, isSorted);
                        var headerStyle = column.Width != null ? $"width:{column.Width};" : null;
                        var textAlignStyle = column.TextAlign != null ? $"text-align:{column.TextAlign};" : null;
                        var combinedStyle = string.Join("", new[] { headerStyle, textAlignStyle }.Where(s => s != null));

                        <th class="@headerCellClass"
                            role="columnheader"
                            style="@(string.IsNullOrEmpty(combinedStyle) ? null : combinedStyle)"
                            aria-sort="@GetAriaSortValue(sortDir)"
                            @onclick="(e) => OnHeaderClick(column, isSortable, e)">
                            @if (column.HeaderTemplate != null)
                            {
                                @column.HeaderTemplate
                            }
                            else
                            {
                                @column.DisplayTitle
                            }
                            @if (isSorted && sortDir != null)
                            {
                                var sortOrder = _state.SortDescriptors.IndexOf(sortDir) + 1;
                                <span class="mar-datagrid-sort-indicator" aria-hidden="true">
                                    @(sortDir.Direction == SortDirection.Ascending ? "\u25B2" : "\u25BC")
                                    @if (_state.SortDescriptors.Count > 1)
                                    {
                                        <sub class="mar-datagrid-sort-order">@sortOrder</sub>
                                    }
                                </span>
                            }
                            @if (FilterMode == GridFilterMode.FilterMenu && column.Filterable)
                            {
                                var col = column;
                                <button type="button"
                                        class="mar-datagrid-filter-menu-btn @(_state.FilterDescriptors.Any(f => f.Field == col.Field) ? "mar-datagrid-filter-menu-btn--active" : "")"
                                        aria-label="@($"Filter {column.DisplayTitle}")"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ToggleFilterMenu(col.Field)">
                                    &#x25BD;
                                </button>
                            }
                        </th>
                    }
                    @if (EditMode != GridEditMode.None && EditMode != GridEditMode.InCell)
                    {
                        <th class="mar-datagrid-command-header" role="columnheader">Commands</th>
                    }
                </tr>

                @* Filter row *@
                @if (FilterMode == GridFilterMode.FilterRow)
                {
                    <tr class="@CssProvider.DataGridFilterRowClass()" role="row">
                        @if (DetailTemplate != null)
                        {
                            <td class="@CssProvider.DataGridFilterCellClass()" role="gridcell"></td>
                        }
                        @if (ShowCheckboxColumn)
                        {
                            <td class="@CssProvider.DataGridFilterCellClass()" role="gridcell"></td>
                        }
                        @foreach (var column in _visibleColumns)
                        {
                            <td class="@CssProvider.DataGridFilterCellClass()" role="gridcell">
                                @if (column.Filterable)
                                {
                                    var currentFilter = _state.FilterDescriptors.FirstOrDefault(f => f.Field == column.Field);
                                    <input type="text"
                                           value="@(currentFilter?.Value?.ToString() ?? "")"
                                           placeholder="Filter..."
                                           aria-label="@($"Filter {column.DisplayTitle}")"
                                           @onchange="(e) => OnFilterChanged(column.Field, e)" />
                                }
                            </td>
                        }
                        @if (EditMode != GridEditMode.None && EditMode != GridEditMode.InCell)
                        {
                            <td class="@CssProvider.DataGridFilterCellClass()" role="gridcell"></td>
                        }
                    </tr>
                }

                @* FilterMenu popups *@
                @if (FilterMode == GridFilterMode.FilterMenu && _filterMenuField != null)
                {
                    <tr class="mar-datagrid-filter-menu-row">
                        <td colspan="@TotalColumnCount">
                            @RenderFilterMenu()
                        </td>
                    </tr>
                }
            </thead>

            @* Data rows *@
            <tbody>
                @if (_isCreating && EditMode == GridEditMode.Inline && _editingItem != null)
                {
                    @RenderEditRow(_editingItem)
                }

                @if (_displayedItems.Count == 0 && _groupedRows.Count == 0 && !_isCreating)
                {
                    <tr role="row">
                        <td colspan="@TotalColumnCount" role="gridcell" class="mar-datagrid-empty">
                            @if (NoDataTemplate != null)
                            {
                                @NoDataTemplate
                            }
                            else
                            {
                                <text>No data available.</text>
                            }
                        </td>
                    </tr>
                }
                else if (_groupedRows.Count > 0)
                {
                    @RenderGroupRows(_groupedRows)
                }
                else if (RowTemplate != null)
                {
                    @foreach (var item in _displayedItems)
                    {
                        @RowTemplate(item)
                    }
                }
                else if (EnableVirtualization)
                {
                    <Virtualize Items="@_displayedItems" Context="item" OverscanCount="@VirtualizeOverscanCount">
                        @{ RenderDataRow(item, _displayedItems.IndexOf(item)); }
                    </Virtualize>
                }
                else
                {
                    @for (var i = 0; i < _displayedItems.Count; i++)
                    {
                        var item = _displayedItems[i];
                        @RenderDataRow(item, i)

                        @* Detail row (master-detail) *@
                        @if (DetailTemplate != null && _expandedDetailItems.Contains(item))
                        {
                            <tr class="mar-datagrid-detail-row" role="row">
                                <td colspan="@TotalColumnCount" role="gridcell">
                                    @DetailTemplate(item)
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>

            @* Footer row (aggregates) *@
            @if (_visibleColumns.Any(c => c.FooterTemplate != null))
            {
                <tfoot>
                    <tr class="mar-datagrid-footer-row" role="row">
                        @if (DetailTemplate != null)
                        {
                            <td role="gridcell"></td>
                        }
                        @if (ShowCheckboxColumn)
                        {
                            <td role="gridcell"></td>
                        }
                        @foreach (var column in _visibleColumns)
                        {
                            <td class="mar-datagrid-footer-cell" role="gridcell"
                                style="@(column.TextAlign != null ? $"text-align:{column.TextAlign};" : null)">
                                @if (column.FooterTemplate != null)
                                {
                                    @column.FooterTemplate
                                }
                            </td>
                        }
                        @if (EditMode != GridEditMode.None && EditMode != GridEditMode.InCell)
                        {
                            <td role="gridcell"></td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    @* Popup edit dialog *@
    @if (EditMode == GridEditMode.Popup && _editingItem != null)
    {
        <div class="mar-datagrid-popup-overlay" @onclick="CancelEdit">
            <div class="mar-datagrid-popup-dialog" role="dialog" aria-label="@(_isCreating ? "Add item" : "Edit item")" @onclick:stopPropagation="true">
                <div class="mar-datagrid-popup-header">
                    <h3>@(_isCreating ? "Add New Item" : "Edit Item")</h3>
                </div>
                <div class="mar-datagrid-popup-body">
                    @foreach (var column in _visibleColumns)
                    {
                        <div class="mar-datagrid-popup-field">
                            <label>@column.DisplayTitle</label>
                            @if (column.EditorTemplate != null)
                            {
                                @column.EditorTemplate(_editingItem)
                            }
                            else
                            {
                                <input type="text" value="@column.GetDisplayValue(_editingItem)" disabled />
                            }
                        </div>
                    }
                </div>
                <div class="mar-datagrid-popup-actions">
                    <button type="button" class="mar-datagrid-cmd-btn" @onclick="SaveEdit">Save</button>
                    <button type="button" class="mar-datagrid-cmd-btn" @onclick="CancelEdit">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* Pager *@
    @if (Pageable)
    {
        var totalPages = TotalPages;

        <div class="@CssProvider.DataGridPagerClass()" role="navigation" aria-label="Pagination">
            <button type="button"
                    disabled="@(_state.CurrentPage <= 1)"
                    aria-label="Previous page"
                    @onclick="GoToPreviousPage">
                &laquo; Previous
            </button>

            <span class="mar-datagrid-pager-info">
                Page @_state.CurrentPage of @totalPages
            </span>

            <button type="button"
                    disabled="@(_state.CurrentPage >= totalPages)"
                    aria-label="Next page"
                    @onclick="GoToNextPage">
                Next &raquo;
            </button>

            @if (PageSizes != null && PageSizes.Any())
            {
                <select class="mar-datagrid-pagesize-select"
                        value="@_state.PageSize"
                        aria-label="Items per page"
                        @onchange="OnPageSizeDropdownChanged">
                    @foreach (var size in PageSizes)
                    {
                        <option value="@size" selected="@(size == _state.PageSize)">@size</option>
                    }
                </select>
            }
        </div>
    }
</div>
