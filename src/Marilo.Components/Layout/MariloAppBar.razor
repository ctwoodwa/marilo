@inherits MariloComponentBase

<header class="@CombineClasses(CssProvider.AppBarClass(Position))" style="@CombineStyles()" role="banner" @attributes="AdditionalAttributes">
    @ChildContent
</header>

@code {
    [Parameter] public AppBarPosition Position { get; set; } = AppBarPosition.Top;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
