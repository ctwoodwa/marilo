@inherits MariloComponentBase

<div class="@CombineClasses(CssProvider.StepperClass())" style="@CombineStyles()" @attributes="AdditionalAttributes">
    <div class="mar-stepper__indicators">
        @for (var i = 0; i < _steps.Count; i++)
        {
            var index = i;
            var step = _steps[i];
            var status = index < ActiveStep ? StepStatus.Completed
                       : index == ActiveStep ? StepStatus.Active
                       : StepStatus.Pending;
            <div class="@CssProvider.StepClass(status)">
                <div class="mar-step__indicator">
                    @if (status == StepStatus.Completed)
                    {
                        <span>&#x2713;</span>
                    }
                    else
                    {
                        <span>@(index + 1)</span>
                    }
                </div>
                <div class="mar-step__title">@step.Title</div>
            </div>
        }
    </div>
    <div class="mar-stepper__content">
        <CascadingValue Value="this">
            @ChildContent
        </CascadingValue>
    </div>
</div>

@code {
    private readonly List<MariloStep> _steps = [];

    [Parameter] public int ActiveStep { get; set; }
    [Parameter] public EventCallback<int> ActiveStepChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal void RegisterStep(MariloStep step)
    {
        if (!_steps.Contains(step))
        {
            _steps.Add(step);
            StateHasChanged();
        }
    }

    internal void UnregisterStep(MariloStep step)
    {
        _steps.Remove(step);
        StateHasChanged();
    }

    internal bool IsStepActive(MariloStep step) => _steps.IndexOf(step) == ActiveStep;
}
