@inherits MariloComponentBase

<div class="@CombineClasses(CssProvider.TabsClass())" style="@CombineStyles()" @attributes="AdditionalAttributes">
    <div role="tablist" class="mar-tabs__list">
        @for (var i = 0; i < _panels.Count; i++)
        {
            var index = i;
            var panel = _panels[i];
            <button role="tab"
                    class="@CssProvider.TabPanelClass(index == ActiveIndex)"
                    aria-selected="@(index == ActiveIndex)"
                    @onclick="() => SetActive(index)">
                @panel.Title
            </button>
        }
    </div>
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private readonly List<MariloTabPanel> _panels = [];

    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal void RegisterPanel(MariloTabPanel panel)
    {
        if (!_panels.Contains(panel))
        {
            _panels.Add(panel);
            StateHasChanged();
        }
    }

    internal void UnregisterPanel(MariloTabPanel panel)
    {
        _panels.Remove(panel);
        StateHasChanged();
    }

    internal bool IsPanelActive(MariloTabPanel panel) => _panels.IndexOf(panel) == ActiveIndex;

    private async Task SetActive(int index)
    {
        ActiveIndex = index;
        await ActiveIndexChanged.InvokeAsync(index);
    }
}
