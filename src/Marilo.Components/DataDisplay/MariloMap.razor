@inherits MariloComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@CombineClasses("mar-map")"
     style="@CombineStyles($"width:{Width};height:{Height}")"
     @attributes="AdditionalAttributes">
    <div id="@_containerId" style="width:100%;height:100%;"></div>
</div>

@code {
    /// <summary>Geographic center point of the map.</summary>
    [Parameter] public MapCenter? Center { get; set; }

    /// <summary>Zoom level (1-20). Defaults to 5.</summary>
    [Parameter] public int Zoom { get; set; } = 5;

    /// <summary>Markers displayed on the map.</summary>
    [Parameter] public List<MapMarker> Markers { get; set; } = new();

    /// <summary>CSS width of the map container.</summary>
    [Parameter] public string? Width { get; set; } = "100%";

    /// <summary>CSS height of the map container.</summary>
    [Parameter] public string? Height { get; set; } = "400px";

    /// <summary>URL to a MapLibre style JSON. When set, the map renders real vector tiles.</summary>
    [Parameter] public string? StyleUrl { get; set; }

    /// <summary>Callback invoked when a marker is clicked.</summary>
    [Parameter] public EventCallback<MapMarker> OnMarkerClick { get; set; }

    /// <summary>Whether zooming is enabled.</summary>
    [Parameter] public bool Zoomable { get; set; } = true;

    /// <summary>Whether panning is enabled.</summary>
    [Parameter] public bool Pannable { get; set; } = true;

    private string _containerId = $"mar-map-{Guid.NewGuid():N}";
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<MariloMap>? _dotNetRef;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(StyleUrl))
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/Marilo.Components/js/marilo-map.js");

                var markerData = Markers.Select(m => new { title = m.Title ?? "", latitude = m.Latitude, longitude = m.Longitude }).ToArray();

                await _jsModule.InvokeVoidAsync("initMap", _containerId, new
                {
                    styleUrl = StyleUrl,
                    lng = Center?.Longitude ?? 0,
                    lat = Center?.Latitude ?? 0,
                    zoom = Zoom,
                    zoomable = Zoomable,
                    pannable = Pannable,
                    markers = markerData
                }, _dotNetRef);

                _initialized = true;
            }
            catch (JSException)
            {
                // Module may not be available in test environments
            }
        }
    }

    [JSInvokable]
    public async Task OnMarkerClickFromJs(string title, double latitude, double longitude)
    {
        var marker = Markers.FirstOrDefault(m =>
            m.Latitude == latitude && m.Longitude == longitude)
            ?? new MapMarker { Title = title, Latitude = latitude, Longitude = longitude };

        await OnMarkerClick.InvokeAsync(marker);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null && _initialized)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("disposeMap", _containerId);
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _dotNetRef?.Dispose();
    }
}
