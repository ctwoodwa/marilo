@typeparam TItem where TItem : class
@inherits MariloComponentBase

@{
    var accessor = _accessor!;
    var visible = _flatVisible;

    var containerStyle = new System.Text.StringBuilder();
    if (!string.IsNullOrEmpty(Width)) containerStyle.Append($"width:{Width};");
    if (!string.IsNullOrEmpty(Height)) containerStyle.Append($"height:{Height};");

    var cols = VisibleColumns;
    var useColumns = cols.Count > 0;
}

@* Column definitions (hidden, just registers via CascadingValue) *@
<CascadingValue Value="this" IsFixed="true">
    @GanttColumns
</CascadingValue>

@* View definitions (hidden, registers via IGanttViewHost cascade) *@
<CascadingValue Value="(IGanttViewHost)this" IsFixed="true">
    @GanttViews
</CascadingValue>

<div @ref="_containerRef"
     class="@CombineClasses("mar-gantt")"
     style="@CombineStyles(containerStyle.ToString())"
     @attributes="AdditionalAttributes">
    @if (ShowToolbar)
    {
        <div class="mar-gantt__toolbar">
            @if (_views.Count > 1)
            {
                <div class="mar-gantt__view-selector">
                    @foreach (var v in _views)
                    {
                        <button class="mar-gantt__view-btn @(v.ViewType == View ? "mar-gantt__view-btn--active" : "")"
                                @onclick="() => SwitchView(v.ViewType)">
                            @v.ViewType
                        </button>
                    }
                </div>
            }
            @GanttToolBarTemplate
        </div>
    }
    <div class="mar-gantt__container">
        @* Task list *@
        <div class="mar-gantt__tasklist"
             style="width: @(TaskListWidth)px;"
             role="treegrid"
             aria-label="Task list"
             tabindex="0"
             @onkeydown="HandleKeyDown"
             @onkeydown:preventDefault="true">
            <div class="mar-gantt__tasklist-header" role="row">
                @if (useColumns)
                {
                    @foreach (var col in cols)
                    {
                        var c = col;
                        var headerStyle = "";
                        if (!string.IsNullOrEmpty(c.Width)) headerStyle += $"width:{c.Width};";
                        var isSorted = _sortField is not null && _sortField == c.Field;
                        var headerCssClass = "mar-gantt__header-cell"
                            + (c.Sortable ? " mar-gantt__header--sortable" : "")
                            + (isSorted ? " mar-gantt__header--sorted" : "")
                            + (!string.IsNullOrEmpty(c.HeaderClass) ? $" {c.HeaderClass}" : "");
                        <div class="@headerCssClass"
                             style="@headerStyle"
                             role="columnheader"
                             aria-sort="@(isSorted ? (_sortAscending ? "ascending" : "descending") : (c.Sortable ? "none" : null))"
                             @onclick="() => { if (c.Sortable) SortBy(c.Field); }">
                            @if (c.HeaderTemplate is not null)
                            {
                                @c.HeaderTemplate
                            }
                            else
                            {
                                <span>@c.DisplayTitle</span>
                                @if (isSorted)
                                {
                                    <span class="mar-gantt__sort-indicator">@(_sortAscending ? "▲" : "▼")</span>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <span role="columnheader">Task</span>
                }
            </div>
            @if (useColumns && cols.Any(c => c.Filterable))
            {
                <div class="mar-gantt__filter-row">
                    @foreach (var col in cols)
                    {
                        var c = col;
                        var cellStyle = "";
                        if (!string.IsNullOrEmpty(c.Width)) cellStyle += $"width:{c.Width};";
                        <div class="mar-gantt__task-cell" style="@cellStyle">
                            @if (c.Filterable && !string.IsNullOrEmpty(c.Field))
                            {
                                _filterValues.TryGetValue(c.Field, out var currentVal);
                                var field = c.Field;
                                <input type="text"
                                       class="mar-gantt__filter-input"
                                       placeholder="Filter..."
                                       value="@(currentVal ?? "")"
                                       @oninput="@(e => OnFilterInput(field, e.Value?.ToString() ?? ""))" />
                            }
                        </div>
                    }
                </div>
            }
            @for (var idx = 0; idx < visible.Count; idx++)
            {
                var n = visible[idx];
                var rowIdx = idx;
                var hasChildren = n.Children.Count > 0;
                var expanded = IsExpanded(n);
                var isFocused = rowIdx == _focusedIndex;
                var siblingCount = GetSiblingCount(n);
                var posInSiblings = GetPositionInSiblings(n);
                var rowClass = "mar-gantt__task-row" + (isFocused ? " mar-gantt__task-row--focused" : "");

                @if (useColumns)
                {
                    var isEditing = _editingRowIndex == rowIdx;
                    var editRowClass = rowClass + (isEditing ? " mar-gantt__task-row--editing" : "");

                    <div class="@editRowClass"
                         role="row"
                         aria-level="@(n.Depth + 1)"
                         aria-setsize="@siblingCount"
                         aria-posinset="@posInSiblings"
                         aria-expanded="@(hasChildren ? (expanded ? "true" : "false") : null)"
                         tabindex="@(isFocused ? 0 : -1)"
                         @onclick="() => OnTaskClick.InvokeAsync(n.Item)"
                         @ondblclick="() => BeginEdit(rowIdx)"
                         @ondblclick:stopPropagation="true">
                        @foreach (var col in cols)
                        {
                            var cellStyle = "";
                            if (!string.IsNullOrEmpty(col.Width)) cellStyle += $"width:{col.Width};";
                            if (!string.IsNullOrEmpty(col.TextAlign)) cellStyle += $"text-align:{col.TextAlign};";

                            <div class="mar-gantt__task-cell" role="gridcell" style="@cellStyle">
                                @if (isEditing && col.Editable && !string.IsNullOrEmpty(col.Field))
                                {
                                    @* Editing mode: render input *@
                                    var editField = col.Field;
                                    var inputType = GetInputType(editField);
                                    if (col.Expandable)
                                    {
                                        var pad = (int)(n.Depth * 16 + (hasChildren ? 0 : 16));
                                        <span style="padding-left: @(pad)px; display: inline-flex; align-items: center;">
                                            @if (hasChildren)
                                            {
                                                <button type="button"
                                                        class="mar-gantt__chevron"
                                                        aria-expanded="@(expanded ? "true" : "false")"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => ToggleExpanded(n)">
                                                    @(expanded ? "▼" : "▶")
                                                </button>
                                            }
                                            <input type="@inputType"
                                                   value="@FormatEditValue(editField, _editValues.GetValueOrDefault(editField))"
                                                   @onchange="(e) => _editValues[editField] = ParseValue(editField, e.Value?.ToString())"
                                                   @onclick:stopPropagation="true"
                                                   class="mar-gantt__edit-input" />
                                        </span>
                                    }
                                    else
                                    {
                                        <input type="@inputType"
                                               value="@FormatEditValue(editField, _editValues.GetValueOrDefault(editField))"
                                               @onchange="(e) => _editValues[editField] = ParseValue(editField, e.Value?.ToString())"
                                               @onclick:stopPropagation="true"
                                               class="mar-gantt__edit-input" />
                                    }
                                }
                                else if (col.Expandable)
                                {
                                    var pad = (int)(n.Depth * 16 + (hasChildren ? 0 : 16));
                                    <span style="padding-left: @(pad)px; display: inline-flex; align-items: center;">
                                        @if (hasChildren)
                                        {
                                            <button type="button"
                                                    class="mar-gantt__chevron"
                                                    aria-expanded="@(expanded ? "true" : "false")"
                                                    aria-label="@(expanded ? $"Collapse {accessor.GetTitle(n.Item)}" : $"Expand {accessor.GetTitle(n.Item)}")"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => ToggleExpanded(n)">
                                                @(expanded ? "▼" : "▶")
                                            </button>
                                        }
                                        @if (col.Template is not null)
                                        {
                                            @col.Template(n.Item)
                                        }
                                        else
                                        {
                                            @col.GetDisplayValue(n.Item)
                                        }
                                    </span>
                                }
                                else
                                {
                                    @if (col.Template is not null)
                                    {
                                        @col.Template(n.Item)
                                    }
                                    else
                                    {
                                        @col.GetDisplayValue(n.Item)
                                    }
                                }
                            </div>
                        }
                        @if (isEditing)
                        {
                            <div class="mar-gantt__edit-actions">
                                <button type="button"
                                        class="mar-gantt__edit-btn mar-gantt__edit-btn--save"
                                        title="Save"
                                        @onclick="CommitEdit"
                                        @onclick:stopPropagation="true">&#x2713;</button>
                                <button type="button"
                                        class="mar-gantt__edit-btn mar-gantt__edit-btn--cancel"
                                        title="Cancel"
                                        @onclick="() => CancelEdit()"
                                        @onclick:stopPropagation="true">&#x2717;</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    var pad = (int)(n.Depth * 16 + (hasChildren ? 0 : 16));
                    <div class="@rowClass"
                         role="row"
                         aria-level="@(n.Depth + 1)"
                         aria-setsize="@siblingCount"
                         aria-posinset="@posInSiblings"
                         aria-expanded="@(hasChildren ? (expanded ? "true" : "false") : null)"
                         tabindex="@(isFocused ? 0 : -1)"
                         style="padding-left: @(pad)px;"
                         @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                        @if (hasChildren)
                        {
                            <button type="button"
                                    class="mar-gantt__chevron"
                                    aria-expanded="@(expanded ? "true" : "false")"
                                    aria-label="@(expanded ? $"Collapse {accessor.GetTitle(n.Item)}" : $"Expand {accessor.GetTitle(n.Item)}")"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ToggleExpanded(n)">
                                @(expanded ? "▼" : "▶")
                            </button>
                        }
                        @accessor.GetTitle(n.Item)
                    </div>
                }
            }
        </div>

        @* Timeline *@
        <div class="mar-gantt__timeline" style="overflow-x: auto;">
            @if (UseViewEngine && _slots.Count > 0)
            {
                @* View-driven timeline with main + secondary headers *@
                <div class="mar-gantt__timeline-headers" style="width: @((int)_totalTimelineWidth)px;">
                    <div class="mar-gantt__timeline-header mar-gantt__timeline-header--main">
                        @foreach (var header in _mainHeaders)
                        {
                            var hw = (int)(header.SpanSlots * ActiveView!.SlotWidth);
                            <span class="mar-gantt__date-label mar-gantt__date-label--main" style="width: @(hw)px;">
                                @header.Label
                            </span>
                        }
                    </div>
                    <div class="mar-gantt__timeline-header mar-gantt__timeline-header--secondary">
                        @foreach (var slot in _slots)
                        {
                            var sw = (int)ActiveView!.SlotWidth;
                            <span class="mar-gantt__date-label" style="width: @(sw)px;">
                                @slot.Label
                            </span>
                        }
                    </div>
                </div>

                <div class="mar-gantt__bars" style="width: @((int)_totalTimelineWidth)px; position: relative;">
                    @for (var bi = 0; bi < visible.Count; bi++)
                    {
                        var n = visible[bi];
                        var barIdx = bi;
                        var start = accessor.GetStart(n.Item);
                        var end = accessor.GetEnd(n.Item);
                        var pct = accessor.GetPercentComplete(n.Item);
                        var startOffset = GetPixelOffset(start);
                        var barWidth = GetBarWidth(start, end);
                        var progressWidth = barWidth * (pct / 100.0);
                        var barTitle = accessor.GetTitle(n.Item);

                        <div class="mar-gantt__bar-row">
                            <div class="mar-gantt__bar"
                                 data-index="@barIdx"
                                 role="img"
                                 aria-label="@($"{barTitle}: {start:M/d/yyyy} – {end:M/d/yyyy}")"
                                 style="left: @((int)startOffset)px; width: @((int)barWidth)px;"
                                 @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                                <div class="mar-gantt__bar-resize mar-gantt__bar-resize--left"></div>
                                @if (TaskTemplate is not null)
                                {
                                    @TaskTemplate(n.Item)
                                }
                                else if (pct > 0)
                                {
                                    <div class="mar-gantt__bar-progress" style="width: @((int)progressWidth)px;"></div>
                                    <div class="mar-gantt__bar-progress-handle"
                                         style="left: @((int)progressWidth)px;"></div>
                                }
                                <div class="mar-gantt__bar-resize mar-gantt__bar-resize--right"></div>
                            </div>
                            @if (TooltipTemplate is not null)
                            {
                                <div class="mar-gantt__tooltip" style="left: @((int)startOffset)px;">
                                    @TooltipTemplate(n.Item)
                                </div>
                            }
                            else
                            {
                                <div class="mar-gantt__tooltip" style="left: @((int)startOffset)px;">
                                    <strong>@accessor.GetTitle(n.Item)</strong><br />
                                    @start.ToString("M/d/yyyy") &ndash; @end.ToString("M/d/yyyy")
                                </div>
                            }
                        </div>
                    }
                    @if (_dependencyLines.Count > 0)
                    {
                        <svg class="mar-gantt__dependency-svg" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;">
                            <defs>
                                <marker id="@($"gantt-arrow-{_instanceId}")" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
                                    <path d="M0,0 L10,4 L0,8 Z" fill="#999" />
                                </marker>
                            </defs>
                            @foreach (var dep in _dependencyLines)
                            {
                                <line x1="@dep.X1.ToString("F1")" y1="@dep.Y1.ToString("F1")"
                                      x2="@dep.X2.ToString("F1")" y2="@dep.Y2.ToString("F1")"
                                      stroke="#999" stroke-width="1.5"
                                      marker-end="@($"url(#gantt-arrow-{_instanceId})")" />
                            }
                        </svg>
                    }
                </div>
            }
            else
            {
                @* Legacy DayWidth-based fallback *@
                <div class="mar-gantt__timeline-header" style="width: @((int)_totalTimelineWidth)px;">
                    @{
                        var d = _rangeStart;
                        while (d <= _rangeEnd)
                        {
                            <span class="mar-gantt__date-label" style="width: @(DayWidth)px;">
                                @d.ToString("M/d")
                            </span>
                            d = d.AddDays(1);
                        }
                    }
                </div>

                <div class="mar-gantt__bars" style="width: @((int)_totalTimelineWidth)px; position: relative;">
                    @for (var bi = 0; bi < visible.Count; bi++)
                    {
                        var n = visible[bi];
                        var barIdx = bi;
                        var start = accessor.GetStart(n.Item);
                        var end = accessor.GetEnd(n.Item);
                        var pct = accessor.GetPercentComplete(n.Item);
                        var startOffset = GetPixelOffset(start);
                        var barWidth = GetBarWidth(start, end);
                        var progressWidth = barWidth * (pct / 100.0);
                        var barTitle = accessor.GetTitle(n.Item);

                        <div class="mar-gantt__bar-row">
                            <div class="mar-gantt__bar"
                                 data-index="@barIdx"
                                 role="img"
                                 aria-label="@($"{barTitle}: {start:M/d/yyyy} – {end:M/d/yyyy}")"
                                 style="left: @((int)startOffset)px; width: @((int)barWidth)px;"
                                 @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                                <div class="mar-gantt__bar-resize mar-gantt__bar-resize--left"></div>
                                @if (TaskTemplate is not null)
                                {
                                    @TaskTemplate(n.Item)
                                }
                                else if (pct > 0)
                                {
                                    <div class="mar-gantt__bar-progress" style="width: @((int)progressWidth)px;"></div>
                                    <div class="mar-gantt__bar-progress-handle"
                                         style="left: @((int)progressWidth)px;"></div>
                                }
                                <div class="mar-gantt__bar-resize mar-gantt__bar-resize--right"></div>
                            </div>
                            @if (TooltipTemplate is not null)
                            {
                                <div class="mar-gantt__tooltip" style="left: @((int)startOffset)px;">
                                    @TooltipTemplate(n.Item)
                                </div>
                            }
                            else
                            {
                                <div class="mar-gantt__tooltip" style="left: @((int)startOffset)px;">
                                    <strong>@accessor.GetTitle(n.Item)</strong><br />
                                    @start.ToString("M/d/yyyy") &ndash; @end.ToString("M/d/yyyy")
                                </div>
                            }
                        </div>
                    }
                    @if (_dependencyLines.Count > 0)
                    {
                        <svg class="mar-gantt__dependency-svg" style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;">
                            <defs>
                                <marker id="@($"gantt-arrow-{_instanceId}")" markerWidth="10" markerHeight="8" refX="10" refY="4" orient="auto">
                                    <path d="M0,0 L10,4 L0,8 Z" fill="#999" />
                                </marker>
                            </defs>
                            @foreach (var dep in _dependencyLines)
                            {
                                <line x1="@dep.X1.ToString("F1")" y1="@dep.Y1.ToString("F1")"
                                      x2="@dep.X2.ToString("F1")" y2="@dep.Y2.ToString("F1")"
                                      stroke="#999" stroke-width="1.5"
                                      marker-end="@($"url(#gantt-arrow-{_instanceId})")" />
                            }
                        </svg>
                    }
                </div>
            }
        </div>
    </div>
</div>
