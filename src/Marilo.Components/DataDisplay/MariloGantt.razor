@typeparam TItem where TItem : class
@using Marilo.Components.DataDisplay
@inherits MariloComponentBase

@{
    var accessor = _accessor!;
    var tasks = (Data ?? Enumerable.Empty<TItem>()).ToList();
    var minDate = tasks.Count > 0 ? tasks.Min(t => accessor.GetStart(t)) : DateTime.Today;
    var maxDate = tasks.Count > 0 ? tasks.Max(t => accessor.GetEnd(t)) : DateTime.Today.AddDays(30);
    var totalDays = (maxDate - minDate).TotalDays;
    if (totalDays <= 0) totalDays = 1;

    var containerStyle = new System.Text.StringBuilder();
    if (!string.IsNullOrEmpty(Width)) containerStyle.Append($"width:{Width};");
    if (!string.IsNullOrEmpty(Height)) containerStyle.Append($"height:{Height};");
}

<div class="@CombineClasses("mar-gantt")"
     style="@CombineStyles(containerStyle.ToString())"
     @attributes="AdditionalAttributes">
    <div class="mar-gantt__container">
        @* Task list *@
        <div class="mar-gantt__tasklist" style="width: @(TaskListWidth)px;">
            <div class="mar-gantt__tasklist-header">
                <span>Task</span>
            </div>
            @foreach (var task in tasks)
            {
                var t = task;
                <div class="mar-gantt__task-row"
                     @onclick="() => OnTaskClick.InvokeAsync(t)">
                    @accessor.GetTitle(t)
                </div>
            }
        </div>

        @* Timeline *@
        <div class="mar-gantt__timeline" style="overflow-x: auto;">
            <div class="mar-gantt__timeline-header" style="width: @((int)(totalDays * DayWidth))px;">
                @{
                    var d = minDate;
                    while (d <= maxDate)
                    {
                        <span class="mar-gantt__date-label" style="width: @(DayWidth)px;">
                            @d.ToString("M/d")
                        </span>
                        d = d.AddDays(1);
                    }
                }
            </div>

            <div class="mar-gantt__bars" style="width: @((int)(totalDays * DayWidth))px;">
                @foreach (var task in tasks)
                {
                    var t = task;
                    var start = accessor.GetStart(t);
                    var end = accessor.GetEnd(t);
                    var pct = accessor.GetPercentComplete(t);
                    var startOffset = (start - minDate).TotalDays * DayWidth;
                    var barWidth = Math.Max((end - start).TotalDays * DayWidth, 4);
                    var progressWidth = barWidth * (pct / 100.0);

                    <div class="mar-gantt__bar-row">
                        <div class="mar-gantt__bar"
                             style="left: @((int)startOffset)px; width: @((int)barWidth)px;"
                             @onclick="() => OnTaskClick.InvokeAsync(t)">
                            @if (pct > 0)
                            {
                                <div class="mar-gantt__bar-progress" style="width: @((int)progressWidth)px;"></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private GanttFieldAccessor<TItem>? _accessor;
    private string? _accessorKey;

    [Parameter] public IEnumerable<TItem> Data { get; set; } = Enumerable.Empty<TItem>();

    [Parameter] public string IdField { get; set; } = "Id";
    [Parameter] public string ParentIdField { get; set; } = "ParentId";
    [Parameter] public string TitleField { get; set; } = "Title";
    [Parameter] public string StartField { get; set; } = "Start";
    [Parameter] public string EndField { get; set; } = "End";
    [Parameter] public string PercentCompleteField { get; set; } = "PercentComplete";
    [Parameter] public string DependsOnField { get; set; } = "DependsOn";

    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }

    [Parameter] public int TaskListWidth { get; set; } = 250;
    [Parameter] public int DayWidth { get; set; } = 30;
    [Parameter] public int RowHeight { get; set; } = 36;

    [Parameter] public EventCallback<TItem> OnTaskClick { get; set; }
    [Parameter] public EventCallback<TItem> OnTaskEdit { get; set; }

    protected override void OnParametersSet()
    {
        _accessor = GetAccessor();
        base.OnParametersSet();
    }

    private GanttFieldAccessor<TItem> GetAccessor()
    {
        var key = $"{IdField}|{ParentIdField}|{TitleField}|{StartField}|{EndField}|{PercentCompleteField}|{DependsOnField}";
        if (_accessor is null || _accessorKey != key)
        {
            _accessor = new GanttFieldAccessor<TItem>(
                IdField, ParentIdField, TitleField, StartField, EndField, PercentCompleteField, DependsOnField);
            _accessorKey = key;
        }
        return _accessor;
    }
}
