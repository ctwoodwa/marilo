@typeparam TItem where TItem : class
@inherits MariloComponentBase

@{
    var accessor = _accessor!;
    var visible = _flatVisible;
    var minDate = visible.Count > 0 ? visible.Min(n => accessor.GetStart(n.Item)) : DateTime.Today;
    var maxDate = visible.Count > 0 ? visible.Max(n => accessor.GetEnd(n.Item)) : DateTime.Today.AddDays(30);
    var totalDays = (maxDate - minDate).TotalDays;
    if (totalDays <= 0) totalDays = 1;

    var containerStyle = new System.Text.StringBuilder();
    if (!string.IsNullOrEmpty(Width)) containerStyle.Append($"width:{Width};");
    if (!string.IsNullOrEmpty(Height)) containerStyle.Append($"height:{Height};");
}

<div class="@CombineClasses("mar-gantt")"
     style="@CombineStyles(containerStyle.ToString())"
     @attributes="AdditionalAttributes">
    <div class="mar-gantt__container">
        @* Task list *@
        <div class="mar-gantt__tasklist" style="width: @(TaskListWidth)px;">
            <div class="mar-gantt__tasklist-header">
                <span>Task</span>
            </div>
            @foreach (var node in visible)
            {
                var n = node;
                var hasChildren = n.Children.Count > 0;
                var pad = (int)(n.Depth * 16 + (hasChildren ? 0 : 16));
                var expanded = IsExpanded(n);
                <div class="mar-gantt__task-row"
                     style="padding-left: @(pad)px;"
                     @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                    @if (hasChildren)
                    {
                        <button type="button"
                                class="mar-gantt__chevron"
                                aria-expanded="@(expanded ? "true" : "false")"
                                aria-label="@(expanded ? "Collapse" : "Expand")"
                                @onclick:stopPropagation="true"
                                @onclick="() => ToggleExpanded(n)">
                            @(expanded ? "▼" : "▶")
                        </button>
                    }
                    @accessor.GetTitle(n.Item)
                </div>
            }
        </div>

        @* Timeline *@
        <div class="mar-gantt__timeline" style="overflow-x: auto;">
            <div class="mar-gantt__timeline-header" style="width: @((int)(totalDays * DayWidth))px;">
                @{
                    var d = minDate;
                    while (d <= maxDate)
                    {
                        <span class="mar-gantt__date-label" style="width: @(DayWidth)px;">
                            @d.ToString("M/d")
                        </span>
                        d = d.AddDays(1);
                    }
                }
            </div>

            <div class="mar-gantt__bars" style="width: @((int)(totalDays * DayWidth))px;">
                @foreach (var node in visible)
                {
                    var n = node;
                    var start = accessor.GetStart(n.Item);
                    var end = accessor.GetEnd(n.Item);
                    var pct = accessor.GetPercentComplete(n.Item);
                    var startOffset = (start - minDate).TotalDays * DayWidth;
                    var barWidth = Math.Max((end - start).TotalDays * DayWidth, 4);
                    var progressWidth = barWidth * (pct / 100.0);

                    <div class="mar-gantt__bar-row">
                        <div class="mar-gantt__bar"
                             style="left: @((int)startOffset)px; width: @((int)barWidth)px;"
                             @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                            @if (pct > 0)
                            {
                                <div class="mar-gantt__bar-progress" style="width: @((int)progressWidth)px;"></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
