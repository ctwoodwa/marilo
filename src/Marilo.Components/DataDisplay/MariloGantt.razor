@typeparam TItem where TItem : class
@inherits MariloComponentBase

@{
    var accessor = _accessor!;
    var visible = _flatVisible;

    var containerStyle = new System.Text.StringBuilder();
    if (!string.IsNullOrEmpty(Width)) containerStyle.Append($"width:{Width};");
    if (!string.IsNullOrEmpty(Height)) containerStyle.Append($"height:{Height};");

    var cols = VisibleColumns;
    var useColumns = cols.Count > 0;
}

@* Column definitions (hidden, just registers via CascadingValue) *@
<CascadingValue Value="this" IsFixed="true">
    @GanttColumns
</CascadingValue>

@* View definitions (hidden, registers via IGanttViewHost cascade) *@
<CascadingValue Value="(IGanttViewHost)this" IsFixed="true">
    @GanttViews
</CascadingValue>

<div class="@CombineClasses("mar-gantt")"
     style="@CombineStyles(containerStyle.ToString())"
     @attributes="AdditionalAttributes">
    <div class="mar-gantt__container">
        @* Task list *@
        <div class="mar-gantt__tasklist" style="width: @(TaskListWidth)px;">
            <div class="mar-gantt__tasklist-header">
                @if (useColumns)
                {
                    @foreach (var col in cols)
                    {
                        var c = col;
                        var headerStyle = "";
                        if (!string.IsNullOrEmpty(c.Width)) headerStyle += $"width:{c.Width};";
                        var isSorted = _sortField is not null && _sortField == c.Field;
                        var headerCssClass = "mar-gantt__header-cell"
                            + (c.Sortable ? " mar-gantt__header--sortable" : "")
                            + (isSorted ? " mar-gantt__header--sorted" : "")
                            + (!string.IsNullOrEmpty(c.HeaderClass) ? $" {c.HeaderClass}" : "");
                        <div class="@headerCssClass"
                             style="@headerStyle"
                             role="columnheader"
                             aria-sort="@(isSorted ? (_sortAscending ? "ascending" : "descending") : null)"
                             @onclick="() => { if (c.Sortable) SortBy(c.Field); }">
                            @if (c.HeaderTemplate is not null)
                            {
                                @c.HeaderTemplate
                            }
                            else
                            {
                                <span>@c.DisplayTitle</span>
                                @if (isSorted)
                                {
                                    <span class="mar-gantt__sort-indicator">@(_sortAscending ? "▲" : "▼")</span>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <span>Task</span>
                }
            </div>
            @foreach (var node in visible)
            {
                var n = node;
                var hasChildren = n.Children.Count > 0;
                var expanded = IsExpanded(n);

                @if (useColumns)
                {
                    <div class="mar-gantt__task-row"
                         @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                        @foreach (var col in cols)
                        {
                            var cellStyle = "";
                            if (!string.IsNullOrEmpty(col.Width)) cellStyle += $"width:{col.Width};";
                            if (!string.IsNullOrEmpty(col.TextAlign)) cellStyle += $"text-align:{col.TextAlign};";

                            <div class="mar-gantt__task-cell" style="@cellStyle">
                                @if (col.Expandable)
                                {
                                    var pad = (int)(n.Depth * 16 + (hasChildren ? 0 : 16));
                                    <span style="padding-left: @(pad)px; display: inline-flex; align-items: center;">
                                        @if (hasChildren)
                                        {
                                            <button type="button"
                                                    class="mar-gantt__chevron"
                                                    aria-expanded="@(expanded ? "true" : "false")"
                                                    aria-label="@(expanded ? "Collapse" : "Expand")"
                                                    @onclick:stopPropagation="true"
                                                    @onclick="() => ToggleExpanded(n)">
                                                @(expanded ? "▼" : "▶")
                                            </button>
                                        }
                                        @if (col.Template is not null)
                                        {
                                            @col.Template(n.Item)
                                        }
                                        else
                                        {
                                            @col.GetDisplayValue(n.Item)
                                        }
                                    </span>
                                }
                                else
                                {
                                    @if (col.Template is not null)
                                    {
                                        @col.Template(n.Item)
                                    }
                                    else
                                    {
                                        @col.GetDisplayValue(n.Item)
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    var pad = (int)(n.Depth * 16 + (hasChildren ? 0 : 16));
                    <div class="mar-gantt__task-row"
                         style="padding-left: @(pad)px;"
                         @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                        @if (hasChildren)
                        {
                            <button type="button"
                                    class="mar-gantt__chevron"
                                    aria-expanded="@(expanded ? "true" : "false")"
                                    aria-label="@(expanded ? "Collapse" : "Expand")"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ToggleExpanded(n)">
                                @(expanded ? "▼" : "▶")
                            </button>
                        }
                        @accessor.GetTitle(n.Item)
                    </div>
                }
            }
        </div>

        @* Timeline *@
        <div class="mar-gantt__timeline" style="overflow-x: auto;">
            @if (UseViewEngine && _slots.Count > 0)
            {
                @* View-driven timeline with main + secondary headers *@
                <div class="mar-gantt__timeline-headers" style="width: @((int)_totalTimelineWidth)px;">
                    <div class="mar-gantt__timeline-header mar-gantt__timeline-header--main">
                        @foreach (var header in _mainHeaders)
                        {
                            var hw = (int)(header.SpanSlots * ActiveView!.SlotWidth);
                            <span class="mar-gantt__date-label mar-gantt__date-label--main" style="width: @(hw)px;">
                                @header.Label
                            </span>
                        }
                    </div>
                    <div class="mar-gantt__timeline-header mar-gantt__timeline-header--secondary">
                        @foreach (var slot in _slots)
                        {
                            var sw = (int)ActiveView!.SlotWidth;
                            <span class="mar-gantt__date-label" style="width: @(sw)px;">
                                @slot.Label
                            </span>
                        }
                    </div>
                </div>

                <div class="mar-gantt__bars" style="width: @((int)_totalTimelineWidth)px;">
                    @foreach (var node in visible)
                    {
                        var n = node;
                        var start = accessor.GetStart(n.Item);
                        var end = accessor.GetEnd(n.Item);
                        var pct = accessor.GetPercentComplete(n.Item);
                        var startOffset = GetPixelOffset(start);
                        var barWidth = GetBarWidth(start, end);
                        var progressWidth = barWidth * (pct / 100.0);

                        <div class="mar-gantt__bar-row">
                            <div class="mar-gantt__bar"
                                 style="left: @((int)startOffset)px; width: @((int)barWidth)px;"
                                 @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                                @if (pct > 0)
                                {
                                    <div class="mar-gantt__bar-progress" style="width: @((int)progressWidth)px;"></div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                @* Legacy DayWidth-based fallback *@
                <div class="mar-gantt__timeline-header" style="width: @((int)_totalTimelineWidth)px;">
                    @{
                        var d = _rangeStart;
                        while (d <= _rangeEnd)
                        {
                            <span class="mar-gantt__date-label" style="width: @(DayWidth)px;">
                                @d.ToString("M/d")
                            </span>
                            d = d.AddDays(1);
                        }
                    }
                </div>

                <div class="mar-gantt__bars" style="width: @((int)_totalTimelineWidth)px;">
                    @foreach (var node in visible)
                    {
                        var n = node;
                        var start = accessor.GetStart(n.Item);
                        var end = accessor.GetEnd(n.Item);
                        var pct = accessor.GetPercentComplete(n.Item);
                        var startOffset = GetPixelOffset(start);
                        var barWidth = GetBarWidth(start, end);
                        var progressWidth = barWidth * (pct / 100.0);

                        <div class="mar-gantt__bar-row">
                            <div class="mar-gantt__bar"
                                 style="left: @((int)startOffset)px; width: @((int)barWidth)px;"
                                 @onclick="() => OnTaskClick.InvokeAsync(n.Item)">
                                @if (pct > 0)
                                {
                                    <div class="mar-gantt__bar-progress" style="width: @((int)progressWidth)px;"></div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
