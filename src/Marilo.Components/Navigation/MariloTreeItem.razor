@inherits MariloComponentBase

<li class="@CombineClasses(CssProvider.TreeItemClass(IsExpanded, IsSelected))"
    style="@CombineStyles()"
    role="treeitem"
    aria-expanded="@(HasChildren ? IsExpanded.ToString().ToLower() : null)"
    aria-selected="@IsSelected.ToString().ToLower()"
    @attributes="AdditionalAttributes">
    <div class="mar-tree-item__header">
        @if (HasChildren)
        {
            <button type="button"
                    class="mar-tree-item__toggle"
                    aria-label="@(IsExpanded ? "Collapse" : "Expand")"
                    @onclick="ToggleExpanded">
                @(IsExpanded ? "\u25BC" : "\u25B6")
            </button>
        }
        @if (TreeView?.ShowCheckboxes == true)
        {
            <input type="checkbox"
                   class="mar-tree-item__checkbox"
                   checked="@(TreeView.IsItemChecked(Id ?? Title))"
                   @onchange="OnCheckboxChanged" />
        }
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="mar-tree-item__icon">@IconProvider.GetIcon(Icon, Marilo.Core.Enums.IconSize.Small)</span>
        }
        @if (!string.IsNullOrEmpty(Url))
        {
            <a class="mar-tree-item__title" href="@Url">@Title</a>
        }
        else
        {
            <span class="mar-tree-item__title" @onclick="HandleClick">@Title</span>
        }
    </div>
    @if (ChildContent != null && IsExpanded)
    {
        <ul role="group" class="mar-tree-item__children">
            @ChildContent
        </ul>
    }
</li>

@code {
    [CascadingParameter] public MariloTreeView? TreeView { get; set; }

    /// <summary>Unique identifier for this item.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Display text for the tree item.</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>Icon name/class for the tree item.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Navigation URL. When set, the title renders as a link.</summary>
    [Parameter] public string? Url { get; set; }

    /// <summary>Whether this item is expanded.</summary>
    [Parameter] public bool IsExpanded { get; set; }

    /// <summary>Fires when the expanded state changes.</summary>
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }

    /// <summary>Whether this item is selected.</summary>
    [Parameter] public bool IsSelected { get; set; }

    /// <summary>Fires when clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Child tree items.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool HasChildren => ChildContent != null;

    private async Task ToggleExpanded()
    {
        IsExpanded = !IsExpanded;
        await IsExpandedChanged.InvokeAsync(IsExpanded);
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }

    private void OnCheckboxChanged(ChangeEventArgs e)
    {
        TreeView?.ToggleItemChecked(Id ?? Title);
    }
}
