@inherits MariloComponentBase

<div class="@CombineClasses(CssProvider.FileUploadClass())"
     style="@CombineStyles()"
     @attributes="AdditionalAttributes">
    <label class="mar-file-upload__zone">
        <span class="mar-file-upload__icon">
            @IconProvider.GetIcon("upload", IconSize.Medium)
        </span>
        <span class="mar-file-upload__text">
            @if (_selectedFiles.Any())
            {
                @string.Join(", ", _selectedFiles.Select(f => f.Name))
            }
            else
            {
                <text>Choose file@(Multiple ? "s" : "") or drag and drop</text>
            }
        </span>
        <InputFile OnChange="HandleFileSelected"
                   multiple="@Multiple"
                   accept="@Accept"
                   disabled="@Disabled"
                   class="mar-file-upload__input" />
    </label>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="mar-file-upload__error" role="alert">@_errorMessage</div>
    }

    @if (_initialFileEntries.Any() || _selectedFiles.Any())
    {
        <ul class="@CssProvider.FileUploadFileListClass()">
            @foreach (var entry in _initialFileEntries)
            {
                <li class="mar-file-upload__file-item">
                    <span class="mar-file-upload__file-name">@entry.Name</span>
                    <span class="mar-file-upload__file-size">@FormatFileSize(entry.Size)</span>
                    <button type="button"
                            class="mar-file-upload__file-remove"
                            aria-label="Remove @entry.Name"
                            @onclick="() => RemoveInitialFile(entry)">&#x2715;</button>
                </li>
            }
            @foreach (var file in _selectedFiles)
            {
                <li class="mar-file-upload__file-item">
                    <span class="mar-file-upload__file-name">@file.Name</span>
                    <span class="mar-file-upload__file-size">@FormatFileSize(file.Size)</span>
                    <button type="button"
                            class="mar-file-upload__file-remove"
                            aria-label="Remove @file.Name"
                            @onclick="() => RemoveFile(file)">&#x2715;</button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> OnFilesSelected { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string? Accept { get; set; }
    [Parameter] public long MaxFileSize { get; set; } = 10 * 1024 * 1024;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public IEnumerable<FileUploadInfo>? InitialFiles { get; set; }

    private List<IBrowserFile> _selectedFiles = new();
    private List<FileUploadInfo> _initialFileEntries = new();
    private string? _errorMessage;
    private bool _initialFilesLoaded;

    protected override void OnParametersSet()
    {
        if (!_initialFilesLoaded && InitialFiles != null)
        {
            _initialFileEntries = InitialFiles.ToList();
            _initialFilesLoaded = true;
        }
    }

    private void RemoveInitialFile(FileUploadInfo entry)
    {
        _initialFileEntries.Remove(entry);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        var files = Multiple ? e.GetMultipleFiles().ToList() : new List<IBrowserFile> { e.File };

        var oversized = files.Where(f => f.Size > MaxFileSize).ToList();
        if (oversized.Any())
        {
            var names = string.Join(", ", oversized.Select(f => f.Name));
            _errorMessage = $"File(s) exceed maximum size of {FormatFileSize(MaxFileSize)}: {names}";
            files = files.Except(oversized).ToList();
        }

        _selectedFiles = files;
        await OnFilesSelected.InvokeAsync(files);
    }

    private async Task RemoveFile(IBrowserFile file)
    {
        _selectedFiles.Remove(file);
        _errorMessage = null;
        await OnFilesSelected.InvokeAsync(_selectedFiles);
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
