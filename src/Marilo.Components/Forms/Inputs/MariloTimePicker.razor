@inherits MariloComponentBase

<div class="@CombineClasses(CssProvider.TimePickerClass())"
     style="@CombineStyles()"
     @attributes="AdditionalAttributes">
    <span class="mar-time-picker__icon">
        @IconProvider.GetIcon("clock", IconSize.Small)
    </span>
    @* Native time input as fallback; custom tumbler/wheel interop replaces this *@
    <input type="time"
           class="@CssProvider.TextFieldClass(false, !Enabled)"
           value="@FormatValue()"
           min="@FormatTime(Min)"
           max="@FormatTime(Max)"
           step="@GranularitySeconds"
           placeholder="@(Placeholder ?? "Select time")"
           disabled="@(!Enabled)"
           readonly="@ReadOnly"
           @onchange="OnTimeChanged" />
    @if (ShowClearButton && Enabled && !ReadOnly && Value.HasValue)
    {
        <button type="button" class="mar-timepicker__clear" aria-label="Clear" @onclick="ClearValue">&times;</button>
    }
</div>

@code {
    [Parameter] public TimeOnly? Value { get; set; }
    [Parameter] public EventCallback<TimeOnly?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public TimeOnly? Min { get; set; }
    [Parameter] public TimeOnly? Max { get; set; }
    [Parameter] public string? Format { get; set; }
    [Parameter] public bool ShowClearButton { get; set; }

    /// <summary>Time granularity in minutes (e.g. 15 for quarter-hour intervals). Default 1.</summary>
    [Parameter] public int GranularityMinutes { get; set; } = 1;

    private int GranularitySeconds => GranularityMinutes * 60;

    private string? FormatValue() => Value?.ToString("HH:mm");
    private string? FormatTime(TimeOnly? t) => t?.ToString("HH:mm");

    private async Task OnTimeChanged(ChangeEventArgs e)
    {
        Value = TimeOnly.TryParse(e.Value?.ToString(), out var time) ? time : null;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task ClearValue()
    {
        Value = null;
        await ValueChanged.InvokeAsync(null);
    }
}
