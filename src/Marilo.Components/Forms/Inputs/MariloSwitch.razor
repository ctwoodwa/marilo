@inherits MariloComponentBase

<label class="@CombineClasses(SwitchClass)" style="@CombineStyles()" @attributes="AdditionalAttributes">
    <input type="checkbox"
           role="switch"
           checked="@Value"
           disabled="@(!Enabled)"
           @onchange="OnToggled" />
    @if (Value && !string.IsNullOrEmpty(OnLabel))
    {
        <span>@OnLabel</span>
    }
    else if (!Value && !string.IsNullOrEmpty(OffLabel))
    {
        <span>@OffLabel</span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</label>

@code {
    /// <summary>Whether the switch is on. Supports two-way binding.</summary>
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? OnLabel { get; set; }
    [Parameter] public string? OffLabel { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;

    private string SwitchClass
    {
        get
        {
            var cls = CssProvider.SwitchClass(Value);
            if (!Enabled) cls += " mar-switch--disabled";
            return cls;
        }
    }

    private async Task OnToggled(ChangeEventArgs e)
    {
        if (!Enabled) return;
        Value = (bool)(e.Value ?? false);
        await ValueChanged.InvokeAsync(Value);
    }
}
