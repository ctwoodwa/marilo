@inherits MariloComponentBase

<div class="@CombineClasses(CssProvider.DatePickerClass())"
     style="@CombineStyles()"
     @attributes="AdditionalAttributes">
    <span class="mar-date-picker__icon">
        @IconProvider.GetIcon("calendar", IconSize.Small)
    </span>
    <input type="date"
           class="@CssProvider.TextFieldClass(false, Disabled)"
           value="@FormatValue()"
           min="@FormatDate(Min)"
           max="@FormatDate(Max)"
           placeholder="@(Placeholder ?? "Select date")"
           disabled="@Disabled"
           @onchange="OnDateChanged" />
</div>

@code {
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public DateOnly? Min { get; set; }
    [Parameter] public DateOnly? Max { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? FormatValue() => Value?.ToString("yyyy-MM-dd");

    private string? FormatDate(DateOnly? date) => date?.ToString("yyyy-MM-dd");

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        var str = e.Value?.ToString();
        if (DateOnly.TryParse(str, out var date))
        {
            Value = date;
        }
        else
        {
            Value = null;
        }
        await ValueChanged.InvokeAsync(Value);
    }
}
