@inherits MariloComponentBase

<MariloTextField Value="@Value"
                ValueChanged="OnInputChanged"
                Placeholder="@(Placeholder ?? "Search…")"
                Disabled="@Disabled"
                class="@CombineClasses(CssProvider.SearchBoxClass())"
                style="@CombineStyles()"
                @attributes="AdditionalAttributes"
                @onkeydown="OnKeyDown">
    <Prefix>
        <MariloIcon Name="search" Size="IconSize.Small" />
    </Prefix>
    <Suffix>
        @if (!string.IsNullOrEmpty(Value))
        {
            <button class="mar-search-box__clear"
                    type="button"
                    aria-label="Clear search"
                    disabled="@Disabled"
                    @onclick="ClearValue">
                <MariloIcon Name="x-close" Size="IconSize.Small" />
            </button>
        }
        else if (!string.IsNullOrEmpty(KbdHint))
        {
            <kbd class="mar-search-box__kbd">@KbdHint</kbd>
        }
    </Suffix>
</MariloTextField>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public EventCallback<string> OnSearch { get; set; }
    [Parameter] public EventCallback OnEscape { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? KbdHint { get; set; }

    private async Task OnInputChanged(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await OnSearch.InvokeAsync(Value);
        else if (e.Key == "Escape")
            await OnEscape.InvokeAsync();
    }

    private async Task ClearValue()
    {
        Value = string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
