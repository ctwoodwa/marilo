@inherits MariloComponentBase

<div class="@CombineClasses(CssProvider.DatePickerClass())"
     style="@CombineStyles()"
     @attributes="AdditionalAttributes">
    <span class="mar-datetime-picker__icon">
        @IconProvider.GetIcon("calendar", IconSize.Small)
    </span>
    <input type="datetime-local"
           class="@CssProvider.TextFieldClass(false, Disabled)"
           value="@FormatValue()"
           placeholder="@Placeholder"
           disabled="@Disabled"
           @onchange="OnDateTimeChanged" />
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string? FormatValue() => Value?.ToString("yyyy-MM-ddTHH:mm");

    private async Task OnDateTimeChanged(ChangeEventArgs e)
    {
        var str = e.Value?.ToString();
        if (DateTime.TryParse(str, out var dateTime))
        {
            Value = dateTime;
        }
        else
        {
            Value = null;
        }
        await ValueChanged.InvokeAsync(Value);
    }
}
