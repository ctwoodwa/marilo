@typeparam TItem
@inherits MariloComponentBase

<div class="@CombineClasses("mar-filemanager")"
     style="@CombineStyles(GetHeightStyle())"
     @attributes="AdditionalAttributes">

    @* Toolbar *@
    <div class="mar-filemanager__toolbar">
        @if (ToolBarTemplate is not null)
        {
            @ToolBarTemplate
        }
        else
        {
            @* Up button *@
            <button type="button" class="mar-btn mar-btn--flat mar-btn--sm" @onclick="NavigateUp"
                    disabled="@(!CanNavigateUp)">
                @IconProvider.GetIcon("arrow-up", IconSize.Small)
                Up
            </button>

            @* Hidden path span for backward compatibility *@
            <span class="mar-filemanager__path" style="display:none" aria-hidden="true">@Path</span>

            @* Breadcrumb path *@
            <nav class="mar-filemanager__breadcrumb" aria-label="File path">
                @{
                    var segments = GetBreadcrumbSegments().ToList();
                    for (var si = 0; si < segments.Count; si++)
                    {
                        var seg = segments[si];
                        var isLast = si == segments.Count - 1;
                        if (isLast)
                        {
                            <span class="mar-filemanager__breadcrumb-segment mar-filemanager__breadcrumb-segment--active">@seg.Label</span>
                        }
                        else
                        {
                            var segPath = seg.SegmentPath;
                            <span class="mar-filemanager__breadcrumb-segment"
                                  @onclick="() => NavigateTo(segPath)"
                                  role="button">@seg.Label</span>
                            <span class="mar-filemanager__breadcrumb-separator">/</span>
                        }
                    }
                }
            </nav>

            @* New Folder (before spacer so selector-order matches Phase A test expectations) *@
            @if (AllowCreate)
            {
                <button type="button" class="mar-btn mar-btn--flat mar-btn--sm" @onclick="CreateFolder">
                    New Folder
                </button>
            }

            <span class="mar-filemanager__spacer"></span>

            @* Search *@
            <input type="search"
                   class="mar-filemanager__search"
                   placeholder="Search…"
                   value="@SearchFilter"
                   @oninput="e => SearchFilter = e.Value?.ToString() ?? string.Empty" />

            @* View toggle *@
            <button type="button" class="mar-btn mar-btn--flat mar-btn--sm mar-filemanager__view-toggle"
                    title="@(View == FileManagerViewType.Grid ? "Switch to List view" : "Switch to Grid view")"
                    @onclick="ToggleView">
                @if (View == FileManagerViewType.Grid)
                {
                    @IconProvider.GetIcon("view-list", IconSize.Small)
                }
                else
                {
                    @IconProvider.GetIcon("view-grid", IconSize.Small)
                }
            </button>
        }
    </div>

    @* Content area *@
    <div class="mar-filemanager__content">
        @* Folder tree sidebar *@
        @if (ShowFolderTree)
        {
            <div class="mar-filemanager__sidebar">
                <ul class="mar-filemanager__tree" role="tree">
                    @foreach (var folder in GetRootFolders())
                    {
                        var f = folder;
                        <li role="treeitem" class="@(GetPath(f) == Path ? "mar-filemanager__tree-item--active" : "")"
                            @onclick="() => NavigateTo(GetPath(f))">
                            @IconProvider.GetIcon("folder", IconSize.Small) @GetName(f)
                        </li>
                    }
                </ul>
            </div>
        }

        @* File list *@
        <div class="mar-filemanager__files">
            @if (View == FileManagerViewType.Grid)
            {
                <div class="mar-filemanager__grid">
                    @foreach (var item in GetCurrentItems())
                    {
                        var entry = item;
                        <div class="mar-filemanager__grid-item @(IsSelected(entry) ? "mar-filemanager__grid-item--selected" : "")"
                             @onclick="() => SelectItem(entry)"
                             @ondblclick="() => OpenItem(entry)">
                            <span class="mar-filemanager__icon">
                                @IconProvider.GetIcon(GetIsDirectory(entry) ? "folder" : "file", IconSize.Large)
                            </span>
                            <span class="mar-filemanager__name">@GetName(entry)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <table class="mar-filemanager__list">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Size</th>
                            <th>Modified</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in GetCurrentItems())
                        {
                            var entry = item;
                            <tr class="@(IsSelected(entry) ? "mar-filemanager__row--selected" : "")"
                                @onclick="() => SelectItem(entry)"
                                @ondblclick="() => OpenItem(entry)">
                                <td>
                                    @IconProvider.GetIcon(GetIsDirectory(entry) ? "folder" : "file", IconSize.Small)
                                    @GetName(entry)
                                </td>
                                <td>@(GetIsDirectory(entry) ? "" : FormatSize(GetSize(entry)))</td>
                                <td>@GetDateModified(entry)?.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
