@namespace Marilo.Components
@inject IConfiguration Configuration

<FluentBadge Appearance="@BadgeAppearance"
             class="mar-env-badge"
             Title="@($"Environment: {EnvironmentName}")">
    @EnvironmentName.ToUpper()
</FluentBadge>

@code {
    private string EnvironmentName { get; set; } = "DEV";

    private Appearance BadgeAppearance => EnvironmentName.ToLower() switch
    {
        "production" or "prod" => Appearance.Accent,
        "staging" or "stage" => Appearance.Neutral,
        _ => Appearance.Lightweight
    };

    protected override void OnInitialized()
    {
        EnvironmentName = Configuration["CommandCenter:Environment"]
            ?? Configuration["ASPNETCORE_ENVIRONMENT"]
            ?? "DEV";
    }
}
