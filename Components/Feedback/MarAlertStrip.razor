@namespace Marilo.Components

@if (Alerts.Any())
{
    <div class="mar-alert-strip">
        @foreach (var alert in Alerts)
        {
            <div class="mar-alert-strip-item mar-alert-@alert.Severity.ToLower()">
                <div class="mar-alert-icon">
                    @switch (alert.Severity.ToLower())
                    {
                        case "critical":
                            <FluentIcon Value="@(new Icons.Regular.Size16.ErrorCircle())" Color="Color.Error" />
                            break;
                        case "warning":
                            <FluentIcon Value="@(new Icons.Regular.Size16.Warning())" Color="Color.Warning" />
                            break;
                        default:
                            <FluentIcon Value="@(new Icons.Regular.Size16.Info())" Color="Color.Accent" />
                            break;
                    }
                </div>
                <div class="mar-alert-text">
                    <strong>@alert.Title</strong>
                    <span class="mar-alert-detail">@alert.Detail</span>
                </div>
                <FluentBadge Appearance="Appearance.Neutral">@alert.Module</FluentBadge>
            </div>
        }
    </div>
}

@code {
    /// <summary>List of system alerts to display.</summary>
    [Parameter] public List<SystemAlertModel> Alerts { get; set; } = new();
}
