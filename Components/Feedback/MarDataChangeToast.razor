@namespace Marilo.Components
@inject DataChangeService ChangeService
@implements IDisposable

@if (activeAlerts.Any())
{
    <div class="mar-toast-container">
        @foreach (var alert in activeAlerts.Take(5))
        {
            <div class="mar-toast @GetChangeTypeClass(alert.ChangeType)" @key="alert.EventId">
                <div class="mar-toast-icon">
                    @switch (alert.ChangeType)
                    {
                        case "Created":
                            <FluentIcon Value="@(new Icons.Regular.Size16.AddCircle())" Color="Color.Success" />
                            break;
                        case "Updated":
                            <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Neutral" />
                            break;
                        case "Deleted":
                            <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" />
                            break;
                        case "Toggled":
                            <FluentIcon Value="@(new Icons.Regular.Size16.ToggleRight())" Color="Color.Neutral" />
                            break;
                        default:
                            <FluentIcon Value="@(new Icons.Regular.Size16.Info())" Color="Color.Neutral" />
                            break;
                    }
                </div>
                <div class="mar-toast-content">
                    <div class="mar-toast-summary">@alert.Summary</div>
                    <div class="mar-toast-meta">
                        <span class="mar-toast-user">by @alert.ChangedByName</span>
                        <span class="mar-toast-time">@FormatTime(alert.OccurredAt)</span>
                    </div>
                </div>
                <div class="mar-toast-actions">
                    @if (OnRefreshRequested.HasDelegate)
                    {
                        <FluentButton Appearance="Appearance.Accent"
                                      Size="ButtonSize.Small"
                                      Title="Refresh to see changes"
                                      OnClick="@(() => HandleRefresh(alert))">
                            <FluentIcon Value="@(new Icons.Regular.Size16.ArrowSync())" />
                            Refresh
                        </FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Stealth"
                                  Size="ButtonSize.Small"
                                  Title="Dismiss"
                                  OnClick="@(() => DismissAlert(alert))">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
                    </FluentButton>
                </div>
            </div>
        }

        @if (activeAlerts.Count > 5)
        {
            <div class="mar-toast mar-toast-overflow">
                <FluentIcon Value="@(new Icons.Regular.Size16.MoreHorizontal())" />
                <span>@(activeAlerts.Count - 5) more changes</span>
                <FluentButton Appearance="Appearance.Stealth"
                              Size="ButtonSize.Small"
                              OnClick="@DismissAll">
                    Dismiss All
                </FluentButton>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public EventCallback OnRefreshRequested { get; set; }

    private List<DataChangeAlert> activeAlerts = new();

    protected override void OnInitialized()
    {
        ChangeService.OnChange += HandleChange;
    }

    private void HandleChange(DataChangeAlert alert)
    {
        activeAlerts.Insert(0, alert);
        InvokeAsync(StateHasChanged);

        _ = Task.Run(async () =>
        {
            await Task.Delay(30_000);
            if (!alert.IsDismissed)
            {
                alert.IsDismissed = true;
                activeAlerts.Remove(alert);
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void DismissAlert(DataChangeAlert alert)
    {
        alert.IsDismissed = true;
        activeAlerts.Remove(alert);
        ChangeService.Dismiss(alert.EventId);
        StateHasChanged();
    }

    private void DismissAll()
    {
        ChangeService.DismissAll();
        activeAlerts.Clear();
        StateHasChanged();
    }

    private async Task HandleRefresh(DataChangeAlert alert)
    {
        DismissAll();
        await OnRefreshRequested.InvokeAsync();
    }

    private static string GetChangeTypeClass(string changeType) => changeType.ToLower();

    private static string FormatTime(DateTime occurredAt)
    {
        var elapsed = DateTime.UtcNow - occurredAt;
        if (elapsed.TotalSeconds < 10) return "just now";
        if (elapsed.TotalSeconds < 60) return $"{(int)elapsed.TotalSeconds}s ago";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes}m ago";
        return occurredAt.ToString("HH:mm");
    }

    public void Dispose()
    {
        ChangeService.OnChange -= HandleChange;
    }
}
