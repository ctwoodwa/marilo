@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IUserNotificationService UserNotifications
@inject Marilo.Core.Services.IMariloThemeService ThemeService
@using Marilo.PmDemo.Client.Notifications
@using Marilo.PmDemo.Client.Data
@using Marilo.Components.Feedback

<MariloThemeProvider Theme="@_selectedPreset.Theme">
<MariloAppShell @bind-SidebarCollapsed="_collapsed"
                BrandText="Marilo PM"
                UserName="Avery Chen"
                NotificationCount="@UserNotifications.UnreadCount">
    <SidebarBrand>
        <span style="display:inline-flex;align-items:center;gap:10px;">
            <span style="width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#5b6cff,#9b6bff);display:inline-block;"></span>
            <span>Marilo PM</span>
        </span>
    </SidebarBrand>

    <SidebarContent>
        <MariloAppShellNavGroup Title="Overview">
            <MariloAppShellNavLink Href="/" Match="NavLinkMatch.All" Label="Dashboard">
                <Icon>@Svg("M3 12l9-9 9 9M5 10v10h14V10")</Icon>
            </MariloAppShellNavLink>
        </MariloAppShellNavGroup>

        <MariloAppShellNavGroup Title="Planning">
            <MariloAppShellNavLink Href="/board" Label="Task Board" Badge="12">
                <Icon>@Svg("M4 4h6v16H4zM14 4h6v9h-6z")</Icon>
            </MariloAppShellNavLink>
            <MariloAppShellNavLink Href="/tasks" Label="Task List">
                <Icon>@Svg("M4 6h16M4 12h16M4 18h16")</Icon>
            </MariloAppShellNavLink>
            <MariloAppShellNavLink Href="/timeline" Label="Timeline">
                <Icon>@Svg("M3 6h12M3 12h18M3 18h9")</Icon>
            </MariloAppShellNavLink>
        </MariloAppShellNavGroup>

        <MariloAppShellNavGroup Title="Governance">
            <MariloAppShellNavLink Href="/budget" Label="Budget">
                <Icon>@Svg("M3 20V10M9 20V4M15 20v-8M21 20V8")</Icon>
            </MariloAppShellNavLink>
            <MariloAppShellNavLink Href="/team" Label="Team Resource">
                <Icon>@Svg("M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zM2 20c0-3 3-5 6-5s6 2 6 5M14 20c0-2 2-4 5-4s5 2 5 4")</Icon>
            </MariloAppShellNavLink>
            <MariloAppShellNavLink Href="/risk" Label="Risk Register" Badge="!">
                <Icon>@Svg("M12 3l10 18H2zM12 10v5M12 18v.01")</Icon>
            </MariloAppShellNavLink>
        </MariloAppShellNavGroup>
    </SidebarContent>

    <ChildContent>
        @Body
        <MariloSnackbarHost />
    </ChildContent>

    <SidebarFooter>
        @if (_collapsed)
        {
            <div class="sidebar-footer sidebar-footer--collapsed" style="position:relative;">
                <button type="button"
                        class="footer-icon-button footer-bell-button"
                        title="Notifications"
                        aria-label="Notifications"
                        aria-haspopup="dialog"
                        aria-expanded="@_bellOpen.ToString().ToLowerInvariant()"
                        @onclick="() => _bellOpen = !_bellOpen">
                    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                        <path d="M10 2a5 5 0 0 0-5 5v3l-1.5 2.5h13L15 10V7a5 5 0 0 0-5-5zm-2 13a2 2 0 0 0 4 0"
                              fill="none" stroke="currentColor" stroke-width="1.5"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    @if (UserNotifications.UnreadCount > 0)
                    {
                        <span class="mar-appshell__badge">@UserNotifications.UnreadCount</span>
                    }
                </button>

                <button type="button"
                        class="footer-avatar-button"
                        title="Avery Chen"
                        aria-label="Account"
                        aria-haspopup="menu"
                        aria-expanded="@_menuOpen.ToString().ToLowerInvariant()"
                        @onclick="() => _menuOpen = !_menuOpen">
                    <span class="mar-appshell__avatar">AC</span>
                </button>

                <MariloUserMenu @bind-Open="_menuOpen"
                                UserName="Avery Chen"
                                UserEmail="avery.chen@example.com"
                                Items="_menuItems">
                    <Footer>
                        @RenderThemePicker
                    </Footer>
                </MariloUserMenu>

                <MariloNotificationBell @bind-Open="_bellOpen"
                                        Items="_feedItems"
                                        OnItemClick="HandleItemClick"
                                        OnMarkAllRead="HandleMarkAllRead"
                                        OnDeleteAllRead="HandleDeleteAllRead"
                                        OnSettingsClick="GoToNotificationSettings" />
            </div>
        }
        else
        {
            <div class="mar-appshell__user-group" style="position:relative;">
                <button type="button"
                        class="mar-appshell__avatar-btn"
                        title="Avery Chen"
                        aria-label="Account"
                        aria-haspopup="menu"
                        aria-expanded="@_menuOpen.ToString().ToLowerInvariant()"
                        @onclick="() => _menuOpen = !_menuOpen">
                    <span class="mar-appshell__avatar">AC</span>
                    <span class="mar-appshell__avatar-name">Avery Chen</span>
                </button>
                <button type="button"
                        class="mar-appshell__notif-btn"
                        title="Notifications"
                        aria-label="Notifications"
                        aria-haspopup="dialog"
                        aria-expanded="@_bellOpen.ToString().ToLowerInvariant()"
                        @onclick="() => _bellOpen = !_bellOpen">
                    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                        <path d="M10 2a5 5 0 0 0-5 5v3l-1.5 2.5h13L15 10V7a5 5 0 0 0-5-5zm-2 13a2 2 0 0 0 4 0"
                              fill="none" stroke="currentColor" stroke-width="1.5"
                              stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    @if (UserNotifications.UnreadCount > 0)
                    {
                        <span class="mar-appshell__badge">@UserNotifications.UnreadCount</span>
                    }
                </button>

                <MariloUserMenu @bind-Open="_menuOpen"
                                UserName="Avery Chen"
                                UserEmail="avery.chen@example.com"
                                Items="_menuItems">
                    <Footer>
                        @RenderThemePicker
                    </Footer>
                </MariloUserMenu>

                <MariloNotificationBell @bind-Open="_bellOpen"
                                        Items="_feedItems"
                                        OnItemClick="HandleItemClick"
                                        OnMarkAllRead="HandleMarkAllRead"
                                        OnDeleteAllRead="HandleDeleteAllRead"
                                        OnSettingsClick="GoToNotificationSettings" />
            </div>
        }
    </SidebarFooter>
</MariloAppShell>
</MariloThemeProvider>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _collapsed;
    private bool _menuOpen;
    private bool _bellOpen;
    private bool _isDark;
    private ThemePresets.ThemePreset _selectedPreset = ThemePresets.All[0];

    private List<PopupMenuItem> _menuItems = new();

    // Bell view shape — projected from the canonical store on every change. The bell
    // never owns notification state; this list is rebuilt from UserNotifications.All.
    private List<NotificationItem> _feedItems = new();

    protected override void OnInitialized()
    {
        _isDark = ThemeService.IsDarkMode;

        _menuItems = new()
        {
            new() { Label = "Profile",   Shortcut = "⇧P", OnClick = () => Nav.NavigateTo("/account/details") },
            new() { Label = "Settings",  Shortcut = "⌘,", OnClick = () => Nav.NavigateTo("/account/preferences"), IsDividerAfter = true },
            new() { Label = "Help & docs", OnClick = () => Nav.NavigateTo("/docs") },
            new() { Label = "Keyboard shortcuts", Shortcut = "?", IsDividerAfter = true, OnClick = () => Nav.NavigateTo("/account/shortcuts") },
            new() { Label = "Sign out", OnClick = () => Nav.NavigateTo("/") },
        };

        UserNotifications.Changed += OnNotificationsChanged;
        RefreshFeed();
    }

    private async Task SelectTheme(ThemePresets.ThemePreset preset)
    {
        _selectedPreset = preset;
        await ThemeService.SetThemeAsync(preset.Theme);
    }

    private async Task SetDarkMode(bool dark)
    {
        if (_isDark == dark) return;
        _isDark = dark;
        await ThemeService.SetDarkModeAsync(dark);
    }

    private void OnNotificationsChanged()
    {
        RefreshFeed();
        InvokeAsync(StateHasChanged);
    }

    private void RefreshFeed()
    {
        _feedItems = UserNotifications.All
            .Select(NotificationFeedProjection.ToFeedItem)
            .ToList();
    }

    private async Task HandleItemClick(NotificationItem item)
    {
        await UserNotifications.MarkReadAsync(item.Id);
    }

    private async Task HandleMarkAllRead()
    {
        await UserNotifications.MarkAllReadAsync();
    }

    private async Task HandleDeleteAllRead()
    {
        await UserNotifications.DeleteAllReadAsync();
    }

    private void GoToNotificationSettings() => Nav.NavigateTo("/account/notifications");

    public void Dispose()
    {
        UserNotifications.Changed -= OnNotificationsChanged;
    }

    private RenderFragment Svg(string path) => __builder =>
    {
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="@path"/>
        </svg>
    };

    private RenderFragment RenderThemePicker => __builder =>
    {
        <div class="theme-picker">
            <div class="theme-picker__section-title">Theme</div>
            @foreach (var preset in ThemePresets.All)
            {
                var p = preset;
                var isActive = p.Name == _selectedPreset.Name;
                <button type="button"
                        class="theme-picker__option @(isActive ? "theme-picker__option--active" : "")"
                        @onclick="() => SelectTheme(p)"
                        @onclick:stopPropagation="true">
                    <span class="theme-picker__swatch" style="background: @p.Theme.Colors.Primary;"></span>
                    <span class="theme-picker__label">@p.Name</span>
                    @if (isActive)
                    {
                        <svg class="theme-picker__check" width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    }
                </button>
            }
            <div class="theme-picker__divider"></div>
            <div class="theme-picker__section-title">Mode</div>
            <button type="button"
                    class="theme-picker__option @(!_isDark ? "theme-picker__option--active" : "")"
                    @onclick="() => SetDarkMode(false)"
                    @onclick:stopPropagation="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                </svg>
                <span class="theme-picker__label">Light</span>
                @if (!_isDark)
                {
                    <svg class="theme-picker__check" width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                }
            </button>
            <button type="button"
                    class="theme-picker__option @(_isDark ? "theme-picker__option--active" : "")"
                    @onclick="() => SetDarkMode(true)"
                    @onclick:stopPropagation="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <span class="theme-picker__label">Dark</span>
                @if (_isDark)
                {
                    <svg class="theme-picker__check" width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                }
            </button>
        </div>
    };
}
