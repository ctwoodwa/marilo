@inject NavigationManager Nav

<a class="settings-home-link" href="@Href" @onclick="Navigate" @onclick:preventDefault>
    <svg class="settings-home-link__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
    </svg>
    <span class="settings-home-link__label">@Label</span>
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public string Label { get; set; } = "Home";

    private void Navigate()
    {
        Nav.NavigateTo(Href);
    }
}
