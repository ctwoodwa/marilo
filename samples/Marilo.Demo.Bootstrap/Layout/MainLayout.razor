@inherits LayoutComponentBase
@inject NavigationManager Nav
@using Marilo.Components
<div class="d-flex min-vh-100" data-bs-theme="@(_isDark ? "dark" : "light")">
    <aside class="sidebar border-end bg-body-tertiary">
        <div class="sidebar-brand d-flex align-items-center gap-2 px-3 py-3 border-bottom fw-bold">
            <svg width="20" height="20" viewBox="0 0 28 28" fill="none" class="text-primary">
                <rect x="2" y="2" width="24" height="24" rx="6" stroke="currentColor" stroke-width="2" />
                <path d="M9 9l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M15 14h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span>Marilo <MariloBadge Variant="BadgeVariant.Primary">Bootstrap</MariloBadge></span>
        </div>

        <div class="sidebar-search-wrap px-2 pt-2">
            <MariloSearchBox Value="@_search"
                             ValueChanged="OnSearchChanged"
                             Placeholder="Find components..."
                             OnEscape="ClearSearch"
                             OnSearch="@(_ => NavigateFirstResult())" />
        </div>

        @if (_filteredItems.Count > 0 && !string.IsNullOrWhiteSpace(_search))
        {
            <div class="sidebar-results px-2 py-1">
                @foreach (var item in _filteredItems)
                {
                    <button class="sidebar-result list-group-item list-group-item-action py-2 d-flex justify-content-between align-items-center @(IsActive(item.Href) ? "active" : "")"
                            @onclick="() => NavigateFromSearch(item.Href)">
                        <span>@item.Label</span>
                        <MariloBadge Variant="BadgeVariant.Secondary">@item.Group</MariloBadge>
                    </button>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_search) && _filteredItems.Count == 0)
        {
            <div class="text-center text-body-tertiary small py-4">No results for "@_search"</div>
        }

        <nav class="sidebar-tree px-2 py-2 @(!string.IsNullOrWhiteSpace(_search) ? "d-none" : "")">
            <MariloTreeView>
                <MariloTreeItem Title="Home" IsSelected="@IsActive("")" OnClick="@(() => Navigate(""))" />

                <MariloTreeItem Title="Components" IsExpanded="true">
                    <MariloTreeItem Title="Buttons" IsSelected="@IsActive("buttons")" OnClick="@(() => Navigate("buttons"))" />
                    <MariloTreeItem Title="Forms" IsSelected="@IsActive("forms")" OnClick="@(() => Navigate("forms"))" />
                    <MariloTreeItem Title="Data Display" IsSelected="@IsActive("data-display")" OnClick="@(() => Navigate("data-display"))" />
                    <MariloTreeItem Title="Feedback" IsSelected="@IsActive("feedback")" OnClick="@(() => Navigate("feedback"))" />
                    <MariloTreeItem Title="Layout" IsSelected="@IsActive("layout")" OnClick="@(() => Navigate("layout"))" />
                    <MariloTreeItem Title="Navigation" IsSelected="@IsActive("navigation")" OnClick="@(() => Navigate("navigation"))" />
                </MariloTreeItem>

                <MariloTreeItem Title="Extended" IsExpanded="true">
                    <MariloTreeItem Title="Extended" IsSelected="@IsActive("extended")" OnClick="@(() => Navigate("extended"))" />
                    <MariloTreeItem Title="Icons" IsSelected="@IsActive("icons")" OnClick="@(() => Navigate("icons"))" />
                </MariloTreeItem>
            </MariloTreeView>
        </nav>

        <div class="mt-auto border-top p-2">
            <MariloButton Variant="@(_isDark ? ButtonVariant.Secondary : ButtonVariant.Secondary)"
                          IsOutline="true"
                          Size="ButtonSize.Small"
                          Class="w-100 d-flex align-items-center justify-content-center gap-2"
                          OnClick="ToggleTheme">
                @if (_isDark)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" /></svg>
                    <span>Light mode</span>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                    <span>Dark mode</span>
                }
            </MariloButton>
        </div>
    </aside>

    <main class="main-content flex-grow-1 p-4">
        <CascadingValue Value="_isDark" Name="IsDarkMode">
            @Body
        </CascadingValue>
    </main>
</div>

@code {
    private bool _isDark;
    private string _search = "";

    private record NavEntry(string Label, string Href, string Group);

    private static readonly NavEntry[] _allItems =
    [
        new("Home", "", "Pages"),
        new("Buttons", "buttons", "Components"),
        new("Forms", "forms", "Components"),
        new("Data Display", "data-display", "Components"),
        new("Feedback", "feedback", "Components"),
        new("Layout", "layout", "Components"),
        new("Navigation", "navigation", "Components"),
        new("Extended", "extended", "Extended"),
        new("Icons", "icons", "Icons"),
    ];

    private List<NavEntry> _filteredItems = new();

    private void OnSearchChanged(string value)
    {
        _search = value;
        ApplyFilter();
    }

    private void NavigateFirstResult()
    {
        if (_filteredItems.Count == 1)
            NavigateFromSearch(_filteredItems[0].Href);
    }

    private void ClearSearch()
    {
        _search = "";
        _filteredItems.Clear();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            _filteredItems.Clear();
            return;
        }
        var q = _search.Trim().ToLower();
        _filteredItems = _allItems
            .Where(i => i.Label.ToLower().Contains(q) || i.Group.ToLower().Contains(q))
            .ToList();
    }

    private void NavigateFromSearch(string path)
    {
        ClearSearch();
        Nav.NavigateTo($"/{path}");
    }

    private void ToggleTheme() => _isDark = !_isDark;

    private void Navigate(string path) => Nav.NavigateTo($"/{path}");

    private bool IsActive(string path)
    {
        var uri = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        return uri.Equals(path, StringComparison.OrdinalIgnoreCase);
    }
}
