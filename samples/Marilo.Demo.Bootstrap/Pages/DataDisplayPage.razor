@page "/data-display"

<div class="demo-page">
    <h1>Data Display</h1>
    <p class="text-body-secondary mb-4">Components for presenting data and content.</p>

    <DemoSection Title="Cards" Description="Container for related content.">
        <div class="demo-card-grid">
            <MariloCard>
                <MariloCardHeader>Card Title</MariloCardHeader>
                <MariloCardBody>This is card body content with some descriptive text.</MariloCardBody>
                <MariloCardActions>
                    <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Action</MariloButton>
                </MariloCardActions>
            </MariloCard>
            <MariloCard>
                <MariloCardHeader>Another Card</MariloCardHeader>
                <MariloCardBody>Cards can contain any content including forms, images, and lists.</MariloCardBody>
            </MariloCard>
        </div>
    </DemoSection>

    <DemoSection Title="Badges" Description="Small status indicators.">
        <div class="demo-row">
            <MariloBadge Variant="BadgeVariant.Primary">Primary</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Secondary">Secondary</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Success">Success</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Danger">Danger</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Warning">Warning</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Info">Info</MariloBadge>
        </div>
    </DemoSection>

    <DemoSection Title="List" Description="Grouped items in a vertical list.">
        <div style="max-width:400px;">
            <MariloList>
                <MariloListItem>First item</MariloListItem>
                <MariloListItem>Second item</MariloListItem>
                <MariloListItem>Third item</MariloListItem>
            </MariloList>
        </div>
    </DemoSection>

    <DemoSection Title="Table" Description="Tabular data display.">
        <table class="mar-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Alice</td>
                    <td>Developer</td>
                    <td><MariloBadge Variant="BadgeVariant.Success">Active</MariloBadge></td>
                </tr>
                <tr>
                    <td>Bob</td>
                    <td>Designer</td>
                    <td><MariloBadge Variant="BadgeVariant.Warning">Away</MariloBadge></td>
                </tr>
                <tr>
                    <td>Carol</td>
                    <td>Manager</td>
                    <td><MariloBadge Variant="BadgeVariant.Danger">Offline</MariloBadge></td>
                </tr>
            </tbody>
        </table>
    </DemoSection>
</div>
