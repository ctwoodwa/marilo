@page "/icons"
@inject IMariloIconProvider IconProvider

<div class="demo-page">
    <h1>Icons</h1>
    <p class="text-body-secondary mb-4">Icon rendering through the Bootstrap Icons provider.</p>

    <DemoSection Title="Sizes" Description="Icons are available in four sizes.">
        <div class="demo-row">
            <span>@IconProvider.GetIcon("house", IconSize.Small)</span>
            <span>@IconProvider.GetIcon("house", IconSize.Medium)</span>
            <span>@IconProvider.GetIcon("house", IconSize.Large)</span>
            <span>@IconProvider.GetIcon("house", IconSize.ExtraLarge)</span>
        </div>
    </DemoSection>

    <DemoSection Title="Common Icons" Description="A selection of frequently used Bootstrap icons.">
        <div class="demo-row">
            @foreach (var name in _commonIcons)
            {
                <div class="d-flex flex-column align-items-center gap-1" style="width:64px;">
                    <span>@IconProvider.GetIcon(name, IconSize.Large)</span>
                    <small class="text-body-secondary" style="font-size:.65rem;">@name</small>
                </div>
            }
        </div>
    </DemoSection>
</div>

@code {
    private static readonly string[] _commonIcons =
    [
        "house", "gear", "person", "search", "bell",
        "envelope", "heart", "star", "trash", "pencil",
        "plus", "dash", "check", "x", "arrow-right"
    ];
}
