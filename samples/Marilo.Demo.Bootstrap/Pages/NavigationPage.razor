@page "/navigation"

<div class="demo-page">
    <h1>Navigation</h1>
    <p class="text-body-secondary mb-4">Components that help users move through the application.</p>

    <DemoSection Title="Breadcrumb" Description="Shows the current page location within a hierarchy.">
        <MariloBreadcrumb>
            <MariloBreadcrumbItem>Home</MariloBreadcrumbItem>
            <MariloBreadcrumbItem>Components</MariloBreadcrumbItem>
            <MariloBreadcrumbItem>Navigation</MariloBreadcrumbItem>
        </MariloBreadcrumb>
    </DemoSection>

    <DemoSection Title="Pagination" Description="Navigate between pages of content.">
        <MariloPagination Page="@_currentPage" PageChanged="@(p => _currentPage = p)" Total="100" PageSize="10" />
    </DemoSection>

    <DemoSection Title="Tabs" Description="Tabbed content navigation.">
        <MariloTabStrip>
            <TabStripTab Title="Tab One">
                Content for the first tab.
            </TabStripTab>
            <TabStripTab Title="Tab Two">
                Content for the second tab.
            </TabStripTab>
            <TabStripTab Title="Tab Three">
                Content for the third tab.
            </TabStripTab>
        </MariloTabStrip>
    </DemoSection>

    <DemoSection Title="Toolbar" Description="Grouped actions in a horizontal bar.">
        <MariloToolbar>
            <MariloToolbarGroup>
                <MariloToolbarButton>Cut</MariloToolbarButton>
                <MariloToolbarButton>Copy</MariloToolbarButton>
                <MariloToolbarButton>Paste</MariloToolbarButton>
            </MariloToolbarGroup>
            <MariloToolbarSeparator />
            <MariloToolbarGroup>
                <MariloToolbarToggleButton IsActive="_bold" OnClick="() => _bold = !_bold">Bold</MariloToolbarToggleButton>
                <MariloToolbarToggleButton IsActive="_italic" OnClick="() => _italic = !_italic">Italic</MariloToolbarToggleButton>
            </MariloToolbarGroup>
        </MariloToolbar>
    </DemoSection>

    <DemoSection Title="Menu" Description="Dropdown menu with items.">
        <MariloMenu>
            <MariloMenuItem>New File</MariloMenuItem>
            <MariloMenuItem>Open File</MariloMenuItem>
            <MariloMenuDivider />
            <MariloMenuItem>Save</MariloMenuItem>
            <MariloMenuItem IsDisabled="true">Save As...</MariloMenuItem>
        </MariloMenu>
    </DemoSection>
</div>

@code {
    private int _currentPage = 2;
    private bool _bold = false;
    private bool _italic = false;
}
