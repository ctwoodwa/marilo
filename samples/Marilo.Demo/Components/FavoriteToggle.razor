@inject Services.FavoritesService Favorites

<button class="favorite-toggle @(_active ? "active" : "")"
        title="@(_active ? "Remove from favorites" : "Add to favorites")"
        @onclick="Toggle">
    @if (_active)
    {
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
    }
    else
    {
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
    }
</button>

@code {
    [Parameter, EditorRequired] public string PageId { get; set; } = "";
    [Parameter, EditorRequired] public string PageTitle { get; set; } = "";
    [Parameter, EditorRequired] public string PageUrl { get; set; } = "";
    [Parameter] public string? Icon { get; set; }

    private bool _active;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Favorites.EnsureInitializedAsync();
            _active = Favorites.IsFavorite(PageId);
            StateHasChanged();
        }
    }

    private async Task Toggle()
    {
        await Favorites.ToggleAsync(PageId, PageTitle, PageUrl, Icon);
        _active = Favorites.IsFavorite(PageId);
    }
}
