@page "/components/validation"
@page "/components/validation/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Description="Validation components display field-level and summary validation messages." Code="@_basicCode">
        <div class="demo-row">
            <MariloForm>
                <MariloField>
                    <MariloLabel>Required Field</MariloLabel>
                    <MariloTextBox @bind-Value="_value" />
                </MariloField>
                <MariloAlert Severity="@(_value is null or { Length: 0 } ? AlertSeverity.Warning : AlertSeverity.Success)">
                    @(_value is null or { Length: 0 } ? "This field is required." : "Looks good!")
                </MariloAlert>
            </MariloForm>
        </div>
    </DemoSection>
</PageSection>

@code {
    private string? _value;

    private const string _basicCode =
        "<MariloField>\n" +
        "    <MariloLabel>Required Field</MariloLabel>\n" +
        "    <MariloTextBox @bind-Value=\"_value\" />\n" +
        "    <MariloValidationMessage TValue=\"string\" Message=\"This field is required.\" />\n" +
        "</MariloField>";
}
