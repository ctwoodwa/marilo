@page "/components/grid"
@page "/components/grid/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloGrid>
            <MariloRow>
                <MariloColumn Span="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 4</div></MariloColumn>
                <MariloColumn Span="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 4</div></MariloColumn>
                <MariloColumn Span="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 4</div></MariloColumn>
            </MariloRow>
            <MariloRow>
                <MariloColumn Span="6"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 6</div></MariloColumn>
                <MariloColumn Span="6"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 6</div></MariloColumn>
            </MariloRow>
            <MariloRow>
                <MariloColumn Span="3"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 3</div></MariloColumn>
                <MariloColumn Span="6"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 6</div></MariloColumn>
                <MariloColumn Span="3"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 3</div></MariloColumn>
            </MariloRow>
        </MariloGrid>
    </DemoSection>
</PageSection>

<PageSection Title="Appearance">
    <DemoSection Title="Column Offsets" Description="Use Offset to push columns to the right." Code="@_offsetCode">
        <MariloGrid>
            <MariloRow>
                <MariloColumn Span="4" Offset="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Offset 4, Span 4</div></MariloColumn>
            </MariloRow>
            <MariloRow>
                <MariloColumn Span="3" Offset="3"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Offset 3, Span 3</div></MariloColumn>
                <MariloColumn Span="3" Offset="3"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Offset 3, Span 3</div></MariloColumn>
            </MariloRow>
        </MariloGrid>
    </DemoSection>

    <DemoSection Title="Nested Grids" Description="Grids can be nested inside columns for complex layouts." Code="@_nestedCode">
        <MariloGrid>
            <MariloRow>
                <MariloColumn Span="8">
                    <div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">
                        <MariloGrid>
                            <MariloRow>
                                <MariloColumn Span="6"><div style="background:var(--marilo-color-secondary-light);padding:8px;border-radius:4px;">Nested 6</div></MariloColumn>
                                <MariloColumn Span="6"><div style="background:var(--marilo-color-secondary-light);padding:8px;border-radius:4px;">Nested 6</div></MariloColumn>
                            </MariloRow>
                        </MariloGrid>
                    </div>
                </MariloColumn>
                <MariloColumn Span="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">Col 4</div></MariloColumn>
            </MariloRow>
        </MariloGrid>
    </DemoSection>
</PageSection>

<PageSection Title="Accessibility">
    <AccessibilityInfo
        KeyboardInteractions="@_keyboard"
        AriaAttributes="@_aria"
        ScreenReaderNotes="@_screenReader" />
</PageSection>

@code {
    private const string _basicCode =
        "<MariloGrid>\n" +
        "    <MariloRow>\n" +
        "        <MariloColumn Span=\"4\">Col 4</MariloColumn>\n" +
        "        <MariloColumn Span=\"4\">Col 4</MariloColumn>\n" +
        "        <MariloColumn Span=\"4\">Col 4</MariloColumn>\n" +
        "    </MariloRow>\n" +
        "    <MariloRow>\n" +
        "        <MariloColumn Span=\"6\">Col 6</MariloColumn>\n" +
        "        <MariloColumn Span=\"6\">Col 6</MariloColumn>\n" +
        "    </MariloRow>\n" +
        "    <MariloRow>\n" +
        "        <MariloColumn Span=\"3\">Col 3</MariloColumn>\n" +
        "        <MariloColumn Span=\"6\">Col 6</MariloColumn>\n" +
        "        <MariloColumn Span=\"3\">Col 3</MariloColumn>\n" +
        "    </MariloRow>\n" +
        "</MariloGrid>";

    private const string _offsetCode =
        "<MariloGrid>\n" +
        "    <MariloRow>\n" +
        "        <MariloColumn Span=\"4\" Offset=\"4\">Offset 4, Span 4</MariloColumn>\n" +
        "    </MariloRow>\n" +
        "    <MariloRow>\n" +
        "        <MariloColumn Span=\"3\" Offset=\"3\">Offset 3, Span 3</MariloColumn>\n" +
        "        <MariloColumn Span=\"3\" Offset=\"3\">Offset 3, Span 3</MariloColumn>\n" +
        "    </MariloRow>\n" +
        "</MariloGrid>";

    private const string _nestedCode =
        "<MariloGrid>\n" +
        "    <MariloRow>\n" +
        "        <MariloColumn Span=\"8\">\n" +
        "            <MariloGrid>\n" +
        "                <MariloRow>\n" +
        "                    <MariloColumn Span=\"6\">Nested 6</MariloColumn>\n" +
        "                    <MariloColumn Span=\"6\">Nested 6</MariloColumn>\n" +
        "                </MariloRow>\n" +
        "            </MariloGrid>\n" +
        "        </MariloColumn>\n" +
        "        <MariloColumn Span=\"4\">Col 4</MariloColumn>\n" +
        "    </MariloRow>\n" +
        "</MariloGrid>";

    private static readonly (string Key, string Action)[] _keyboard =
    [
        ("Tab", "Moves focus through interactive content within grid cells"),
    ];

    private static readonly (string Attribute, string Description)[] _aria =
    [
        ("role=\"grid\"", "Not required; the semantic grid uses standard HTML elements for layout"),
        ("aria-label", "Can be added to describe the grid's purpose when used for data layout"),
    ];

    private static readonly string[] _screenReader =
    [
        "The grid uses semantic HTML elements, so no special ARIA roles are needed for layout purposes.",
        "Content within grid cells is read in document order.",
        "Ensure grid content has proper heading hierarchy for screen reader navigation.",
    ];
}
