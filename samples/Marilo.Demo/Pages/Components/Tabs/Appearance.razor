@page "/components/tabs/appearance"
@layout ComponentDemoLayout
@using Marilo.Components.Layout

<DemoSection Title="Multiple Tabs" Description="Tabs with different content sections." Code="@_multiCode">
    <MariloTabs ActiveTabIndex="@_multiTabIndex" ActiveTabIndexChanged="@((int v) => _multiTabIndex = v)">
        <MariloTabPanel Title="Active">
            <p>This tab is active.</p>
        </MariloTabPanel>
        <MariloTabPanel Title="Info">
            <p>This tab shows information.</p>
        </MariloTabPanel>
        <MariloTabPanel Title="Another">
            <p>This tab is also available.</p>
        </MariloTabPanel>
    </MariloTabs>
</DemoSection>

<DemoSection Title="Tabs with Rich Content" Description="Tabs can contain forms and other components." Code="@_richCode">
    <MariloTabs ActiveTabIndex="@_richTabIndex" ActiveTabIndexChanged="@((int v) => _richTabIndex = v)">
        <MariloTabPanel Title="Profile">
            <MariloField>
                <MariloLabel>Username</MariloLabel>
                <MariloTextField Placeholder="Enter username" />
            </MariloField>
        </MariloTabPanel>
        <MariloTabPanel Title="Preferences">
            <MariloField>
                <MariloSwitch Label="Dark mode" />
            </MariloField>
        </MariloTabPanel>
    </MariloTabs>
</DemoSection>

@code {
    private int _multiTabIndex;
    private int _richTabIndex;

    private const string _multiCode =
        "<MariloTabs ActiveTabIndex=\"@_tabIndex\" ActiveTabIndexChanged=\"@(v => _tabIndex = v)\">\n" +
        "    <MariloTabPanel Title=\"Active\">\n" +
        "        <p>This tab is active.</p>\n" +
        "    </MariloTabPanel>\n" +
        "    <MariloTabPanel Title=\"Info\">\n" +
        "        <p>This tab shows information.</p>\n" +
        "    </MariloTabPanel>\n" +
        "    <MariloTabPanel Title=\"Another\">\n" +
        "        <p>This tab is also available.</p>\n" +
        "    </MariloTabPanel>\n" +
        "</MariloTabs>";

    private const string _richCode =
        "<MariloTabs ActiveTabIndex=\"@_tabIndex\" ActiveTabIndexChanged=\"@(v => _tabIndex = v)\">\n" +
        "    <MariloTabPanel Title=\"Profile\">\n" +
        "        <MariloField>\n" +
        "            <MariloLabel>Username</MariloLabel>\n" +
        "            <MariloTextField Placeholder=\"Enter username\" />\n" +
        "        </MariloField>\n" +
        "    </MariloTabPanel>\n" +
        "    <MariloTabPanel Title=\"Preferences\">\n" +
        "        <MariloField>\n" +
        "            <MariloSwitch Label=\"Dark mode\" />\n" +
        "        </MariloField>\n" +
        "    </MariloTabPanel>\n" +
        "</MariloTabs>";
}
