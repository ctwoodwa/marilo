@page "/components/tabs/events"
@layout ComponentDemoLayout
@using Marilo.Components.Layout

<DemoSection Title="ActiveTabIndexChanged" Description="Handle tab selection changes with the ActiveTabIndexChanged callback." Code="@_eventCode">
    <MariloTabs ActiveTabIndex="@_tabIndex" ActiveTabIndexChanged="@OnTabChanged">
        <MariloTabPanel Title="First">
            <p>First tab content.</p>
        </MariloTabPanel>
        <MariloTabPanel Title="Second">
            <p>Second tab content.</p>
        </MariloTabPanel>
        <MariloTabPanel Title="Third">
            <p>Third tab content.</p>
        </MariloTabPanel>
    </MariloTabs>
    <p>Selected tab index: @_tabIndex</p>
</DemoSection>

@code {
    private int _tabIndex;

    private void OnTabChanged(int index)
    {
        _tabIndex = index;
    }

    private const string _eventCode =
        "<MariloTabs ActiveTabIndex=\"@_tabIndex\" ActiveTabIndexChanged=\"@OnTabChanged\">\n" +
        "    <MariloTabPanel Title=\"First\">\n" +
        "        <p>First tab content.</p>\n" +
        "    </MariloTabPanel>\n" +
        "    <MariloTabPanel Title=\"Second\">\n" +
        "        <p>Second tab content.</p>\n" +
        "    </MariloTabPanel>\n" +
        "    <MariloTabPanel Title=\"Third\">\n" +
        "        <p>Third tab content.</p>\n" +
        "    </MariloTabPanel>\n" +
        "</MariloTabs>\n" +
        "<p>Selected tab index: @_tabIndex</p>\n\n" +
        "@code {\n" +
        "    private int _tabIndex;\n" +
        "    private void OnTabChanged(int index) => _tabIndex = index;\n" +
        "}";
}
