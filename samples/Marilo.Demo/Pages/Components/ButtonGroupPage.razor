@page "/components/button-group"

<div class="demo-page">
    <h1>Button Group</h1>
    <p class="demo-page-desc">Button groups combine related buttons into a single visual unit, making it clear that the actions are related.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Buttons.MariloButtonGroup.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloButtonGroup>
            <MariloButton Variant="ButtonVariant.Secondary">Left</MariloButton>
            <MariloButton Variant="ButtonVariant.Secondary">Center</MariloButton>
            <MariloButton Variant="ButtonVariant.Secondary">Right</MariloButton>
        </MariloButtonGroup>
    </DemoSection>

    <DemoSection Title="With Primary" Code="@_withPrimaryCode">
        <MariloButtonGroup>
            <MariloButton Variant="ButtonVariant.Primary">Primary</MariloButton>
            <MariloButton Variant="ButtonVariant.Secondary">Secondary</MariloButton>
            <MariloButton Variant="ButtonVariant.Secondary">Secondary</MariloButton>
        </MariloButtonGroup>
    </DemoSection>
</div>

@code {
    private const string _basicCode =
        "<MariloButtonGroup>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\">Left</MariloButton>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\">Center</MariloButton>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\">Right</MariloButton>\n" +
        "</MariloButtonGroup>";

    private const string _withPrimaryCode =
        "<MariloButtonGroup>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Primary\">Primary</MariloButton>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\">Secondary</MariloButton>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\">Secondary</MariloButton>\n" +
        "</MariloButtonGroup>";
}
