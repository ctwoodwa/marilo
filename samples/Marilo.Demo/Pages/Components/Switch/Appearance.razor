@page "/components/switch/appearance"
@layout ComponentDemoLayout

<DemoSection Title="Disabled" Description="A disabled switch prevents user interaction." Code="@_disabledCode">
    <MariloField>
        <MariloSwitch IsOn="true" Disabled="true" Label="On and disabled" />
    </MariloField>
    <MariloField>
        <MariloSwitch IsOn="false" Disabled="true" Label="Off and disabled" />
    </MariloField>
</DemoSection>

@code {
    private const string _disabledCode =
        "<MariloSwitch IsOn=\"true\" Disabled=\"true\" Label=\"On and disabled\" />\n" +
        "<MariloSwitch IsOn=\"false\" Disabled=\"true\" Label=\"Off and disabled\" />";
}
