@page "/components/switch/events"
@layout ComponentDemoLayout

<DemoSection Title="IsOnChanged" Description="Handle switch toggle with the IsOnChanged callback." Code="@_interactiveCode">
    <MariloField>
        <MariloSwitch IsOn="@_switchOn" IsOnChanged="@(v => _switchOn = v)" Label="Toggle me" />
    </MariloField>
    <p><strong>Switch is on:</strong> @_switchOn</p>
</DemoSection>

@code {
    private bool _switchOn;

    private const string _interactiveCode =
        "<MariloSwitch IsOn=\"@_switchOn\" IsOnChanged=\"@(v => _switchOn = v)\" Label=\"Toggle me\" />\n" +
        "<p><strong>Switch is on:</strong> @_switchOn</p>\n\n" +
        "@code {\n" +
        "    private bool _switchOn;\n" +
        "}";
}
