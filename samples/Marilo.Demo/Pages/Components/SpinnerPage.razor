@page "/components/spinner"

<div class="demo-page">
    <h1>Spinner</h1>
    <p class="demo-page-desc">Spinners indicate an ongoing process, such as loading data.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Feedback.MariloSpinner.html" target="_blank">API Reference</a>

    <DemoSection Title="Sizes" Description="Spinners are available in small, medium, and large sizes." Code="@_sizesCode">
        <div class="demo-row">
            <MariloSpinner Size="SpinnerSize.Small" />
            <MariloSpinner Size="SpinnerSize.Medium" />
            <MariloSpinner Size="SpinnerSize.Large" />
        </div>
    </DemoSection>
</div>

@code {
    private const string _sizesCode =
        "<MariloSpinner Size=\"SpinnerSize.Small\" />\n" +
        "<MariloSpinner Size=\"SpinnerSize.Medium\" />\n" +
        "<MariloSpinner Size=\"SpinnerSize.Large\" />";
}
