@page "/components/avatar"

<div class="demo-page">
    <h1>Avatar</h1>
    <p class="demo-page-desc">Avatars display images, icons, or initials representing people or other entities.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.DataDisplay.MariloAvatar.html" target="_blank">API Reference</a>

    <DemoSection Title="Sizes" Code="@_sizesCode">
        <div class="demo-row">
            <MariloAvatar Size="AvatarSize.ExtraSmall" Initials="XS" />
            <MariloAvatar Size="AvatarSize.Small" Initials="SM" />
            <MariloAvatar Size="AvatarSize.Medium" Initials="MD" />
            <MariloAvatar Size="AvatarSize.Large" Initials="LG" />
            <MariloAvatar Size="AvatarSize.ExtraLarge" Initials="XL" />
        </div>
    </DemoSection>
</div>

@code {
    private const string _sizesCode =
        "<MariloAvatar Size=\"AvatarSize.ExtraSmall\" Initials=\"XS\" />\n" +
        "<MariloAvatar Size=\"AvatarSize.Small\" Initials=\"SM\" />\n" +
        "<MariloAvatar Size=\"AvatarSize.Medium\" Initials=\"MD\" />\n" +
        "<MariloAvatar Size=\"AvatarSize.Large\" Initials=\"LG\" />\n" +
        "<MariloAvatar Size=\"AvatarSize.ExtraLarge\" Initials=\"XL\" />";
}
