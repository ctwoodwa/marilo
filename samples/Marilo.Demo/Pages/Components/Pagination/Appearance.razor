@page "/components/pagination/appearance"
@layout ComponentDemoLayout

<DemoSection Title="Sizes" Description="Pagination supports different sizes." Code="@_sizesCode">
    <MariloPagination TotalPages="5" CurrentPage="1" Size="PaginationSize.Small" />
    <MariloPagination TotalPages="5" CurrentPage="1" Size="PaginationSize.Medium" />
    <MariloPagination TotalPages="5" CurrentPage="1" Size="PaginationSize.Large" />
</DemoSection>

<DemoSection Title="Variants" Description="Pagination can be displayed with different visual styles." Code="@_variantsCode">
    <MariloPagination TotalPages="5" CurrentPage="1" Variant="PaginationVariant.Default" />
    <MariloPagination TotalPages="5" CurrentPage="1" Variant="PaginationVariant.Outlined" />
</DemoSection>

@code {
    private const string _sizesCode =
        "<MariloPagination TotalPages=\"5\" CurrentPage=\"1\" Size=\"PaginationSize.Small\" />\n" +
        "<MariloPagination TotalPages=\"5\" CurrentPage=\"1\" Size=\"PaginationSize.Medium\" />\n" +
        "<MariloPagination TotalPages=\"5\" CurrentPage=\"1\" Size=\"PaginationSize.Large\" />";

    private const string _variantsCode =
        "<MariloPagination TotalPages=\"5\" CurrentPage=\"1\" Variant=\"PaginationVariant.Default\" />\n" +
        "<MariloPagination TotalPages=\"5\" CurrentPage=\"1\" Variant=\"PaginationVariant.Outlined\" />";
}
