@page "/components/text-field/events"
@layout ComponentDemoLayout

<DemoSection Title="Interactive" Description="Handle value changes with the ValueChanged callback." Code="@_interactiveCode">
    <MariloField>
        <MariloLabel>Type something</MariloLabel>
        <MariloTextField Value="@_name" ValueChanged="@(v => _name = v)" Placeholder="Enter your name" />
    </MariloField>
    <p><strong>Value:</strong> @_name</p>
</DemoSection>

@code {
    private string _name = "";

    private const string _interactiveCode =
        "<MariloTextField Value=\"@_name\" ValueChanged=\"@(v => _name = v)\" Placeholder=\"Enter your name\" />\n" +
        "<p><strong>Value:</strong> @_name</p>\n\n" +
        "@code {\n" +
        "    private string _name = \"\";\n" +
        "}";
}
