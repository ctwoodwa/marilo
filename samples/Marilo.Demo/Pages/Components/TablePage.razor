@page "/components/table"

<div class="demo-page">
    <h1>Table</h1>
    <p class="demo-page-desc">Tables display structured data in rows and columns for comparison and analysis.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.DataDisplay.MariloTable.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloTable>
            <thead>
                <tr><th>Name</th><th>Role</th><th>Status</th></tr>
            </thead>
            <tbody>
                <tr><td>Alice</td><td>Admin</td><td><MariloBadge Variant="BadgeVariant.Success">Active</MariloBadge></td></tr>
                <tr><td>Bob</td><td>User</td><td><MariloBadge Variant="BadgeVariant.Warning">Pending</MariloBadge></td></tr>
                <tr><td>Charlie</td><td>Editor</td><td><MariloBadge Variant="BadgeVariant.Danger">Inactive</MariloBadge></td></tr>
            </tbody>
        </MariloTable>
    </DemoSection>
</div>

@code {
    private const string _basicCode =
        "<MariloTable>\n" +
        "    <thead>\n" +
        "        <tr><th>Name</th><th>Role</th><th>Status</th></tr>\n" +
        "    </thead>\n" +
        "    <tbody>\n" +
        "        <tr>\n" +
        "            <td>Alice</td><td>Admin</td>\n" +
        "            <td><MariloBadge Variant=\"BadgeVariant.Success\">Active</MariloBadge></td>\n" +
        "        </tr>\n" +
        "        <tr>\n" +
        "            <td>Bob</td><td>User</td>\n" +
        "            <td><MariloBadge Variant=\"BadgeVariant.Warning\">Pending</MariloBadge></td>\n" +
        "        </tr>\n" +
        "        <tr>\n" +
        "            <td>Charlie</td><td>Editor</td>\n" +
        "            <td><MariloBadge Variant=\"BadgeVariant.Danger\">Inactive</MariloBadge></td>\n" +
        "        </tr>\n" +
        "    </tbody>\n" +
        "</MariloTable>";
}
