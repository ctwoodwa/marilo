@page "/components/breadcrumb/appearance"
@layout ComponentDemoLayout

<DemoSection Title="Custom Separator" Description="Breadcrumbs can use a custom separator character." Code="@_separatorCode">
    <MariloBreadcrumb Separator="/">
        <MariloBreadcrumbItem Href="/">Home</MariloBreadcrumbItem>
        <MariloBreadcrumbItem Href="/components">Components</MariloBreadcrumbItem>
        <MariloBreadcrumbItem IsActive="true">Breadcrumb</MariloBreadcrumbItem>
    </MariloBreadcrumb>
</DemoSection>

<DemoSection Title="With Icons" Description="Breadcrumb items can include icons for visual clarity." Code="@_iconsCode">
    <MariloBreadcrumb>
        <MariloBreadcrumbItem Href="/" Icon="home">Home</MariloBreadcrumbItem>
        <MariloBreadcrumbItem Href="/components" Icon="grid">Components</MariloBreadcrumbItem>
        <MariloBreadcrumbItem IsActive="true" Icon="navigation">Breadcrumb</MariloBreadcrumbItem>
    </MariloBreadcrumb>
</DemoSection>

@code {
    private const string _separatorCode =
        "<MariloBreadcrumb Separator=\"/\">\n" +
        "    <MariloBreadcrumbItem Href=\"/\">Home</MariloBreadcrumbItem>\n" +
        "    <MariloBreadcrumbItem Href=\"/components\">Components</MariloBreadcrumbItem>\n" +
        "    <MariloBreadcrumbItem IsActive=\"true\">Breadcrumb</MariloBreadcrumbItem>\n" +
        "</MariloBreadcrumb>";

    private const string _iconsCode =
        "<MariloBreadcrumb>\n" +
        "    <MariloBreadcrumbItem Href=\"/\" Icon=\"home\">Home</MariloBreadcrumbItem>\n" +
        "    <MariloBreadcrumbItem Href=\"/components\" Icon=\"grid\">Components</MariloBreadcrumbItem>\n" +
        "    <MariloBreadcrumbItem IsActive=\"true\" Icon=\"navigation\">Breadcrumb</MariloBreadcrumbItem>\n" +
        "</MariloBreadcrumb>";
}
