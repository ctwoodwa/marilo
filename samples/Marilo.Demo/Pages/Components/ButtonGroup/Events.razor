@page "/components/button-group/events"
@layout ComponentDemoLayout

<DemoSection Title="OnClick" Description="Handle click events on individual buttons within the group." Code="@_clickCode">
    <MariloButtonGroup>
        <MariloButton Variant="ButtonVariant.Primary" OnClick="@(() => _selected = "Left")">Left</MariloButton>
        <MariloButton Variant="ButtonVariant.Secondary" OnClick="@(() => _selected = "Center")">Center</MariloButton>
        <MariloButton Variant="ButtonVariant.Secondary" OnClick="@(() => _selected = "Right")">Right</MariloButton>
    </MariloButtonGroup>
    <p><strong>Selected:</strong> @_selected</p>
</DemoSection>

@code {
    private string _selected = "Left";

    private const string _clickCode =
        "<MariloButtonGroup>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Primary\" OnClick=\"@(() => _selected = \"Left\")\">Left</MariloButton>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\" OnClick=\"@(() => _selected = \"Center\")\">Center</MariloButton>\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\" OnClick=\"@(() => _selected = \"Right\")\">Right</MariloButton>\n" +
        "</MariloButtonGroup>\n" +
        "<p><strong>Selected:</strong> @_selected</p>\n\n" +
        "@code {\n" +
        "    private string _selected = \"Left\";\n" +
        "}";
}
