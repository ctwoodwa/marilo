@page "/components/segmented-control"

<div class="demo-page">
    <h1>Segmented Control</h1>
    <p class="demo-page-desc">Segmented controls let users select one option from a set of mutually exclusive choices.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Buttons.MariloSegmentedControl.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloSegmentedControl Value="@_view" ValueChanged="@(v => _view = v)">
            <MariloSegmentedItem Value="List">List</MariloSegmentedItem>
            <MariloSegmentedItem Value="Grid">Grid</MariloSegmentedItem>
            <MariloSegmentedItem Value="Map">Map</MariloSegmentedItem>
        </MariloSegmentedControl>
        <p><strong>Selected:</strong> @_view</p>
    </DemoSection>
</div>

@code {
    private string _view = "List";

    private const string _basicCode =
        "<MariloSegmentedControl Value=\"@_view\" ValueChanged=\"@(v => _view = v)\">\n" +
        "    <MariloSegmentedItem Value=\"List\">List</MariloSegmentedItem>\n" +
        "    <MariloSegmentedItem Value=\"Grid\">Grid</MariloSegmentedItem>\n" +
        "    <MariloSegmentedItem Value=\"Map\">Map</MariloSegmentedItem>\n" +
        "</MariloSegmentedControl>\n" +
        "<p><strong>Selected:</strong> @_view</p>\n\n" +
        "@code {\n" +
        "    private string _view = \"List\";\n" +
        "}";
}
