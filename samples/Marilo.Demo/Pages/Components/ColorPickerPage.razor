@page "/components/color-picker"

<div class="demo-page">
    <h1>Color Picker</h1>
    <p class="demo-page-desc">The color picker lets users select a color value.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Forms.Inputs.MariloColorPicker.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloColorPicker Value="@_color" ValueChanged="@(v => _color = v)" />
        <div style="width: 48px; height: 48px; background: @_color; border-radius: 4px; margin-top: 8px;"></div>
        <p><strong>Selected color:</strong> @_color</p>
    </DemoSection>
</div>

@code {
    private string _color = "#0078d4";

    private const string _basicCode =
        "<MariloColorPicker Value=\"@_color\" ValueChanged=\"@(v => _color = v)\" />\n" +
        "<div style=\"width: 48px; height: 48px; background: @_color; border-radius: 4px; margin-top: 8px;\"></div>\n" +
        "<p><strong>Selected color:</strong> @_color</p>\n\n" +
        "@code {\n" +
        "    private string _color = \"#0078d4\";\n" +
        "}";
}
