@page "/components/checkbox"

<div class="demo-page">
    <h1>Checkbox</h1>
    <p class="demo-page-desc">Checkboxes let users select one or more items from a list, or toggle an option on or off.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Forms.Inputs.MariloCheckbox.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloField>
            <MariloCheckbox Checked="@_checked" CheckedChanged="@(v => _checked = v)" Label="Accept terms and conditions" />
        </MariloField>
    </DemoSection>

    <DemoSection Title="Interactive" Code="@_interactiveCode">
        <MariloField>
            <MariloCheckbox Checked="@_checked" CheckedChanged="@(v => _checked = v)" Label="Toggle me" />
        </MariloField>
        <p><strong>Checked:</strong> @_checked</p>
    </DemoSection>
</div>

@code {
    private bool _checked;

    private const string _basicCode =
        "<MariloCheckbox Checked=\"@_checked\" CheckedChanged=\"@(v => _checked = v)\" Label=\"Accept terms and conditions\" />";

    private const string _interactiveCode =
        "<MariloCheckbox Checked=\"@_checked\" CheckedChanged=\"@(v => _checked = v)\" Label=\"Toggle me\" />\n" +
        "<p><strong>Checked:</strong> @_checked</p>\n\n" +
        "@code {\n" +
        "    private bool _checked;\n" +
        "}";
}
