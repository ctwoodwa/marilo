@page "/components/map"
@page "/components/map/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Local Basemap (Washington, D.C.)" Description="Map renders local vector tiles from OpenStreetMap data, generated by Planetiler and served as PMTiles. No external tile API required." Code="@_localBasemapCode">
        <MariloMap StyleUrl="/map-styles/basemap-local.json"
                   Center="_dcCenter"
                   Zoom="12"
                   Markers="_dcMarkers"
                   Height="500px"
                   OnMarkerClick="HandleMarkerClick" />

        @if (_selectedMarker != null)
        {
            <div style="margin-top:12px;padding:8px;background:#e3f2fd;border-radius:4px;font-size:13px;">
                Selected: <strong>@_selectedMarker.Title</strong> (@_selectedMarker.Latitude.ToString("F4"), @_selectedMarker.Longitude.ToString("F4"))
            </div>
        }
    </DemoSection>
</PageSection>

<PageSection Title="Features">
    <DemoSection Title="Interactive Markers" Description="Click markers to see a popup with their name. The marker click event also fires a Blazor callback." Code="@_interactiveCode">
        <MariloMap StyleUrl="/map-styles/basemap-local.json"
                   Center="_dcCenter"
                   Zoom="13"
                   Markers="_dcLandmarks"
                   Height="450px"
                   OnMarkerClick="HandleMarkerClick" />

        @if (_selectedMarker != null)
        {
            <div style="margin-top:12px;padding:8px;background:#e3f2fd;border-radius:4px;font-size:13px;">
                Selected: <strong>@_selectedMarker.Title</strong> (@_selectedMarker.Latitude.ToString("F4"), @_selectedMarker.Longitude.ToString("F4"))
            </div>
        }
    </DemoSection>

    <DemoSection Title="Zoomed Out — Natural Earth" Description="At low zoom levels, the map shows Natural Earth data: coastlines, country boundaries, and water bodies." Code="@_zoomedOutCode">
        <MariloMap StyleUrl="/map-styles/basemap-local.json"
                   Center="_usCenter"
                   Zoom="4"
                   Height="400px" />
    </DemoSection>
</PageSection>

@code {
    private MapMarker? _selectedMarker;

    private MapCenter _dcCenter = new() { Latitude = 38.8977, Longitude = -77.0365 };
    private MapCenter _usCenter = new() { Latitude = 39.8283, Longitude = -98.5795 };

    private List<MapMarker> _dcMarkers = new()
    {
        new MapMarker { Title = "The White House", Latitude = 38.8977, Longitude = -77.0365 },
        new MapMarker { Title = "U.S. Capitol", Latitude = 38.8899, Longitude = -77.0091 },
        new MapMarker { Title = "Lincoln Memorial", Latitude = 38.8893, Longitude = -77.0502 },
        new MapMarker { Title = "Washington Monument", Latitude = 38.8895, Longitude = -77.0353 },
    };

    private List<MapMarker> _dcLandmarks = new()
    {
        new MapMarker { Title = "Smithsonian National Mall", Latitude = 38.8891, Longitude = -77.0261 },
        new MapMarker { Title = "Georgetown Waterfront", Latitude = 38.9025, Longitude = -77.0635 },
        new MapMarker { Title = "Union Station", Latitude = 38.8973, Longitude = -77.0063 },
        new MapMarker { Title = "Dupont Circle", Latitude = 38.9096, Longitude = -77.0434 },
        new MapMarker { Title = "National Zoo", Latitude = 38.9296, Longitude = -77.0499 },
    };

    private Task HandleMarkerClick(MapMarker marker)
    {
        _selectedMarker = marker;
        return Task.CompletedTask;
    }

    private const string _localBasemapCode =
        "<MariloMap StyleUrl=\"/map-styles/basemap-local.json\"\n" +
        "           Center=\"_dcCenter\"\n" +
        "           Zoom=\"12\"\n" +
        "           Markers=\"_dcMarkers\"\n" +
        "           Height=\"500px\"\n" +
        "           OnMarkerClick=\"HandleMarkerClick\" />";

    private const string _interactiveCode =
        "<MariloMap StyleUrl=\"/map-styles/basemap-local.json\"\n" +
        "           Center=\"_dcCenter\"\n" +
        "           Zoom=\"13\"\n" +
        "           Markers=\"_dcLandmarks\"\n" +
        "           Height=\"450px\"\n" +
        "           OnMarkerClick=\"HandleMarkerClick\" />";

    private const string _zoomedOutCode =
        "<MariloMap StyleUrl=\"/map-styles/basemap-local.json\"\n" +
        "           Center=\"_usCenter\"\n" +
        "           Zoom=\"4\"\n" +
        "           Height=\"400px\" />";
}
