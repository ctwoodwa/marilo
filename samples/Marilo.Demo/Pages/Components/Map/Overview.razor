@page "/components/map"
@page "/components/map/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Description="Map displays markers on a geographic canvas. This is a prototype-ready API surface; map tile rendering requires a tile provider integration." Code="@_basicCode">
        <MariloMap Center="_center"
                   Zoom="8"
                   Markers="_markers"
                   Height="400px"
                   OnMarkerClick="HandleMarkerClick" />
    </DemoSection>
</PageSection>

<PageSection Title="Features">
    <DemoSection Title="Interactive Markers" Description="Click markers to see their details. Marker positions are normalized based on the center point and zoom level." Code="@_interactiveCode">
        <MariloMap Center="_usCenter"
                   Zoom="4"
                   Markers="_usMarkers"
                   Height="400px"
                   OnMarkerClick="HandleMarkerClick" />

        @if (_selectedMarker != null)
        {
            <div style="margin-top:12px;padding:8px;background:#e3f2fd;border-radius:4px;font-size:13px;">
                Selected: <strong>@_selectedMarker.Title</strong> (@_selectedMarker.Latitude.ToString("F2"), @_selectedMarker.Longitude.ToString("F2"))
            </div>
        }
    </DemoSection>

    <DemoSection Title="Custom Zoom Level" Description="Adjust the zoom level to control how spread out the markers appear." Code="@_zoomCode">
        <div style="margin-bottom:12px;display:flex;gap:8px;align-items:center;">
            <span>Zoom:</span>
            <input type="range" min="1" max="15" @bind="_customZoom" @bind:event="oninput" />
            <span>@_customZoom</span>
        </div>
        <MariloMap Center="_center"
                   Zoom="_customZoom"
                   Markers="_markers"
                   Height="350px" />
    </DemoSection>
</PageSection>

@code {
    private MapMarker? _selectedMarker;
    private int _customZoom = 6;

    private MapCenter _center = new() { Latitude = 48.8566, Longitude = 2.3522 };
    private MapCenter _usCenter = new() { Latitude = 39.8283, Longitude = -98.5795 };

    private List<MapMarker> _markers = new()
    {
        new MapMarker { Title = "Paris", Latitude = 48.8566, Longitude = 2.3522 },
        new MapMarker { Title = "London", Latitude = 51.5074, Longitude = -0.1278 },
        new MapMarker { Title = "Berlin", Latitude = 52.5200, Longitude = 13.4050 },
        new MapMarker { Title = "Madrid", Latitude = 40.4168, Longitude = -3.7038 },
        new MapMarker { Title = "Rome", Latitude = 41.9028, Longitude = 12.4964 },
    };

    private List<MapMarker> _usMarkers = new()
    {
        new MapMarker { Title = "New York", Latitude = 40.7128, Longitude = -74.0060 },
        new MapMarker { Title = "Los Angeles", Latitude = 34.0522, Longitude = -118.2437 },
        new MapMarker { Title = "Chicago", Latitude = 41.8781, Longitude = -87.6298 },
        new MapMarker { Title = "Houston", Latitude = 29.7604, Longitude = -95.3698 },
        new MapMarker { Title = "Phoenix", Latitude = 33.4484, Longitude = -112.0740 },
    };

    private Task HandleMarkerClick(MapMarker marker)
    {
        _selectedMarker = marker;
        return Task.CompletedTask;
    }

    private const string _basicCode =
        "<MariloMap Center=\"_center\"\n" +
        "           Zoom=\"8\"\n" +
        "           Markers=\"_markers\"\n" +
        "           Height=\"400px\"\n" +
        "           OnMarkerClick=\"HandleMarkerClick\" />";

    private const string _interactiveCode =
        "<MariloMap Center=\"_usCenter\"\n" +
        "           Zoom=\"4\"\n" +
        "           Markers=\"_usMarkers\"\n" +
        "           Height=\"400px\"\n" +
        "           OnMarkerClick=\"HandleMarkerClick\" />";

    private const string _zoomCode =
        "<input type=\"range\" min=\"1\" max=\"15\" @bind=\"_zoom\" />\n" +
        "<MariloMap Center=\"_center\"\n" +
        "           Zoom=\"_zoom\"\n" +
        "           Markers=\"_markers\"\n" +
        "           Height=\"350px\" />";
}
