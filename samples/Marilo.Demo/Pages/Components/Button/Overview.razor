@page "/components/Button"
@page "/components/Button/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <div class="demo-row">
            <MariloButton Variant="ButtonVariant.Primary">Click me</MariloButton>
        </div>
    </DemoSection>

    <DemoSection Title="Disabled" Code="@_disabledCode">
        <div class="demo-row">
            <MariloButton Enabled="false">Disabled</MariloButton>
            <MariloButton Variant="ButtonVariant.Danger" Enabled="false">Disabled Danger</MariloButton>
        </div>
    </DemoSection>
</PageSection>

<PageSection Title="Appearance">
    <DemoSection Title="Variants" Description="Buttons come in several variants to indicate different levels of emphasis." Code="@_variantsCode">
        <div class="demo-row">
            <MariloButton Variant="ButtonVariant.Primary">Primary</MariloButton>
            <MariloButton Variant="ButtonVariant.Secondary">Secondary</MariloButton>
            <MariloButton Variant="ButtonVariant.Danger">Danger</MariloButton>
            <MariloButton Variant="ButtonVariant.Warning">Warning</MariloButton>
            <MariloButton Variant="ButtonVariant.Info">Info</MariloButton>
            <MariloButton Variant="ButtonVariant.Success">Success</MariloButton>
        </div>
    </DemoSection>

    <DemoSection Title="Sizes" Code="@_sizesCode">
        <div class="demo-row">
            <MariloButton Size="ButtonSize.Small">Small</MariloButton>
            <MariloButton Size="ButtonSize.Medium">Medium</MariloButton>
            <MariloButton Size="ButtonSize.Large">Large</MariloButton>
        </div>
    </DemoSection>

    <DemoSection Title="Fill Modes" Description="FillMode controls the visual weight of the button — from solid to outline, flat, link-style, or invisible." Code="@_fillModeCode">
        <div class="demo-row">
            <MariloButton Variant="ButtonVariant.Primary" FillMode="FillMode.Solid">Solid</MariloButton>
            <MariloButton Variant="ButtonVariant.Primary" FillMode="FillMode.Outline">Outline</MariloButton>
            <MariloButton Variant="ButtonVariant.Primary" FillMode="FillMode.Flat">Flat</MariloButton>
            <MariloButton Variant="ButtonVariant.Primary" FillMode="FillMode.Link">Link</MariloButton>
            <MariloButton Variant="ButtonVariant.Primary" FillMode="FillMode.Clear">Clear</MariloButton>
        </div>
    </DemoSection>

    <DemoSection Title="Rounded" Description="Control the border-radius of the button with the Rounded parameter." Code="@_roundedCode">
        <div class="demo-row">
            <MariloButton Rounded="RoundedMode.None">None</MariloButton>
            <MariloButton Rounded="RoundedMode.Small">Small</MariloButton>
            <MariloButton Rounded="RoundedMode.Medium">Medium</MariloButton>
            <MariloButton Rounded="RoundedMode.Large">Large</MariloButton>
            <MariloButton Rounded="RoundedMode.Full">Full</MariloButton>
        </div>
    </DemoSection>

    <DemoSection Title="With Icon" Description="Use the Icon render fragment slot to place an icon inside the button." Code="@_iconCode">
        <div class="demo-row">
            <MariloButton Variant="ButtonVariant.Primary">
                <Icon>★</Icon>
                <ChildContent>Star</ChildContent>
            </MariloButton>
            <MariloButton Variant="ButtonVariant.Success">
                <Icon>✓</Icon>
                <ChildContent>Confirm</ChildContent>
            </MariloButton>
            <MariloButton Variant="ButtonVariant.Danger" FillMode="FillMode.Outline">
                <Icon>✕</Icon>
                <ChildContent>Delete</ChildContent>
            </MariloButton>
        </div>
    </DemoSection>
</PageSection>

<PageSection Title="Button Type">
    <DemoSection Title="Submit and Reset" Description="Use ButtonType to integrate with HTML forms." Code="@_typeCode">
        <EditForm Model="@_formModel" OnValidSubmit="@OnFormSubmit">
            <div style="display:flex;flex-direction:column;gap:8px;max-width:300px;">
                <input class="mar-input" @bind="_formModel.Name" placeholder="Enter your name" />
                <div class="demo-row">
                    <MariloButton ButtonType="ButtonType.Submit" Variant="ButtonVariant.Primary">Submit</MariloButton>
                    <MariloButton ButtonType="ButtonType.Reset" Variant="ButtonVariant.Secondary">Reset</MariloButton>
                </div>
            </div>
        </EditForm>
        @if (!string.IsNullOrEmpty(_submittedName))
        {
            <p style="margin-top:8px;">Submitted: <strong>@_submittedName</strong></p>
        }
    </DemoSection>
</PageSection>

<PageSection Title="Events">
    <DemoSection Title="OnClick" Description="Handle button clicks with the OnClick callback." Code="@_clickCode">
        <div class="demo-row">
            <MariloButton Variant="ButtonVariant.Primary" OnClick="@OnClickHandler">Click me: @_clickCount</MariloButton>
            <MariloButton Variant="ButtonVariant.Secondary" OnClick="@OnResetHandler">Reset</MariloButton>
        </div>
    </DemoSection>
</PageSection>

<PageSection Title="Accessibility">
    <AccessibilityInfo
        KeyboardInteractions="@_keyboard"
        AriaAttributes="@_aria"
        ScreenReaderNotes="@_screenReader" />
</PageSection>

@code {
    // Overview
    private const string _basicCode =
        "<MariloButton Variant=\"ButtonVariant.Primary\">Click me</MariloButton>";

    private const string _disabledCode =
        "<MariloButton Enabled=\"false\">Disabled</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Danger\" Enabled=\"false\">Disabled Danger</MariloButton>";

    // Appearance
    private const string _variantsCode =
        "<MariloButton Variant=\"ButtonVariant.Primary\">Primary</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Secondary\">Secondary</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Danger\">Danger</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Warning\">Warning</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Info\">Info</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Success\">Success</MariloButton>";

    private const string _sizesCode =
        "<MariloButton Size=\"ButtonSize.Small\">Small</MariloButton>\n" +
        "<MariloButton Size=\"ButtonSize.Medium\">Medium</MariloButton>\n" +
        "<MariloButton Size=\"ButtonSize.Large\">Large</MariloButton>";

    private const string _fillModeCode =
        "<MariloButton Variant=\"ButtonVariant.Primary\" FillMode=\"FillMode.Solid\">Solid</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Primary\" FillMode=\"FillMode.Outline\">Outline</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Primary\" FillMode=\"FillMode.Flat\">Flat</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Primary\" FillMode=\"FillMode.Link\">Link</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Primary\" FillMode=\"FillMode.Clear\">Clear</MariloButton>";

    private const string _roundedCode =
        "<MariloButton Rounded=\"RoundedMode.None\">None</MariloButton>\n" +
        "<MariloButton Rounded=\"RoundedMode.Small\">Small</MariloButton>\n" +
        "<MariloButton Rounded=\"RoundedMode.Medium\">Medium</MariloButton>\n" +
        "<MariloButton Rounded=\"RoundedMode.Large\">Large</MariloButton>\n" +
        "<MariloButton Rounded=\"RoundedMode.Full\">Full</MariloButton>";

    private const string _iconCode =
        "<MariloButton Variant=\"ButtonVariant.Primary\">\n" +
        "    <Icon>★</Icon>\n" +
        "    Star\n" +
        "</MariloButton>\n" +
        "<MariloButton Variant=\"ButtonVariant.Success\">\n" +
        "    <Icon>✓</Icon>\n" +
        "    Confirm\n" +
        "</MariloButton>";

    // Button Type
    private class FormModel { public string Name { get; set; } = ""; }
    private FormModel _formModel = new();
    private string _submittedName = "";

    private void OnFormSubmit()
    {
        _submittedName = _formModel.Name;
    }

    private const string _typeCode =
        "<EditForm Model=\"@_model\" OnValidSubmit=\"@OnFormSubmit\">\n" +
        "    <input @bind=\"_model.Name\" placeholder=\"Enter your name\" />\n" +
        "    <MariloButton ButtonType=\"ButtonType.Submit\" Variant=\"ButtonVariant.Primary\">Submit</MariloButton>\n" +
        "    <MariloButton ButtonType=\"ButtonType.Reset\" Variant=\"ButtonVariant.Secondary\">Reset</MariloButton>\n" +
        "</EditForm>";

    // Events
    private int _clickCount;
    private void OnClickHandler() => _clickCount++;
    private void OnResetHandler() => _clickCount = 0;

    private const string _clickCode =
        "<MariloButton Variant=\"ButtonVariant.Primary\" OnClick=\"@OnClickHandler\">\n" +
        "    Click me: @_clickCount\n" +
        "</MariloButton>\n\n" +
        "@code {\n" +
        "    private int _clickCount;\n" +
        "    private void OnClickHandler() => _clickCount++;\n" +
        "}";

    // Accessibility
    private static readonly (string Key, string Action)[] _keyboard =
    [
        ("Enter", "Activates the button"),
        ("Space", "Activates the button"),
        ("Tab", "Moves focus to the next focusable element"),
        ("Shift + Tab", "Moves focus to the previous focusable element"),
    ];

    private static readonly (string Attribute, string Description)[] _aria =
    [
        ("role=\"button\"", "Implicitly set by the <button> element"),
        ("aria-disabled=\"true\"", "Applied when the Enabled parameter is false"),
        ("aria-label", "Can be set for icon-only buttons that have no visible text"),
    ];

    private static readonly string[] _screenReader =
    [
        "Buttons are announced with their visible text content and the \"button\" role.",
        "Disabled buttons are announced as \"dimmed\" or \"unavailable\" depending on the screen reader.",
        "Icon-only buttons should use aria-label to provide an accessible name.",
    ];
}
