@page "/components/alert"

<div class="demo-page">
    <h1>Alert</h1>
    <p class="demo-page-desc">Alerts display brief, important messages to attract the user's attention without interrupting their task.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Feedback.MariloAlert.html" target="_blank">API Reference</a>

    <DemoSection Title="Severities" Description="Alerts support multiple severity levels to convey the importance of the message." Code="@_severitiesCode">
        <MariloAlert Severity="AlertSeverity.Info">This is an info alert.</MariloAlert>
        <MariloAlert Severity="AlertSeverity.Success">Operation completed successfully.</MariloAlert>
        <MariloAlert Severity="AlertSeverity.Warning">Please review your settings.</MariloAlert>
        <MariloAlert Severity="AlertSeverity.Critical">A critical error has occurred.</MariloAlert>
    </DemoSection>

    <DemoSection Title="Dismissible" Description="Alerts can be made dismissible to let users close them." Code="@_dismissibleCode">
        <MariloAlert Severity="AlertSeverity.Info" IsDismissible="true" OnDismiss="@(() => {})">
            This alert can be dismissed.
        </MariloAlert>
    </DemoSection>
</div>

@code {
    private const string _severitiesCode =
        "<MariloAlert Severity=\"AlertSeverity.Info\">This is an info alert.</MariloAlert>\n" +
        "<MariloAlert Severity=\"AlertSeverity.Success\">Operation completed successfully.</MariloAlert>\n" +
        "<MariloAlert Severity=\"AlertSeverity.Warning\">Please review your settings.</MariloAlert>\n" +
        "<MariloAlert Severity=\"AlertSeverity.Critical\">A critical error has occurred.</MariloAlert>";

    private const string _dismissibleCode =
        "<MariloAlert Severity=\"AlertSeverity.Info\" IsDismissible=\"true\" OnDismiss=\"@(() => {})\">\n" +
        "    This alert can be dismissed.\n" +
        "</MariloAlert>";
}
