@page "/components/tooltip/appearance"
@layout ComponentDemoLayout

<DemoSection Title="Positions" Description="Tooltips can be positioned at the top or bottom of their target element." Code="@_positionsCode">
    <div class="demo-row">
        <MariloTooltip Text="This is a top tooltip" Position="TooltipPosition.Top">
            <MariloButton Variant="ButtonVariant.Secondary">Hover me (Top)</MariloButton>
        </MariloTooltip>
        <MariloTooltip Text="This is a bottom tooltip" Position="TooltipPosition.Bottom">
            <MariloButton Variant="ButtonVariant.Secondary">Hover me (Bottom)</MariloButton>
        </MariloTooltip>
    </div>
</DemoSection>

@code {
    private const string _positionsCode =
        "<MariloTooltip Text=\"This is a top tooltip\" Position=\"TooltipPosition.Top\">\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\">Hover me (Top)</MariloButton>\n" +
        "</MariloTooltip>\n\n" +
        "<MariloTooltip Text=\"This is a bottom tooltip\" Position=\"TooltipPosition.Bottom\">\n" +
        "    <MariloButton Variant=\"ButtonVariant.Secondary\">Hover me (Bottom)</MariloButton>\n" +
        "</MariloTooltip>";
}
