@page "/components/panelbar"
@page "/components/panelbar/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <MariloAlert Severity="AlertSeverity.Info" style="margin-bottom:16px;">
        The PanelBar is provided by the <strong>MariloAccordion</strong> and <strong>MariloAccordionItem</strong> components, which support both manual (declarative) and data-driven accordion patterns.
    </MariloAlert>

    <DemoSection Title="Basic Accordion" Description="Use MariloAccordion with MariloAccordionItem children to create expandable panels. Each item has a Title and optional child content." Code="@_basicCode">
        <MariloAccordion>
            <MariloAccordionItem Title="Getting Started" IsExpanded="true">
                <p>Marilo is an enterprise-grade Blazor component library for .NET 10. Install the NuGet package and add the theme provider to get started.</p>
            </MariloAccordionItem>
            <MariloAccordionItem Title="Components">
                <p>The library includes buttons, inputs, data grids, layout containers, overlays, and more — all driven by a pluggable provider architecture.</p>
            </MariloAccordionItem>
            <MariloAccordionItem Title="Theming">
                <p>Wrap your application in MariloThemeProvider to enable CSS variable-based theming with light and dark mode support.</p>
            </MariloAccordionItem>
        </MariloAccordion>
    </DemoSection>

    <DemoSection Title="Single Expand Mode" Description="Set ExpandMode to Single so only one panel can be open at a time. Opening a new panel collapses the previous one." Code="@_singleCode">
        <MariloAccordion ExpandMode="AccordionExpandMode.Single">
            <MariloAccordionItem Title="Section A">
                <p>Content for section A. Only one section can be open at a time.</p>
            </MariloAccordionItem>
            <MariloAccordionItem Title="Section B">
                <p>Content for section B.</p>
            </MariloAccordionItem>
            <MariloAccordionItem Title="Section C">
                <p>Content for section C.</p>
            </MariloAccordionItem>
        </MariloAccordion>
    </DemoSection>

    <DemoSection Title="Disabled Items" Description="Set Disabled on individual MariloAccordionItem elements to prevent expansion." Code="@_disabledCode">
        <MariloAccordion>
            <MariloAccordionItem Title="Available">
                <p>This panel can be toggled normally.</p>
            </MariloAccordionItem>
            <MariloAccordionItem Title="Disabled Panel" Disabled="true">
                <p>This content is not reachable.</p>
            </MariloAccordionItem>
        </MariloAccordion>
    </DemoSection>
</PageSection>

@code {
    private const string _basicCode =
        "<MariloAccordion>\n" +
        "    <MariloAccordionItem Title=\"Getting Started\" IsExpanded=\"true\">\n" +
        "        <p>Install the NuGet package to get started.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "    <MariloAccordionItem Title=\"Components\">\n" +
        "        <p>Buttons, inputs, grids, and more.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "</MariloAccordion>";

    private const string _singleCode =
        "<MariloAccordion ExpandMode=\"AccordionExpandMode.Single\">\n" +
        "    <MariloAccordionItem Title=\"Section A\">\n" +
        "        <p>Only one section open at a time.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "    <MariloAccordionItem Title=\"Section B\">\n" +
        "        <p>Content for section B.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "</MariloAccordion>";

    private const string _disabledCode =
        "<MariloAccordion>\n" +
        "    <MariloAccordionItem Title=\"Available\">\n" +
        "        <p>This panel can be toggled.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "    <MariloAccordionItem Title=\"Disabled Panel\" Disabled=\"true\">\n" +
        "        <p>Not reachable.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "</MariloAccordion>";
}
