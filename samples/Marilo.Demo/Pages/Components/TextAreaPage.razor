@page "/components/text-area"

<div class="demo-page">
    <h1>Text Area</h1>
    <p class="demo-page-desc">The text area allows users to enter multi-line text.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Forms.Inputs.MariloTextArea.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloField>
            <MariloLabel>Description</MariloLabel>
            <MariloTextArea Value="@_description" ValueChanged="@(v => _description = v)" Rows="4" Placeholder="Enter a description" />
        </MariloField>
    </DemoSection>

    <DemoSection Title="Disabled" Code="@_disabledCode">
        <MariloField>
            <MariloLabel>Disabled</MariloLabel>
            <MariloTextArea Value="This text area is disabled" Disabled="true" Rows="4" />
        </MariloField>
    </DemoSection>
</div>

@code {
    private string _description = "";

    private const string _basicCode =
        "<MariloField>\n" +
        "    <MariloLabel>Description</MariloLabel>\n" +
        "    <MariloTextArea Value=\"@_description\" ValueChanged=\"@(v => _description = v)\" Rows=\"4\" Placeholder=\"Enter a description\" />\n" +
        "</MariloField>";

    private const string _disabledCode =
        "<MariloField>\n" +
        "    <MariloLabel>Disabled</MariloLabel>\n" +
        "    <MariloTextArea Value=\"This text area is disabled\" Disabled=\"true\" Rows=\"4\" />\n" +
        "</MariloField>";
}
