@page "/components/menu/appearance"
@layout ComponentDemoLayout

<DemoSection Title="With Icons" Description="Menu items can display icons alongside their labels." Code="@_iconsCode">
    <MariloButton OnClick="@(() => _iconsMenuOpen = !_iconsMenuOpen)">Actions</MariloButton>
    <MariloMenu IsOpen="@_iconsMenuOpen" IsOpenChanged="@((bool v) => _iconsMenuOpen = v)">
        <MariloMenuItem Icon="edit">Edit</MariloMenuItem>
        <MariloMenuItem Icon="copy">Duplicate</MariloMenuItem>
        <MariloMenuItem Icon="delete" Disabled="true">Delete</MariloMenuItem>
    </MariloMenu>
</DemoSection>

<DemoSection Title="With Dividers" Description="Dividers can separate groups of related menu items." Code="@_dividersCode">
    <MariloButton OnClick="@(() => _dividersMenuOpen = !_dividersMenuOpen)">File</MariloButton>
    <MariloMenu IsOpen="@_dividersMenuOpen" IsOpenChanged="@((bool v) => _dividersMenuOpen = v)">
        <MariloMenuItem>New</MariloMenuItem>
        <MariloMenuItem>Open</MariloMenuItem>
        <MariloMenuDivider />
        <MariloMenuItem>Save</MariloMenuItem>
        <MariloMenuItem>Save As</MariloMenuItem>
        <MariloMenuDivider />
        <MariloMenuItem>Exit</MariloMenuItem>
    </MariloMenu>
</DemoSection>

@code {
    private bool _iconsMenuOpen;
    private bool _dividersMenuOpen;

    private const string _iconsCode =
        "<MariloButton OnClick=\"@(() => _menuOpen = !_menuOpen)\">Actions</MariloButton>\n" +
        "<MariloMenu IsOpen=\"@_menuOpen\" IsOpenChanged=\"@(v => _menuOpen = v)\">\n" +
        "    <MariloMenuItem Icon=\"edit\">Edit</MariloMenuItem>\n" +
        "    <MariloMenuItem Icon=\"copy\">Duplicate</MariloMenuItem>\n" +
        "    <MariloMenuItem Icon=\"delete\" Disabled=\"true\">Delete</MariloMenuItem>\n" +
        "</MariloMenu>";

    private const string _dividersCode =
        "<MariloButton OnClick=\"@(() => _menuOpen = !_menuOpen)\">File</MariloButton>\n" +
        "<MariloMenu IsOpen=\"@_menuOpen\" IsOpenChanged=\"@(v => _menuOpen = v)\">\n" +
        "    <MariloMenuItem>New</MariloMenuItem>\n" +
        "    <MariloMenuItem>Open</MariloMenuItem>\n" +
        "    <MariloMenuDivider />\n" +
        "    <MariloMenuItem>Save</MariloMenuItem>\n" +
        "    <MariloMenuItem>Save As</MariloMenuItem>\n" +
        "    <MariloMenuDivider />\n" +
        "    <MariloMenuItem>Exit</MariloMenuItem>\n" +
        "</MariloMenu>";
}
