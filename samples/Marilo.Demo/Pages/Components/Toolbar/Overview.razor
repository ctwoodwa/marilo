@page "/components/toolbar"
@page "/components/toolbar/overview"
@layout ComponentDemoLayout

<DemoSection Title="Basic Usage" Code="@_basicCode">
    <MariloToolbar>
        <MariloToolbarGroup>
            <MariloToolbarToggleButton IsSelected="@_bold" IsSelectedChanged="@((bool v) => _bold = v)">Bold</MariloToolbarToggleButton>
            <MariloToolbarToggleButton IsSelected="@_italic" IsSelectedChanged="@((bool v) => _italic = v)">Italic</MariloToolbarToggleButton>
            <MariloToolbarToggleButton IsSelected="@_underline" IsSelectedChanged="@((bool v) => _underline = v)">Underline</MariloToolbarToggleButton>
        </MariloToolbarGroup>
        <MariloToolbarSeparator />
        <MariloToolbarGroup>
            <MariloToolbarButton>Cut</MariloToolbarButton>
            <MariloToolbarButton>Copy</MariloToolbarButton>
            <MariloToolbarButton>Paste</MariloToolbarButton>
        </MariloToolbarGroup>
        <MariloToolbarSeparator />
        <MariloToolbarButton Disabled="true">Undo</MariloToolbarButton>
    </MariloToolbar>
</DemoSection>

@code {
    private bool _bold, _italic, _underline;

    private const string _basicCode =
        "<MariloToolbar>\n" +
        "    <MariloToolbarGroup>\n" +
        "        <MariloToolbarToggleButton IsSelected=\"@_bold\" IsSelectedChanged=\"@(v => _bold = v)\">Bold</MariloToolbarToggleButton>\n" +
        "        <MariloToolbarToggleButton IsSelected=\"@_italic\" IsSelectedChanged=\"@(v => _italic = v)\">Italic</MariloToolbarToggleButton>\n" +
        "        <MariloToolbarToggleButton IsSelected=\"@_underline\" IsSelectedChanged=\"@(v => _underline = v)\">Underline</MariloToolbarToggleButton>\n" +
        "    </MariloToolbarGroup>\n" +
        "    <MariloToolbarSeparator />\n" +
        "    <MariloToolbarGroup>\n" +
        "        <MariloToolbarButton>Cut</MariloToolbarButton>\n" +
        "        <MariloToolbarButton>Copy</MariloToolbarButton>\n" +
        "        <MariloToolbarButton>Paste</MariloToolbarButton>\n" +
        "    </MariloToolbarGroup>\n" +
        "    <MariloToolbarSeparator />\n" +
        "    <MariloToolbarButton Disabled=\"true\">Undo</MariloToolbarButton>\n" +
        "</MariloToolbar>\n\n" +
        "@code {\n" +
        "    private bool _bold, _italic, _underline;\n" +
        "}";
}
