@page "/components/date-picker"
@page "/components/date-picker/overview"
@layout ComponentDemoLayout

<DemoSection Title="Basic Usage" Code="@_basicCode">
    <MariloField>
        <MariloLabel>Select a date</MariloLabel>
        <MariloDatePicker Value="@_date" ValueChanged="@(v => _date = v)" />
    </MariloField>
    @if (_date.HasValue)
    {
        <p><strong>Selected date:</strong> @_date.Value.ToString("yyyy-MM-dd")</p>
    }
</DemoSection>

@code {
    private DateOnly? _date;

    private const string _basicCode =
        "<MariloField>\n" +
        "    <MariloLabel>Select a date</MariloLabel>\n" +
        "    <MariloDatePicker Value=\"@_date\" ValueChanged=\"@(v => _date = v)\" />\n" +
        "</MariloField>\n" +
        "@if (_date.HasValue)\n" +
        "{\n" +
        "    <p><strong>Selected date:</strong> @_date.Value.ToString(\"yyyy-MM-dd\")</p>\n" +
        "}\n\n" +
        "@code {\n" +
        "    private DateOnly? _date;\n" +
        "}";
}
