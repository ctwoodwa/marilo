@page "/components/accordion/appearance"
@layout ComponentDemoLayout

<DemoSection Title="Multiple Expand" Description="Allow multiple accordion items to be expanded simultaneously." Code="@_multipleCode">
    <MariloAccordion Multiple="true">
        <MariloAccordionItem Title="Section A">
            <p>Content for section A.</p>
        </MariloAccordionItem>
        <MariloAccordionItem Title="Section B">
            <p>Content for section B.</p>
        </MariloAccordionItem>
        <MariloAccordionItem Title="Section C">
            <p>Content for section C.</p>
        </MariloAccordionItem>
    </MariloAccordion>
</DemoSection>

<DemoSection Title="Default Expanded" Description="Set items to be expanded by default." Code="@_expandedCode">
    <MariloAccordion>
        <MariloAccordionItem Title="Expanded by default" IsExpanded="true">
            <p>This item starts expanded.</p>
        </MariloAccordionItem>
        <MariloAccordionItem Title="Collapsed by default">
            <p>This item starts collapsed.</p>
        </MariloAccordionItem>
    </MariloAccordion>
</DemoSection>

@code {
    private const string _multipleCode =
        "<MariloAccordion Multiple=\"true\">\n" +
        "    <MariloAccordionItem Title=\"Section A\">\n" +
        "        <p>Content for section A.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "    <MariloAccordionItem Title=\"Section B\">\n" +
        "        <p>Content for section B.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "    <MariloAccordionItem Title=\"Section C\">\n" +
        "        <p>Content for section C.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "</MariloAccordion>";

    private const string _expandedCode =
        "<MariloAccordion>\n" +
        "    <MariloAccordionItem Title=\"Expanded by default\" IsExpanded=\"true\">\n" +
        "        <p>This item starts expanded.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "    <MariloAccordionItem Title=\"Collapsed by default\">\n" +
        "        <p>This item starts collapsed.</p>\n" +
        "    </MariloAccordionItem>\n" +
        "</MariloAccordion>";
}
