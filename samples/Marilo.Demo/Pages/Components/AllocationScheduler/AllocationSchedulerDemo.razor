    private void BuildCurrencyAllocations()
    {
        // Scale basic hour values by $200/hr blended rate
        _currencyAllocations = _basicAllocations
            .Select(r => new AllocationRecord
            {
                AllocationId = Guid.NewGuid(),
                ResourceId   = r.ResourceId,
                TaskId       = r.TaskId,
                TaskName     = r.TaskName,
                BucketStart  = r.BucketStart,
                BucketEnd    = r.BucketEnd,
                Value        = r.Value * 200,
                Unit         = AllocationUnit.Currency
            })
            .ToList();
    }

    private void BuildTargets()
    {
        _targets         = new();
        _currencyTargets = new();

        for (int res = 1; res <= 12; res++)
        {
            for (int wk = 0; wk < 8; wk++)
            {
                var start = _demoStart.AddDays(7 * wk);
                var end   = start.AddDays(7);
                _targets.Add(new AllocationTarget
                {
                    TargetId     = Guid.NewGuid(),
                    ResourceId   = res,
                    PeriodStart  = start,
                    PeriodEnd    = end,
                    TargetValue  = 40m          // 40h per week target
                });
                _currencyTargets.Add(new AllocationTarget
                {
                    TargetId     = Guid.NewGuid(),
                    ResourceId   = res,
                    PeriodStart  = start,
                    PeriodEnd    = end,
                    TargetValue  = 8000m        // $200/hr × 40h
                });
            }
        }
    }

    private void BuildDailyAllocations()
    {
        _dailyAllocations = new();
        var rangeEnd = _demoStart.AddDays(28); // 4 weeks

        var assignments = new (int ResId, int TaskId, string TaskName, decimal HoursPerDay)[]
        {
            (1,  101, "Backend API Development",    8m),
            (2,  101, "Backend API Development",    8m),
            (3,  103, "QA & Test Automation",       6m),
            (4,  108, "Project Coordination",        4m),
            (5,  102, "Frontend UI Build",           8m),
            (6,  101, "Backend API Development",    8m),
            (7,  105, "UX Research & Design",        6m),
            (8,  104, "Infrastructure & CI/CD",      7m),
            (9,  108, "Project Coordination",        5m),
            (10, 101, "Backend API Development",    8m),
        };

        foreach (var (resId, taskId, taskName, hours) in assignments)
        {
            for (var day = _demoStart; day < rangeEnd; day = day.AddDays(1))
            {
                if (day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday)
                    continue;

                _dailyAllocations.Add(new AllocationRecord
                {
                    AllocationId = Guid.NewGuid(),
                    ResourceId   = resId,
                    TaskId       = taskId,
                    TaskName     = taskName,
                    BucketStart  = day,
                    BucketEnd    = day.AddDays(1),
                    Value        = hours,
                    Unit         = AllocationUnit.Hours
                });
            }
        }
    }

    // ── Helper ───────────────────────────────────────────────────────────

    private static List<AllocationRecord> BuildWeeklyAllocations(
        int resourceId, int taskId, string taskName,
        DateTime weekStart, decimal[] hoursPerWeek)
    {
        var result = new List<AllocationRecord>();
        for (int i = 0; i < hoursPerWeek.Length; i++)
        {
            if (hoursPerWeek[i] == 0m) continue;
            var start = weekStart.AddDays(7 * i);
            result.Add(new AllocationRecord
            {
                AllocationId = Guid.NewGuid(),
                ResourceId   = resourceId,
                TaskId       = taskId,
                TaskName     = taskName,
                BucketStart  = start,
                BucketEnd    = start.AddDays(7),
                Value        = hoursPerWeek[i],
                Unit         = AllocationUnit.Hours
            });
        }
        return result;
    }

