@page "/components/allocation-scheduler"
@page "/components/allocation-scheduler/overview"
@layout ComponentDemoLayout
@using Marilo.Components.DataDisplay
@using Marilo.Core.Enums
@using Marilo.Core.Models
@using Marilo.Core.BusinessLogic.Enums

<PageSection Title="Overview">
    <DemoSection Title="Basic Resource Grid"
                 Description="Three resources with pre-populated allocations in read-only mode. Drag-fill and bulk edit are disabled."
                 Code="@_basicCode">
        <MariloAllocationScheduler TResource="StaffResource"
                                   Resources="@_basicResources"
                                   Allocations="@_basicAllocations"
                                   AuthoritativeLevel="TimeGranularity.Week"
                                   ViewGrain="TimeGranularity.Week"
                                   ValueMode="AllocationValueMode.Hours"
                                   VisibleStart="@_demoStart"
                                   DefaultRangeLength="2"
                                   DefaultRangeUnit="TimeGranularity.Month"
                                   AllowDragFill="false"
                                   AllowBulkEdit="false"
                                   Height="250px">
            <AllocationResourceColumns>
                <AllocationResourceColumn TResource="StaffResource" Field="Name" Title="Resource" Width="180px" />
                <AllocationResourceColumn TResource="StaffResource" Field="Role" Title="Role" Width="120px" />
            </AllocationResourceColumns>
        </MariloAllocationScheduler>
    </DemoSection>
</PageSection>

<PageSection Title="Editing">
    <DemoSection Title="Interactive Allocation"
                 Description="Drag-fill and keyboard editing enabled. OnCellEdited wired to capture changes."
                 Code="@_interactiveCode">
        <MariloAllocationScheduler TResource="StaffResource"
                                   Resources="@_basicResources"
                                   Allocations="@_interactiveAllocations"
                                   AuthoritativeLevel="TimeGranularity.Week"
                                   ViewGrain="TimeGranularity.Week"
                                   ValueMode="AllocationValueMode.Hours"
                                   VisibleStart="@_demoStart"
                                   DefaultRangeLength="2"
                                   DefaultRangeUnit="TimeGranularity.Month"
                                   AllowDragFill="true"
                                   AllowKeyboardEdit="true"
                                   OnCellEdited="@HandleCellEdited"
                                   Height="250px">
            <AllocationResourceColumns>
                <AllocationResourceColumn TResource="StaffResource" Field="Name" Title="Resource" Width="180px" />
                <AllocationResourceColumn TResource="StaffResource" Field="Role" Title="Role" Width="120px" />
            </AllocationResourceColumns>
        </MariloAllocationScheduler>

        @if (!string.IsNullOrEmpty(_lastEditMessage))
        {
            <p><strong>Last edit:</strong> @_lastEditMessage</p>
        }
    </DemoSection>
</PageSection>

<PageSection Title="Conflict Detection">
    <DemoSection Title="Overlapping Allocations"
                 Description="When two tasks allocate the same resource in the same time bucket, the cell receives conflict styling."
                 Code="@_conflictCode">
        <MariloAllocationScheduler TResource="StaffResource"
                                   Resources="@_conflictResources"
                                   Allocations="@_conflictAllocations"
                                   AuthoritativeLevel="TimeGranularity.Week"
                                   ViewGrain="TimeGranularity.Week"
                                   ValueMode="AllocationValueMode.Hours"
                                   VisibleStart="@_demoStart"
                                   DefaultRangeLength="1"
                                   DefaultRangeUnit="TimeGranularity.Month"
                                   Height="200px">
            <AllocationResourceColumns>
                <AllocationResourceColumn TResource="StaffResource" Field="Name" Title="Resource" Width="180px" />
            </AllocationResourceColumns>
        </MariloAllocationScheduler>
    </DemoSection>
</PageSection>

<PageSection Title="Resource Columns">
    <DemoSection Title="Grouped Resources"
                 Description="Resources grouped by department using multiple resource columns."
                 Code="@_groupedCode">
        <MariloAllocationScheduler TResource="StaffResource"
                                   Resources="@_groupedResources"
                                   Allocations="@_basicAllocations"
                                   AuthoritativeLevel="TimeGranularity.Week"
                                   ViewGrain="TimeGranularity.Week"
                                   ValueMode="AllocationValueMode.Hours"
                                   VisibleStart="@_demoStart"
                                   DefaultRangeLength="1"
                                   DefaultRangeUnit="TimeGranularity.Month"
                                   Height="300px">
            <AllocationResourceColumns>
                <AllocationResourceColumn TResource="StaffResource" Field="Name" Title="Resource" Width="180px" />
                <AllocationResourceColumn TResource="StaffResource" Field="Department" Title="Dept" Width="120px" />
                <AllocationResourceColumn TResource="StaffResource" Field="Role" Title="Role" Width="100px" />
            </AllocationResourceColumns>
        </MariloAllocationScheduler>
    </DemoSection>

    <DemoSection Title="Custom Column Template"
                 Description="Use a column-level Template RenderFragment for custom cell rendering with avatars."
                 Code="@_templateCode">
        <MariloAllocationScheduler TResource="StaffResource"
                                   Resources="@_basicResources"
                                   Allocations="@_basicAllocations"
                                   AuthoritativeLevel="TimeGranularity.Week"
                                   ViewGrain="TimeGranularity.Week"
                                   ValueMode="AllocationValueMode.Hours"
                                   VisibleStart="@_demoStart"
                                   DefaultRangeLength="1"
                                   DefaultRangeUnit="TimeGranularity.Month"
                                   Height="200px">
            <AllocationResourceColumns>
                <AllocationResourceColumn TResource="StaffResource" Field="Name" Title="Resource" Width="200px">
                    <Template>
                        <div style="display:flex;align-items:center;gap:0.5rem">
                            <span style="width:24px;height:24px;border-radius:50%;background:#0f6cbd;color:white;display:flex;align-items:center;justify-content:center;font-size:0.7rem">
                                @context.Name[0]
                            </span>
                            <span>@context.Name</span>
                        </div>
                    </Template>
                </AllocationResourceColumn>
            </AllocationResourceColumns>
        </MariloAllocationScheduler>
    </DemoSection>
</PageSection>

<PageSection Title="Day Granularity">
    <DemoSection Title="Disabled Slots"
                 Description="Switch to daily granularity. Weekends and holidays render as disabled (non-editable) time slots."
                 Code="@_disabledCode">
        <MariloAllocationScheduler TResource="StaffResource"
                                   Resources="@_basicResources"
                                   Allocations="@_basicAllocations"
                                   AuthoritativeLevel="TimeGranularity.Day"
                                   ViewGrain="TimeGranularity.Day"
                                   ValueMode="AllocationValueMode.Hours"
                                   VisibleStart="@_demoStart"
                                   DefaultRangeLength="14"
                                   DefaultRangeUnit="TimeGranularity.Day"
                                   Height="200px">
            <AllocationResourceColumns>
                <AllocationResourceColumn TResource="StaffResource" Field="Name" Title="Resource" Width="180px" />
            </AllocationResourceColumns>
        </MariloAllocationScheduler>
    </DemoSection>
</PageSection>

