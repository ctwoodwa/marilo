    private async Task HandleCellEdited(CellEditedArgs args)
    {
        _lastEditMessage = $"Resource {args.ResourceKey}, {args.BucketStart:MMM d} - {args.BucketEnd:MMM d}: {args.OldValue}h -> {args.NewValue}h";
        await Task.CompletedTask;
    }

    // ── Models ──────────────────────────────────────────────────────────

    public class StaffResource
    {
        public int    Id         { get; set; }
        public string Name       { get; set; } = string.Empty;
        public string Role       { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
    }

    // ── Code Snippets ───────────────────────────────────────────────────

    private const string _basicCode =
        "<MariloAllocationScheduler TResource=\"StaffResource\"\n" +
