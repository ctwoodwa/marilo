@page "/components/search-box"

<div class="demo-page">
    <h1>Search Box</h1>
    <p class="demo-page-desc">The search box provides a text input optimized for search queries, with a built-in search icon and clear button.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Forms.Inputs.MariloSearchBox.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloSearchBox Value="@_search" ValueChanged="@(v => _search = v)" Placeholder="Search..." />
        @if (!string.IsNullOrEmpty(_search))
        {
            <p><strong>Search term:</strong> @_search</p>
        }
    </DemoSection>

    <DemoSection Title="With Keyboard Hint" Code="@_kbdCode">
        <MariloSearchBox Value="@_search" ValueChanged="@(v => _search = v)" Placeholder="Search..." KbdHint="/" />
    </DemoSection>
</div>

@code {
    private string _search = "";

    private const string _basicCode =
        "<MariloSearchBox Value=\"@_search\" ValueChanged=\"@(v => _search = v)\" Placeholder=\"Search...\" />\n" +
        "@if (!string.IsNullOrEmpty(_search))\n" +
        "{\n" +
        "    <p><strong>Search term:</strong> @_search</p>\n" +
        "}\n\n" +
        "@code {\n" +
        "    private string _search = \"\";\n" +
        "}";

    private const string _kbdCode =
        "<MariloSearchBox Value=\"@_search\" ValueChanged=\"@(v => _search = v)\" Placeholder=\"Search...\" KbdHint=\"/\" />";
}
