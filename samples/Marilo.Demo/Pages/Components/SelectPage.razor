@page "/components/select"

<div class="demo-page">
    <h1>Select</h1>
    <p class="demo-page-desc">The select component lets users choose a single value from a dropdown list.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Forms.Inputs.MariloSelect.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloField>
            <MariloLabel>Framework</MariloLabel>
            <MariloSelect Value="@_selected" ValueChanged="@(v => _selected = v)">
                <option value="">Choose...</option>
                <option value="fluent">Fluent UI</option>
                <option value="bootstrap">Bootstrap</option>
                <option value="tailwind">Tailwind</option>
            </MariloSelect>
        </MariloField>
    </DemoSection>
</div>

@code {
    private string _selected = "";

    private const string _basicCode =
        "<MariloSelect Value=\"@_selected\" ValueChanged=\"@(v => _selected = v)\">\n" +
        "    <option value=\"\">Choose...</option>\n" +
        "    <option value=\"fluent\">Fluent UI</option>\n" +
        "    <option value=\"bootstrap\">Bootstrap</option>\n" +
        "    <option value=\"tailwind\">Tailwind</option>\n" +
        "</MariloSelect>";
}
