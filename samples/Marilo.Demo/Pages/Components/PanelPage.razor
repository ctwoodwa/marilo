@page "/components/panel"

<div class="demo-page">
    <h1>Panel</h1>
    <p class="demo-page-desc">Panels provide a contained surface with elevation for grouping related content.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Layout.MariloPanel.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloPanel>
            <p>This content is displayed inside a panel with elevation and padding.</p>
        </MariloPanel>
    </DemoSection>
</div>

@code {
    private const string _basicCode =
        "<MariloPanel>\n" +
        "    <p>This content is displayed inside a panel with elevation and padding.</p>\n" +
        "</MariloPanel>";
}
