@page "/components/card"

<div class="demo-page">
    <h1>Card</h1>
    <p class="demo-page-desc">Cards contain content and actions about a single subject, grouping related information together.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.DataDisplay.MariloCard.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <div class="demo-card-grid">
            @for (var i = 1; i <= 3; i++)
            {
                var idx = i;
                <MariloCard>
                    <MariloCardHeader>Card @idx</MariloCardHeader>
                    <MariloCardBody>Card body content for item @idx. This shows the basic card structure.</MariloCardBody>
                    <MariloCardActions>
                        <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Action</MariloButton>
                    </MariloCardActions>
                </MariloCard>
            }
        </div>
    </DemoSection>
</div>

@code {
    private const string _basicCode =
        "<MariloCard>\n" +
        "    <MariloCardHeader>Title</MariloCardHeader>\n" +
        "    <MariloCardBody>Card body content.</MariloCardBody>\n" +
        "    <MariloCardActions>\n" +
        "        <MariloButton Variant=\"ButtonVariant.Primary\" Size=\"ButtonSize.Small\">Action</MariloButton>\n" +
        "    </MariloCardActions>\n" +
        "</MariloCard>";
}
