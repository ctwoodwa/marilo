@page "/components/Badge"
@page "/components/Badge/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Description="Badges display short labels or counts." Code="@_basicCode">
        <div class="demo-row">
            <MariloBadge>Default</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Primary">Primary</MariloBadge>
        </div>
    </DemoSection>

    <DemoSection Title="Notification Dot" Description="Omit child content to render a small dot badge — useful for unread indicators." Code="@_dotCode">
        <div class="demo-row">
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Inbox</MariloButton>
                <MariloBadge Variant="BadgeVariant.Danger" Position="edge" />
            </div>
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Messages</MariloButton>
                <MariloBadge Variant="BadgeVariant.Primary" Position="edge">4</MariloBadge>
            </div>
        </div>
    </DemoSection>
</PageSection>

<PageSection Title="Appearance">
    <DemoSection Title="Variants" Description="Badges support multiple color variants to convey meaning." Code="@_variantsCode">
        <div class="demo-row">
            <MariloBadge Variant="BadgeVariant.Default">Default</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Primary">Primary</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Secondary">Secondary</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Danger">Danger</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Warning">Warning</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Info">Info</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Success">Success</MariloBadge>
        </div>
    </DemoSection>

    <DemoSection Title="Position" Description="Control where the badge is anchored relative to its parent using the Position parameter." Code="@_positionCode">
        <div class="demo-row">
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Edge (default)</MariloButton>
                <MariloBadge Variant="BadgeVariant.Danger" Position="edge">3</MariloBadge>
            </div>
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Inline</MariloButton>
                <MariloBadge Variant="BadgeVariant.Primary" Position="inline">5</MariloBadge>
            </div>
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Inside</MariloButton>
                <MariloBadge Variant="BadgeVariant.Success" Position="inside">7</MariloBadge>
            </div>
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Outside</MariloButton>
                <MariloBadge Variant="BadgeVariant.Warning" Position="outside">2</MariloBadge>
            </div>
        </div>
    </DemoSection>

    <DemoSection Title="Horizontal Alignment" Description="Adjust the badge's horizontal anchor point with HorizontalAlign." Code="@_hAlignCode">
        <div class="demo-row">
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Start</MariloButton>
                <MariloBadge Variant="BadgeVariant.Primary" HorizontalAlign="start">New</MariloBadge>
            </div>
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">End (default)</MariloButton>
                <MariloBadge Variant="BadgeVariant.Primary" HorizontalAlign="end">New</MariloBadge>
            </div>
        </div>
    </DemoSection>

    <DemoSection Title="Vertical Alignment" Description="Adjust the badge's vertical anchor point with VerticalAlign." Code="@_vAlignCode">
        <div class="demo-row">
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Top (default)</MariloButton>
                <MariloBadge Variant="BadgeVariant.Danger" VerticalAlign="top">!</MariloBadge>
            </div>
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Bottom</MariloButton>
                <MariloBadge Variant="BadgeVariant.Danger" VerticalAlign="bottom">!</MariloBadge>
            </div>
        </div>
    </DemoSection>

    <DemoSection Title="Cutout Border" Description="ShowCutoutBorder adds a ring around the badge to visually separate it from the element underneath." Code="@_cutoutCode">
        <div class="demo-row">
            <div style="position:relative;display:inline-flex;background:#1565c0;padding:8px;border-radius:4px;">
                <span style="color:#fff;font-size:1.5em;">🔔</span>
                <MariloBadge Variant="BadgeVariant.Danger" ShowCutoutBorder="true">3</MariloBadge>
            </div>
        </div>
    </DemoSection>

    <DemoSection Title="Visibility Toggle" Description="Control badge visibility dynamically with the Visible parameter." Code="@_visibleCode">
        <div class="demo-row">
            <div style="position:relative;display:inline-flex;">
                <MariloButton Variant="ButtonVariant.Secondary">Notifications</MariloButton>
                <MariloBadge Variant="BadgeVariant.Danger" Visible="@_badgeVisible">9</MariloBadge>
            </div>
            <MariloButton Size="ButtonSize.Small" Variant="ButtonVariant.Secondary"
                          OnClick="@(() => _badgeVisible = !_badgeVisible)">
                @(_badgeVisible ? "Hide Badge" : "Show Badge")
            </MariloButton>
        </div>
    </DemoSection>
</PageSection>

<PageSection Title="Accessibility">
    <AccessibilityInfo
        KeyboardInteractions="@_keyboard"
        AriaAttributes="@_aria"
        ScreenReaderNotes="@_screenReader" />
</PageSection>

@code {
    private bool _badgeVisible = true;

    // Overview
    private const string _basicCode =
        "<MariloBadge>Default</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Primary\">Primary</MariloBadge>";

    private const string _dotCode =
        "<div style=\"position:relative;display:inline-flex;\">\n" +
        "    <MariloButton>Inbox</MariloButton>\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Danger\" Position=\"edge\" />\n" +
        "</div>\n" +
        "<div style=\"position:relative;display:inline-flex;\">\n" +
        "    <MariloButton>Messages</MariloButton>\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Primary\" Position=\"edge\">4</MariloBadge>\n" +
        "</div>";

    // Appearance
    private const string _variantsCode =
        "<MariloBadge Variant=\"BadgeVariant.Default\">Default</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Primary\">Primary</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Secondary\">Secondary</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Danger\">Danger</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Warning\">Warning</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Info\">Info</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Success\">Success</MariloBadge>";

    private const string _positionCode =
        "<MariloBadge Variant=\"BadgeVariant.Danger\" Position=\"edge\">3</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Primary\" Position=\"inline\">5</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Success\" Position=\"inside\">7</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Warning\" Position=\"outside\">2</MariloBadge>";

    private const string _hAlignCode =
        "<MariloBadge Variant=\"BadgeVariant.Primary\" HorizontalAlign=\"start\">New</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Primary\" HorizontalAlign=\"end\">New</MariloBadge>";

    private const string _vAlignCode =
        "<MariloBadge Variant=\"BadgeVariant.Danger\" VerticalAlign=\"top\">!</MariloBadge>\n" +
        "<MariloBadge Variant=\"BadgeVariant.Danger\" VerticalAlign=\"bottom\">!</MariloBadge>";

    private const string _cutoutCode =
        "<MariloBadge Variant=\"BadgeVariant.Danger\" ShowCutoutBorder=\"true\">3</MariloBadge>";

    private const string _visibleCode =
        "<MariloBadge Variant=\"BadgeVariant.Danger\" Visible=\"@_badgeVisible\">9</MariloBadge>\n" +
        "<MariloButton OnClick=\"@(() => _badgeVisible = !_badgeVisible)\">\n" +
        "    @(_badgeVisible ? \"Hide\" : \"Show\")\n" +
        "</MariloButton>\n\n" +
        "@code { private bool _badgeVisible = true; }";

    // Accessibility
    private static readonly (string Key, string Action)[] _keyboard =
    [
        ("Tab", "Badges are not typically focusable unless they are interactive"),
    ];

    private static readonly (string Attribute, string Description)[] _aria =
    [
        ("aria-label", "Provides an accessible description for the badge count or label"),
        ("role=\"status\"", "Applied for badges that display live-updating information"),
    ];

    private static readonly string[] _screenReader =
    [
        "Badges with counts should include an aria-label describing the count context (e.g., \"3 unread messages\").",
        "Live-updating badges use role=\"status\" so changes are announced automatically.",
        "Decorative badges that duplicate visible text can use aria-hidden=\"true\".",
    ];
}
