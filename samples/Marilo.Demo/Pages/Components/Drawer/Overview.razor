@page "/components/Drawer"
@page "/components/Drawer/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloButton OnClick="OpenDrawer">Open Drawer</MariloButton>
        <MariloDrawer IsOpen="@_drawerOpen" OnClose="CloseDrawer" Position="DrawerPosition.Right" Width="360px">
            <h3>Drawer Content</h3>
            <p>This is supplementary content displayed inside the drawer panel.</p>
            <MariloButton OnClick="CloseDrawer">Close</MariloButton>
        </MariloDrawer>
    </DemoSection>
</PageSection>

<PageSection Title="Appearance">
    <DemoSection Title="Positions" Description="Drawers can slide in from different edges of the viewport." Code="@_positionCode">
        <div class="demo-row">
            <MariloButton OnClick="@(() => OpenPositionDrawer(DrawerPosition.Left))">Left</MariloButton>
            <MariloButton OnClick="@(() => OpenPositionDrawer(DrawerPosition.Right))">Right</MariloButton>
        </div>
        <MariloDrawer IsOpen="@_posDrawerOpen" OnClose="@(() => _posDrawerOpen = false)" Position="@_drawerPosition" Width="300px">
            <h3>@_drawerPosition Drawer</h3>
            <p>This drawer slides in from the @_drawerPosition.ToString().ToLower().</p>
            <MariloButton OnClick="@(() => _posDrawerOpen = false)">Close</MariloButton>
        </MariloDrawer>
    </DemoSection>

    <DemoSection Title="Custom Width" Description="Set a custom width for the drawer panel." Code="@_widthCode">
        <MariloButton OnClick="@(() => _wideDrawerOpen = true)">Open Wide Drawer</MariloButton>
        <MariloDrawer IsOpen="@_wideDrawerOpen" OnClose="@(() => _wideDrawerOpen = false)" Position="DrawerPosition.Right" Width="500px">
            <h3>Wide Drawer</h3>
            <p>This drawer has a custom width of 500px.</p>
            <MariloButton OnClick="@(() => _wideDrawerOpen = false)">Close</MariloButton>
        </MariloDrawer>
    </DemoSection>
</PageSection>

<PageSection Title="Events">
    <DemoSection Title="OnClose" Description="Handle drawer close events with the OnClose callback." Code="@_eventCode">
        <MariloButton OnClick="@(() => _evDrawerOpen = true)">Open Drawer</MariloButton>
        <MariloDrawer IsOpen="@_evDrawerOpen" OnClose="@OnDrawerClose" Position="DrawerPosition.Right" Width="360px">
            <h3>Event Drawer</h3>
            <p>Close this drawer to see the event fire.</p>
            <MariloButton OnClick="@(() => _evDrawerOpen = false)">Close</MariloButton>
        </MariloDrawer>
        <p>Drawer open: @_evDrawerOpen</p>
    </DemoSection>
</PageSection>

<PageSection Title="Accessibility">
    <AccessibilityInfo
        KeyboardInteractions="@_keyboard"
        AriaAttributes="@_aria"
        ScreenReaderNotes="@_screenReader" />
</PageSection>

@code {
    private bool _drawerOpen;
    private bool _posDrawerOpen;
    private DrawerPosition _drawerPosition = DrawerPosition.Right;
    private bool _wideDrawerOpen;
    private bool _evDrawerOpen;

    private void OpenDrawer() => _drawerOpen = true;
    private void CloseDrawer() => _drawerOpen = false;

    private void OpenPositionDrawer(DrawerPosition position)
    {
        _drawerPosition = position;
        _posDrawerOpen = true;
    }

    private void OnDrawerClose()
    {
        _evDrawerOpen = false;
    }

    private const string _basicCode =
        "<MariloButton OnClick=\"@(() => _drawerOpen = true)\">Open Drawer</MariloButton>\n" +
        "<MariloDrawer IsOpen=\"@_drawerOpen\" OnClose=\"@(() => _drawerOpen = false)\" Position=\"DrawerPosition.Right\" Width=\"360px\">\n" +
        "    <h3>Drawer Content</h3>\n" +
        "    <p>This is supplementary content displayed inside the drawer panel.</p>\n" +
        "    <MariloButton OnClick=\"@(() => _drawerOpen = false)\">Close</MariloButton>\n" +
        "</MariloDrawer>\n\n" +
        "@code {\n" +
        "    private bool _drawerOpen;\n" +
        "}";

    private const string _positionCode =
        "<MariloButton OnClick=\"@(() => OpenDrawer(DrawerPosition.Left))\">Left</MariloButton>\n" +
        "<MariloButton OnClick=\"@(() => OpenDrawer(DrawerPosition.Right))\">Right</MariloButton>\n" +
        "<MariloDrawer IsOpen=\"@_isOpen\" OnClose=\"@(() => _isOpen = false)\" Position=\"@_position\" Width=\"300px\">\n" +
        "    <h3>Drawer Content</h3>\n" +
        "    <MariloButton OnClick=\"@(() => _isOpen = false)\">Close</MariloButton>\n" +
        "</MariloDrawer>";

    private const string _widthCode =
        "<MariloButton OnClick=\"@(() => _isOpen = true)\">Open Wide Drawer</MariloButton>\n" +
        "<MariloDrawer IsOpen=\"@_isOpen\" OnClose=\"@(() => _isOpen = false)\" Position=\"DrawerPosition.Right\" Width=\"500px\">\n" +
        "    <h3>Wide Drawer</h3>\n" +
        "    <p>This drawer has a custom width of 500px.</p>\n" +
        "    <MariloButton OnClick=\"@(() => _isOpen = false)\">Close</MariloButton>\n" +
        "</MariloDrawer>";

    private const string _eventCode =
        "<MariloButton OnClick=\"@(() => _drawerOpen = true)\">Open Drawer</MariloButton>\n" +
        "<MariloDrawer IsOpen=\"@_drawerOpen\" OnClose=\"@OnDrawerClose\" Position=\"DrawerPosition.Right\" Width=\"360px\">\n" +
        "    <h3>Event Drawer</h3>\n" +
        "    <MariloButton OnClick=\"@(() => _drawerOpen = false)\">Close</MariloButton>\n" +
        "</MariloDrawer>\n" +
        "<p>Drawer open: @_drawerOpen</p>\n\n" +
        "@code {\n" +
        "    private bool _drawerOpen;\n" +
        "    private void OnDrawerClose() => _drawerOpen = false;\n" +
        "}";

    private static readonly (string Key, string Action)[] _keyboard =
    [
        ("Escape", "Closes the drawer"),
        ("Tab", "Moves focus through interactive elements within the drawer (focus is trapped)"),
        ("Shift + Tab", "Moves focus to the previous interactive element within the drawer"),
    ];

    private static readonly (string Attribute, string Description)[] _aria =
    [
        ("role=\"dialog\"", "Applied when the drawer overlays content and requires user interaction"),
        ("role=\"complementary\"", "Applied when the drawer provides supplementary content alongside the main content"),
        ("aria-modal=\"true\"", "Indicates that the drawer traps focus and blocks interaction with the page behind it"),
        ("aria-label", "Provides an accessible name for the drawer"),
        ("aria-hidden=\"true\"", "Applied to the drawer when it is closed to hide it from screen readers"),
    ];

    private static readonly string[] _screenReader =
    [
        "When opened, the drawer is announced as a dialog or complementary region depending on its role.",
        "Focus is trapped within the drawer when aria-modal is true, preventing interaction with background content.",
        "Pressing Escape closes the drawer and returns focus to the element that triggered it.",
    ];
}
