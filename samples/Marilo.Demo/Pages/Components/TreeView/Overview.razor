        "                @bind-CheckedItems=\"_checkedIds\" />\n" +
        "<p>Checked IDs: @(string.Join(\", \", _checkedIds ?? []))</p>";

    private const string _checkboxSingleCode =
        "<MariloTreeView Data=\"@_data\"\n" +
        "                IdField=\"Id\"\n" +
        "                ParentIdField=\"ParentId\"\n" +
        "                TextField=\"Name\"\n" +
        "                CheckBoxMode=\"CheckBoxMode.Single\"\n" +
        "                @bind-CheckedItems=\"_singleCheckedIds\" />\n" +
        "<p>Checked ID: @(string.Join(\", \", _singleCheckedIds ?? []))</p>";

    private const string _noCascadeCode =
        "<MariloTreeView Data=\"@_data\"\n" +
        "                IdField=\"Id\"\n" +
        "                ParentIdField=\"ParentId\"\n" +
        "                TextField=\"Name\"\n" +
        "                CheckBoxMode=\"CheckBoxMode.Multiple\"\n" +
        "                AllowCheckChildren=\"false\"\n" +
        "                AllowCheckParents=\"false\"\n" +
        "                @bind-CheckedItems=\"_checkedIds\" />";

    private const string _checkedEventCode =
        "<MariloTreeView Data=\"@_data\"\n" +
        "                CheckBoxMode=\"CheckBoxMode.Multiple\"\n" +
        "                CheckedItems=\"_checkedIds\"\n" +
        "                CheckedItemsChanged=\"OnCheckedChanged\" />\n\n" +
