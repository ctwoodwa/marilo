        "        <MariloTreeItem Title=\"Reports\">\n" +
        "            <MariloTreeItem Title=\"Q1\" />\n" +
        "            <MariloTreeItem Title=\"Q2\" />\n" +
        "        </MariloTreeItem>\n" +
        "        <MariloTreeItem Title=\"Images\" />\n" +
        "    </MariloTreeItem>\n" +
        "    <MariloTreeItem Title=\"Downloads\" />\n" +
        "    <MariloTreeItem Title=\"Desktop\" />\n" +
        "</MariloTreeView>";
}
