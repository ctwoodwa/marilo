        "    <MariloTreeItem Title=\"Option A\" />\n" +
        "    <MariloTreeItem Title=\"Option B\" />\n" +
        "    <MariloTreeItem Title=\"Option C\" />\n" +
        "</MariloTreeView>";

    private const string _selectedItemsChangedCode =
        "<MariloTreeView Data=\"@_data\"\n" +
        "                IdField=\"Id\"\n" +
        "                ParentIdField=\"ParentId\"\n" +
        "                TextField=\"Name\"\n" +
        "                SelectionMode=\"TreeSelectionMode.Single\"\n" +
        "                SelectedItems=\"_selectedIds\"\n" +
