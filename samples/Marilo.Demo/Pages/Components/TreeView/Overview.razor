        "    {\n" +
        "        _selectedIds = ids;\n" +
        "        // react to selection change\n" +
        "    }\n" +
        "}";

    private const string _onItemClickCode =
        "<MariloTreeView Data=\"@_data\"\n" +
        "                IdField=\"Id\"\n" +
        "                ParentIdField=\"ParentId\"\n" +
        "                TextField=\"Name\"\n" +
        "                OnItemClick=\"OnClicked\" />\n\n" +
        "@code {\n" +
        "    void OnClicked(object item)\n" +
        "    {\n" +
        "        var node = (MyNode)item;\n" +
        "        Console.WriteLine($\"Clicked: {node.Name}\");\n" +
        "    }\n" +
        "}";

    private const string _expandedItemsChangedCode =
        "<MariloTreeView ExpandedItems=\"_expandedIds\"\n" +
        "                ExpandedItemsChanged=\"OnExpandedChanged\">\n" +
        "    <MariloTreeItem Title=\"Folder A\">\n" +
