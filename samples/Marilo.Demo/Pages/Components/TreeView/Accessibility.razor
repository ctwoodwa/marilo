@page "/components/tree-view/accessibility"
@layout ComponentDemoLayout

<AccessibilityInfo
    KeyboardInteractions="@_keyboard"
    AriaAttributes="@_aria"
    ScreenReaderNotes="@_screenReader" />

@code {
    private static readonly (string Key, string Action)[] _keyboard =
    [
        ("Up Arrow", "Moves focus to the previous visible tree item"),
        ("Down Arrow", "Moves focus to the next visible tree item"),
        ("Right Arrow", "Expands a collapsed item, or moves focus to the first child"),
        ("Left Arrow", "Collapses an expanded item, or moves focus to the parent"),
        ("Enter", "Activates or selects the focused tree item"),
        ("Space", "Toggles selection of the focused tree item"),
        ("Home", "Moves focus to the first tree item"),
        ("End", "Moves focus to the last visible tree item"),
    ];

    private static readonly (string Attribute, string Description)[] _aria =
    [
        ("role=\"tree\"", "Applied to the tree view container to identify it as a tree widget"),
        ("role=\"treeitem\"", "Applied to each tree item within the tree"),
        ("aria-expanded=\"true/false\"", "Indicates whether a parent tree item is expanded or collapsed"),
        ("aria-selected=\"true/false\"", "Indicates whether a tree item is selected"),
        ("aria-level", "Indicates the nesting level of the tree item"),
    ];

    private static readonly string[] _screenReader =
    [
        "The tree view is announced with its role and accessible name when focus enters it.",
        "Each tree item announces its title, level, position in set, and expanded/collapsed state.",
        "Arrow keys navigate between visible items while respecting the hierarchical structure.",
        "Expanding or collapsing an item announces the new state to the screen reader.",
    ];
}
