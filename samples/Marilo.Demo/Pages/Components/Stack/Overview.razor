@page "/components/Stack"
@page "/components/Stack/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Horizontal" Code="@_horizontalCode">
        <MariloStack VerticalAlign="StackAlignment.Center">
            <MariloBadge Variant="BadgeVariant.Primary">Primary</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Secondary">Secondary</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Success">Success</MariloBadge>
        </MariloStack>
    </DemoSection>

    <DemoSection Title="Vertical" Code="@_verticalCode">
        <MariloStack Orientation="StackDirection.Vertical">
            <MariloButton Size="ButtonSize.Small">Button 1</MariloButton>
            <MariloButton Size="ButtonSize.Small">Button 2</MariloButton>
            <MariloButton Size="ButtonSize.Small">Button 3</MariloButton>
        </MariloStack>
    </DemoSection>
</PageSection>

<PageSection Title="Appearance">
    <DemoSection Title="Spacing" Description="Control the gap between stack items with the Spacing parameter." Code="@_spacingCode">
        <MariloStack Spacing="24px">
            <MariloBadge Variant="BadgeVariant.Primary">Item 1</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Secondary">Item 2</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Success">Item 3</MariloBadge>
        </MariloStack>
    </DemoSection>

    <DemoSection Title="Alignment" Description="Align items along the cross axis." Code="@_alignmentCode">
        <MariloStack VerticalAlign="StackAlignment.Start" Style="height:80px;background:var(--marilo-color-surface);">
            <MariloBadge Variant="BadgeVariant.Primary">Start</MariloBadge>
        </MariloStack>
        <MariloStack VerticalAlign="StackAlignment.Center" Style="height:80px;background:var(--marilo-color-surface);">
            <MariloBadge Variant="BadgeVariant.Primary">Center</MariloBadge>
        </MariloStack>
        <MariloStack VerticalAlign="StackAlignment.End" Style="height:80px;background:var(--marilo-color-surface);">
            <MariloBadge Variant="BadgeVariant.Primary">End</MariloBadge>
        </MariloStack>
    </DemoSection>
</PageSection>

<PageSection Title="Accessibility">
    <AccessibilityInfo
        KeyboardInteractions="@_keyboard"
        AriaAttributes="@_aria"
        ScreenReaderNotes="@_screenReader" />
</PageSection>

@code {
    private const string _horizontalCode =
        "<MariloStack VerticalAlign=\"StackAlignment.Center\">\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Primary\">Primary</MariloBadge>\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Secondary\">Secondary</MariloBadge>\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Success\">Success</MariloBadge>\n" +
        "</MariloStack>";

    private const string _verticalCode =
        "<MariloStack Orientation=\"StackDirection.Vertical\">\n" +
        "    <MariloButton Size=\"ButtonSize.Small\">Button 1</MariloButton>\n" +
        "    <MariloButton Size=\"ButtonSize.Small\">Button 2</MariloButton>\n" +
        "    <MariloButton Size=\"ButtonSize.Small\">Button 3</MariloButton>\n" +
        "</MariloStack>";

    private const string _spacingCode =
        "<MariloStack Spacing=\"24px\">\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Primary\">Item 1</MariloBadge>\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Secondary\">Item 2</MariloBadge>\n" +
        "    <MariloBadge Variant=\"BadgeVariant.Success\">Item 3</MariloBadge>\n" +
        "</MariloStack>";

    private const string _alignmentCode =
        "<MariloStack VerticalAlign=\"StackAlignment.Start\">\n" +
        "    <MariloBadge>Start</MariloBadge>\n" +
        "</MariloStack>\n" +
        "<MariloStack VerticalAlign=\"StackAlignment.Center\">\n" +
        "    <MariloBadge>Center</MariloBadge>\n" +
        "</MariloStack>\n" +
        "<MariloStack VerticalAlign=\"StackAlignment.End\">\n" +
        "    <MariloBadge>End</MariloBadge>\n" +
        "</MariloStack>";

    private static readonly (string Key, string Action)[] _keyboard =
    [
        ("Tab", "Moves focus through interactive items within the stack"),
    ];

    private static readonly (string Attribute, string Description)[] _aria =
    [
        ("role=\"group\"", "Use when the stack contains related items that should be grouped semantically"),
        ("aria-label", "Provides an accessible name for the group when role=\"group\" is applied"),
    ];

    private static readonly string[] _screenReader =
    [
        "Use role=\"group\" to associate related items so screen readers announce them as a group.",
        "Content within the stack is read in document order regardless of visual direction.",
        "Provide an aria-label when using role=\"group\" to describe the purpose of the grouped items.",
    ];
}
