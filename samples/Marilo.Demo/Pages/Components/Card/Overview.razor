        "        <MariloButton Variant=\"ButtonVariant.Primary\" Size=\"ButtonSize.Small\">Open</MariloButton>\n" +
        "        <MariloButton Variant=\"ButtonVariant.Secondary\" Size=\"ButtonSize.Small\">Archive</MariloButton>\n" +
        "    </MariloCardActions>\n" +
        "</MariloCard>";

    // Appearance
    private const string _horizontalCode =
        "<MariloCard Orientation=\"horizontal\" Width=\"480px\">\n" +
        "    <MariloCardBody>Horizontal content.</MariloCardBody>\n" +
        "    <MariloCardActions>\n" +
        "        <MariloButton Size=\"ButtonSize.Small\">View</MariloButton>\n" +
