@page "/components/Card"
@page "/components/Card/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <div class="demo-card-grid">
            @for (var i = 1; i <= 3; i++)
            {
                var idx = i;
                <MariloCard>
                    <MariloCardHeader>Card @idx</MariloCardHeader>
                    <MariloCardBody>Card body content for item @idx. This shows the basic card structure.</MariloCardBody>
                    <MariloCardActions>
                        <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Action</MariloButton>
                    </MariloCardActions>
                </MariloCard>
            }
        </div>
    </DemoSection>

    <DemoSection Title="Full Structure" Description="A card can include a header, body, footer, and actions using the dedicated building-block components." Code="@_fullCode">
        <MariloCard Width="360px">
            <MariloCardHeader>Project Alpha</MariloCardHeader>
            <MariloCardBody>
                <p>This card shows the complete building-block structure: header, body, footer, and actions.</p>
            </MariloCardBody>
            <MariloCardFooter>Last updated: April 2026</MariloCardFooter>
            <MariloCardActions>
                <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Open</MariloButton>
                <MariloButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Archive</MariloButton>
            </MariloCardActions>
        </MariloCard>
    </DemoSection>
</PageSection>

<PageSection Title="Appearance">
    <DemoSection Title="Horizontal Orientation" Description="Set Orientation to horizontal to lay the card content side by side." Code="@_horizontalCode">
        <MariloCard Orientation="horizontal" Width="480px">
            <MariloCardBody>
                <strong>Horizontal Card</strong>
                <p>Content flows horizontally instead of stacking vertically. Useful for media + text layouts.</p>
            </MariloCardBody>
            <MariloCardActions>
                <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">View</MariloButton>
            </MariloCardActions>
        </MariloCard>
    </DemoSection>

    <DemoSection Title="Fixed Dimensions" Description="Control card size with the Width and Height parameters." Code="@_dimensionsCode">
        <div class="demo-row">
            <MariloCard Width="200px" Height="180px">
                <MariloCardHeader>Small</MariloCardHeader>
                <MariloCardBody>Fixed 200×180px card.</MariloCardBody>
            </MariloCard>
            <MariloCard Width="320px" Height="180px">
                <MariloCardHeader>Wide</MariloCardHeader>
                <MariloCardBody>Fixed 320×180px card with the same height.</MariloCardBody>
            </MariloCard>
        </div>
    </DemoSection>

    <DemoSection Title="Card with Image" Description="Use MariloCardImage to include an image at the top of the card." Code="@_imageCode">
        <div class="demo-row">
            <MariloCard Width="220px">
                <MariloCardImage Src="https://picsum.photos/220/120?grayscale" Alt="Landscape" />
                <MariloCardHeader>Nature</MariloCardHeader>
                <MariloCardBody>A landscape photograph.</MariloCardBody>
                <MariloCardActions>
                    <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Learn More</MariloButton>
                </MariloCardActions>
            </MariloCard>
            <MariloCard Width="220px">
                <MariloCardImage Src="https://picsum.photos/220/120?random=2" Alt="Abstract" />
                <MariloCardHeader>Abstract</MariloCardHeader>
                <MariloCardBody>An abstract image.</MariloCardBody>
                <MariloCardActions>
                    <MariloButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">View</MariloButton>
                </MariloCardActions>
            </MariloCard>
        </div>
    </DemoSection>

    <DemoSection Title="Card Deck (Grid Layout)" Description="Use a CSS grid or flexbox wrapper to lay out multiple cards in a deck." Code="@_deckCode">
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;">
            @foreach (var item in _deckItems)
            {
                <MariloCard>
                    <MariloCardHeader>@item.Title</MariloCardHeader>
                    <MariloCardBody>@item.Description</MariloCardBody>
                    <MariloCardActions>
                        <MariloButton Size="ButtonSize.Small">Details</MariloButton>
                    </MariloCardActions>
                </MariloCard>
            }
        </div>
    </DemoSection>

    <DemoSection Title="Compact Card" Description="Cards with minimal content for quick display." Code="@_compactCode">
        <MariloCard>
            <MariloCardBody>A simple compact card with body content only.</MariloCardBody>
        </MariloCard>
    </DemoSection>
</PageSection>

<PageSection Title="Accessibility">
    <AccessibilityInfo
        KeyboardInteractions="@_keyboard"
        AriaAttributes="@_aria"
        ScreenReaderNotes="@_screenReader" />
</PageSection>

@code {
