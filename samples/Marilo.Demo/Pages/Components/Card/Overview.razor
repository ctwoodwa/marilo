@page "/components/card"
@page "/components/card/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <div class="demo-card-grid">
            @for (var i = 1; i <= 3; i++)
            {
                var idx = i;
                <MariloCard>
                    <MariloCardHeader>Card @idx</MariloCardHeader>
                    <MariloCardBody>Card body content for item @idx. This shows the basic card structure.</MariloCardBody>
                    <MariloCardActions>
                        <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Action</MariloButton>
                    </MariloCardActions>
                </MariloCard>
            }
        </div>
    </DemoSection>
</PageSection>

<PageSection Title="Appearance">
    <DemoSection Title="Card with Image" Description="Cards can include images to provide visual context." Code="@_imageCode">
        <MariloCard>
            <MariloCardHeader>Featured Card</MariloCardHeader>
            <MariloCardBody>This card demonstrates a styled card layout with header, body, and action sections.</MariloCardBody>
            <MariloCardActions>
                <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">Learn More</MariloButton>
                <MariloButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Dismiss</MariloButton>
            </MariloCardActions>
        </MariloCard>
    </DemoSection>

    <DemoSection Title="Compact Card" Description="Cards with minimal content for quick display." Code="@_compactCode">
        <MariloCard>
            <MariloCardBody>A simple compact card with body content only.</MariloCardBody>
        </MariloCard>
    </DemoSection>
</PageSection>

<PageSection Title="Accessibility">
    <AccessibilityInfo
        KeyboardInteractions="@_keyboard"
        AriaAttributes="@_aria"
        ScreenReaderNotes="@_screenReader" />
</PageSection>

@code {
    // Overview
    private const string _basicCode =
        "<MariloCard>\n" +
        "    <MariloCardHeader>Title</MariloCardHeader>\n" +
        "    <MariloCardBody>Card body content.</MariloCardBody>\n" +
        "    <MariloCardActions>\n" +
        "        <MariloButton Variant=\"ButtonVariant.Primary\" Size=\"ButtonSize.Small\">Action</MariloButton>\n" +
        "    </MariloCardActions>\n" +
        "</MariloCard>";

    // Appearance
    private const string _imageCode =
        "<MariloCard>\n" +
        "    <MariloCardHeader>Featured Card</MariloCardHeader>\n" +
        "    <MariloCardBody>Card body with description.</MariloCardBody>\n" +
        "    <MariloCardActions>\n" +
        "        <MariloButton Variant=\"ButtonVariant.Primary\" Size=\"ButtonSize.Small\">Learn More</MariloButton>\n" +
        "        <MariloButton Variant=\"ButtonVariant.Secondary\" Size=\"ButtonSize.Small\">Dismiss</MariloButton>\n" +
        "    </MariloCardActions>\n" +
        "</MariloCard>";

    private const string _compactCode =
        "<MariloCard>\n" +
        "    <MariloCardBody>A simple compact card with body content only.</MariloCardBody>\n" +
        "</MariloCard>";

    // Accessibility
    private static readonly (string Key, string Action)[] _keyboard =
    [
        ("Tab", "Moves focus to the next focusable element within or after the card"),
        ("Shift + Tab", "Moves focus to the previous focusable element"),
        ("Enter", "Activates a focused interactive element inside the card"),
    ];

    private static readonly (string Attribute, string Description)[] _aria =
    [
        ("role=\"article\"", "Can be applied to cards representing self-contained content"),
        ("role=\"region\"", "Can be applied to cards that group related content with a heading"),
        ("aria-label", "Provides an accessible name when the card has no visible heading"),
    ];

    private static readonly string[] _screenReader =
    [
        "Cards with a heading are announced by their heading text when using landmark navigation.",
        "Interactive cards (clickable) should convey their interactive nature to assistive technology.",
        "Action buttons within cards are announced individually when focused.",
    ];
}
