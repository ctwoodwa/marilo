@page "/components/fab"

<div class="demo-page">
    <h1>FAB</h1>
    <p class="demo-page-desc">The Floating Action Button (FAB) represents the primary action on a screen.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Buttons.MariloFab.html" target="_blank">API Reference</a>

    <DemoSection Title="Sizes" Code="@_sizesCode">
        <div class="demo-row">
            <MariloFab Icon="plus" Size="FabSize.Small" />
            <MariloFab Icon="plus" Size="FabSize.Medium" />
            <MariloFab Icon="plus" Size="FabSize.Large" />
        </div>
    </DemoSection>
</div>

@code {
    private const string _sizesCode =
        "<MariloFab Icon=\"plus\" Size=\"FabSize.Small\" />\n" +
        "<MariloFab Icon=\"plus\" Size=\"FabSize.Medium\" />\n" +
        "<MariloFab Icon=\"plus\" Size=\"FabSize.Large\" />";
}
