@page "/components/container"

<div class="demo-page">
    <h1>Container</h1>
    <p class="demo-page-desc">Containers center content and constrain its maximum width.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Layout.MariloContainer.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloContainer>
            <MariloAlert Variant="AlertVariant.Info">This alert is inside a container that centers and constrains its width.</MariloAlert>
        </MariloContainer>
    </DemoSection>
</div>

@code {
    private const string _basicCode =
        "<MariloContainer>\n" +
        "    <MariloAlert Variant=\"AlertVariant.Info\">This alert is inside a container.</MariloAlert>\n" +
        "</MariloContainer>";
}
