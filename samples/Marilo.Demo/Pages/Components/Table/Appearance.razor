@page "/components/table/appearance"
@layout ComponentDemoLayout

<DemoSection Title="Striped Rows" Description="Tables with alternating row colors for improved readability." Code="@_stripedCode">
    <MariloTable>
        <thead>
            <tr><th>Product</th><th>Category</th><th>Price</th></tr>
        </thead>
        <tbody>
            <tr><td>Widget A</td><td>Electronics</td><td>$19.99</td></tr>
            <tr><td>Widget B</td><td>Hardware</td><td>$29.99</td></tr>
            <tr><td>Widget C</td><td>Software</td><td>$9.99</td></tr>
            <tr><td>Widget D</td><td>Electronics</td><td>$49.99</td></tr>
        </tbody>
    </MariloTable>
</DemoSection>

@code {
    private const string _stripedCode =
        "<MariloTable>\n" +
        "    <thead>\n" +
        "        <tr><th>Product</th><th>Category</th><th>Price</th></tr>\n" +
        "    </thead>\n" +
