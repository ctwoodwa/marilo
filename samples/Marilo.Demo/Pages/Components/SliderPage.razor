@page "/components/slider"

<div class="demo-page">
    <h1>Slider</h1>
    <p class="demo-page-desc">The slider lets users select a value from a continuous range by moving a thumb along a track.</p>
    <a class="demo-api-link" href="/api/Marilo.Components.Forms.Inputs.MariloSlider.html" target="_blank">API Reference</a>

    <DemoSection Title="Basic Usage" Code="@_basicCode">
        <MariloField>
            <MariloLabel>Volume</MariloLabel>
            <MariloSlider Value="@_sliderValue" ValueChanged="@(v => _sliderValue = v)" Min="0" Max="100" Step="5" />
        </MariloField>
    </DemoSection>

    <DemoSection Title="Interactive" Code="@_interactiveCode">
        <MariloField>
            <MariloLabel>Value: @_sliderValue</MariloLabel>
            <MariloSlider Value="@_sliderValue" ValueChanged="@(v => _sliderValue = v)" Min="0" Max="100" Step="5" />
        </MariloField>
        <p><strong>Slider value:</strong> @_sliderValue</p>
    </DemoSection>
</div>

@code {
    private double _sliderValue = 50;

    private const string _basicCode =
        "<MariloSlider Value=\"@_sliderValue\" ValueChanged=\"@(v => _sliderValue = v)\" Min=\"0\" Max=\"100\" Step=\"5\" />";

    private const string _interactiveCode =
        "<MariloLabel>Value: @_sliderValue</MariloLabel>\n" +
        "<MariloSlider Value=\"@_sliderValue\" ValueChanged=\"@(v => _sliderValue = v)\" Min=\"0\" Max=\"100\" Step=\"5\" />\n" +
        "<p><strong>Slider value:</strong> @_sliderValue</p>\n\n" +
        "@code {\n" +
        "    private double _sliderValue = 50;\n" +
        "}";
}
