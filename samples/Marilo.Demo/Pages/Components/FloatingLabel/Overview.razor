@page "/components/floatinglabel"
@page "/components/floatinglabel/overview"
@layout ComponentDemoLayout

<PageSection Title="Overview">
    <DemoSection Title="Basic Usage" Description="FloatingLabel wraps inputs to provide an animated label that floats above the field when focused or filled." Code="@_basicCode">
        <div class="demo-row">
            <MariloFloatingLabel Text="Enter your name">
                <MariloTextBox @bind-Value="_name" />
            </MariloFloatingLabel>
        </div>
    </DemoSection>
</PageSection>

@code {
    private string? _name;

    private const string _basicCode =
        "<MariloFloatingLabel Text=\"Enter your name\">\n" +
        "    <MariloTextBox @bind-Value=\"_name\" />\n" +
        "</MariloFloatingLabel>";
}
