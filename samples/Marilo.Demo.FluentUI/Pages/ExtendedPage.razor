@page "/extended"

<div class="demo-page">
    <h1>Extended Components</h1>

    <DemoSection Title="Tabs" Code="@_tabsCode">
        <MariloTabStrip @bind-ActiveTabId="@_activeTabId">
            <TabStripTab Id="overview" Title="Overview"><p>This is the overview tab content. Tabs use a cascading value pattern.</p></TabStripTab>
            <TabStripTab Id="details" Title="Details"><p>Details tab with more specific information about the component.</p></TabStripTab>
            <TabStripTab Id="settings" Title="Settings">
                <MariloForm>
                    <MariloField><MariloLabel>Name</MariloLabel><MariloTextBox Value="" Placeholder="Enter name" /></MariloField>
                    <MariloField><MariloSwitch IsOn="false" Label="Enable feature" /></MariloField>
                </MariloForm>
            </TabStripTab>
        </MariloTabStrip>
    </DemoSection>

    <DemoSection Title="Accordion" Code="@_accordionCode">
        <MariloAccordion>
            <MariloAccordionItem Title="What is Marilo?"><p>Marilo is a provider-first Blazor component library. Components define behavior; providers supply visual styling.</p></MariloAccordionItem>
            <MariloAccordionItem Title="How do providers work?"><p>Each provider implements IMariloCssProvider to map component states to CSS class names.</p></MariloAccordionItem>
            <MariloAccordionItem Title="Which providers are available?"><p>Currently: Fluent UI. Planned: Bootstrap 5, Tailwind CSS, Material Design 3.</p></MariloAccordionItem>
        </MariloAccordion>
    </DemoSection>

    <DemoSection Title="Stepper" Code="@_stepperCode">
        <MariloStepper ActiveStep="@_step" ActiveStepChanged="@(s => _step = s)">
            <MariloStep Title="Account"><p>Create your account details.</p></MariloStep>
            <MariloStep Title="Profile"><p>Set up your profile information.</p></MariloStep>
            <MariloStep Title="Review"><p>Review and confirm your settings.</p></MariloStep>
        </MariloStepper>
        <div class="demo-row" style="margin-top:12px;">
            <MariloButton Size="ButtonSize.Small" Disabled="@(_step == 0)" OnClick="@(() => _step--)">Previous</MariloButton>
            <MariloButton Size="ButtonSize.Small" Variant="ButtonVariant.Primary" Disabled="@(_step >= 2)" OnClick="@(() => _step++)">Next</MariloButton>
        </div>
    </DemoSection>

    <DemoSection Title="Drawer" Code="@_drawerCode">
        <MariloButton OnClick="@(() => _drawerOpen = true)">Open Drawer</MariloButton>
        <MariloDrawer IsOpen="@_drawerOpen" OnClose="@(() => _drawerOpen = false)" Position="DrawerPosition.Right" Width="360px">
            <div style="padding:24px;">
                <h3>Drawer Content</h3>
                <p>This is a slide-out drawer panel. Click the overlay to close.</p>
                <MariloButton Variant="ButtonVariant.Primary" OnClick="@(() => _drawerOpen = false)">Close</MariloButton>
            </div>
        </MariloDrawer>
    </DemoSection>

    <DemoSection Title="Toggle Button" Code="@_toggleCode">
        <div class="demo-row">
            <MariloToggleButton Selected="@_bold" SelectedChanged="@((bool v) => _bold = v)">Bold</MariloToggleButton>
            <MariloToggleButton Selected="@_italic" SelectedChanged="@((bool v) => _italic = v)">Italic</MariloToggleButton>
            <MariloToggleButton Selected="@_underline" SelectedChanged="@((bool v) => _underline = v)">Underline</MariloToggleButton>
        </div>
        <p style="@ToggleStyle">
            Preview text with applied formatting.
        </p>
    </DemoSection>

    <DemoSection Title="Segmented Control" Code="@_segmentedCode">
        <MariloSegmentedControl Value="@_view" ValueChanged="@(v => _view = v)" Items="@(new List<string>{"List","Grid","Map"})" />
        <p style="margin-top:8px;">Selected view: <strong>@_view</strong></p>
    </DemoSection>

    <DemoSection Title="Rating" Code="@_ratingCode">
        <MariloRating Value="@_rating" ValueChanged="@(v => _rating = v)" Max="5" />
        <p style="margin-top:4px;">@_rating of 5 stars</p>
    </DemoSection>

    <DemoSection Title="Search Box" Code="@_searchCode">
        <MariloSearchBox Value="@_search" ValueChanged="@(v => _search = v)" Placeholder="Search components..." />
        @if (!string.IsNullOrEmpty(_search))
        {
            <p style="margin-top:8px;">Searching for: <strong>@_search</strong></p>
        }
    </DemoSection>

    <DemoSection Title="Date Picker" Code="@_dateCode">
        <MariloDatePicker Value="@_date" ValueChanged="@(v => _date = v)" />
        @if (_date.HasValue)
        {
            <p style="margin-top:8px;">Selected: <strong>@_date.Value.ToString("yyyy-MM-dd")</strong></p>
        }
    </DemoSection>

    <DemoSection Title="Color Picker" Code="@_colorCode">
        <MariloColorPicker Value="@_color" ValueChanged="@(v => _color = v)" />
        <div style="margin-top:8px;width:48px;height:48px;border-radius:4px;background:@_color;border:1px solid #ccc;"></div>
    </DemoSection>
</div>

@code {
    private string ToggleStyle => $"margin-top:8px;font-weight:{(_bold ? "700" : "400")};font-style:{(_italic ? "italic" : "normal")};text-decoration:{(_underline ? "underline" : "none")}";

    private string _activeTabId = "overview";
    private int _step;
    private bool _drawerOpen;
    private bool _bold, _italic, _underline;
    private string _view = "List";
    private int _rating = 3;
    private string _search = "";
    private DateOnly? _date;
    private string _color = "#0078d4";

    private const string _tabsCode = @"<MariloTabStrip @bind-ActiveTabId=""@_activeTabId"">
    <TabStripTab Id=""overview"" Title=""Overview"">Overview content</TabStripTab>
    <TabStripTab Id=""details""  Title=""Details"">Details content</TabStripTab>
    <TabStripTab Id=""settings"" Title=""Settings"">Settings content</TabStripTab>
</MariloTabStrip>";

    private const string _accordionCode = @"<MariloAccordion>
    <MariloAccordionItem Title=""What is Marilo?"">
        <p>Provider-first Blazor component library.</p>
    </MariloAccordionItem>
    <MariloAccordionItem Title=""How do providers work?"">
        <p>Implement IMariloCssProvider to supply CSS class names.</p>
    </MariloAccordionItem>
</MariloAccordion>";

    private const string _stepperCode = @"<MariloStepper ActiveStep=""@_step"" ActiveStepChanged=""@(s => _step = s)"">
    <MariloStep Title=""Account""><p>Account details.</p></MariloStep>
    <MariloStep Title=""Profile""><p>Profile info.</p></MariloStep>
    <MariloStep Title=""Review""><p>Review settings.</p></MariloStep>
</MariloStepper>";

    private const string _drawerCode = @"<MariloButton OnClick=""@(() => _drawerOpen = true)"">Open Drawer</MariloButton>
<MariloDrawer IsOpen=""@_drawerOpen"" OnClose=""@(() => _drawerOpen = false)""
    Position=""DrawerPosition.Right"" Width=""360px"">
    <div style=""padding:24px;"">Drawer content</div>
</MariloDrawer>";

    private const string _toggleCode = @"<MariloToggleButton IsActive=""@_bold"" IsActiveChanged=""@(v => _bold = v)"">Bold</MariloToggleButton>
<MariloToggleButton IsActive=""@_italic"" IsActiveChanged=""@(v => _italic = v)"">Italic</MariloToggleButton>
<MariloToggleButton IsActive=""@_underline"" IsActiveChanged=""@(v => _underline = v)"">Underline</MariloToggleButton>";

    private const string _segmentedCode = @"<MariloSegmentedControl Value=""@_view"" ValueChanged=""@(v => _view = v)""
    Items=""@(new List&lt;string&gt;{&quot;List&quot;,&quot;Grid&quot;,&quot;Map&quot;})"" />";

    private const string _ratingCode = @"<MariloRating Value=""@_rating"" ValueChanged=""@(v => _rating = v)"" Max=""5"" />";
    private const string _searchCode = @"<MariloSearchBox Value=""@_search"" ValueChanged=""@(v => _search = v)"" Placeholder=""Search..."" />";
    private const string _dateCode = @"<MariloDatePicker Value=""@_date"" ValueChanged=""@(v => _date = v)"" />";
    private const string _colorCode = @"<MariloColorPicker Value=""@_color"" ValueChanged=""@(v => _color = v)"" />";
}
