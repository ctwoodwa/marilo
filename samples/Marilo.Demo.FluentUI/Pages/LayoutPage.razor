@page "/layout"

<div class="demo-page">
    <h1>Layout</h1>

    <DemoSection Title="Grid (12-column)" Code="@_gridCode">
        <MariloGrid>
            <MariloRow>
                <MariloColumn Span="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">col-4</div></MariloColumn>
                <MariloColumn Span="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">col-4</div></MariloColumn>
                <MariloColumn Span="4"><div style="background:var(--marilo-color-primary-light);padding:12px;border-radius:4px;">col-4</div></MariloColumn>
            </MariloRow>
            <MariloRow>
                <MariloColumn Span="6"><div style="background:var(--marilo-color-info-light);padding:12px;border-radius:4px;">col-6</div></MariloColumn>
                <MariloColumn Span="6"><div style="background:var(--marilo-color-info-light);padding:12px;border-radius:4px;">col-6</div></MariloColumn>
            </MariloRow>
            <MariloRow>
                <MariloColumn Span="3"><div style="background:var(--marilo-color-success-light);padding:12px;border-radius:4px;">col-3</div></MariloColumn>
                <MariloColumn Span="6"><div style="background:var(--marilo-color-success-light);padding:12px;border-radius:4px;">col-6</div></MariloColumn>
                <MariloColumn Span="3"><div style="background:var(--marilo-color-success-light);padding:12px;border-radius:4px;">col-3</div></MariloColumn>
            </MariloRow>
        </MariloGrid>
    </DemoSection>

    <DemoSection Title="Stack" Code="@_stackCode">
        <h3>Horizontal</h3>
        <MariloStack Direction="StackDirection.Horizontal" Alignment="StackAlignment.Center">
            <MariloBadge Variant="BadgeVariant.Primary">Item 1</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Secondary">Item 2</MariloBadge>
            <MariloBadge Variant="BadgeVariant.Success">Item 3</MariloBadge>
        </MariloStack>
        <h3 style="margin-top: 16px;">Vertical</h3>
        <MariloStack Direction="StackDirection.Vertical">
            <MariloButton Variant="ButtonVariant.Primary" Size="ButtonSize.Small">First</MariloButton>
            <MariloButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Second</MariloButton>
            <MariloButton Variant="ButtonVariant.Success" Size="ButtonSize.Small">Third</MariloButton>
        </MariloStack>
    </DemoSection>

    <DemoSection Title="Divider" Code="@_dividerCode">
        <p>Content above</p>
        <MariloDivider />
        <p>Content below</p>
    </DemoSection>

    <DemoSection Title="Panel" Code="@_panelCode">
        <MariloPanel>
            <p>This content is inside a panel component with elevation and padding.</p>
        </MariloPanel>
    </DemoSection>

    <DemoSection Title="Container" Code="@_containerCode">
        <MariloContainer>
            <MariloAlert Severity="AlertSeverity.Info">This alert is inside a container.</MariloAlert>
        </MariloContainer>
    </DemoSection>
</div>

@code {
    private const string _gridCode = @"<MariloGrid>
    <MariloRow>
        <MariloColumn Span=""4"">col-4</MariloColumn>
        <MariloColumn Span=""4"">col-4</MariloColumn>
        <MariloColumn Span=""4"">col-4</MariloColumn>
    </MariloRow>
    <MariloRow>
        <MariloColumn Span=""6"">col-6</MariloColumn>
        <MariloColumn Span=""6"">col-6</MariloColumn>
    </MariloRow>
</MariloGrid>";

    private const string _stackCode = @"<MariloStack Direction=""StackDirection.Horizontal"" Alignment=""StackAlignment.Center"">
    <MariloBadge Variant=""BadgeVariant.Primary"">Item 1</MariloBadge>
    <MariloBadge Variant=""BadgeVariant.Secondary"">Item 2</MariloBadge>
</MariloStack>

<MariloStack Direction=""StackDirection.Vertical"">
    <MariloButton Size=""ButtonSize.Small"">First</MariloButton>
    <MariloButton Size=""ButtonSize.Small"">Second</MariloButton>
</MariloStack>";

    private const string _dividerCode = @"<p>Content above</p>
<MariloDivider />
<p>Content below</p>";

    private const string _panelCode = @"<MariloPanel>
    <p>Panel content with elevation and padding.</p>
</MariloPanel>";

    private const string _containerCode = @"<MariloContainer>
    <MariloAlert Severity=""AlertSeverity.Info"">Alert inside a container.</MariloAlert>
</MariloContainer>";
}