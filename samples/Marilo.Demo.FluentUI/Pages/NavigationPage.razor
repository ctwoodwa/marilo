@page "/navigation"

<div class="demo-page">
    <h1>Navigation</h1>

    <DemoSection Title="Breadcrumb" Code="@_breadcrumbCode">
        <MariloBreadcrumb>
            <MariloBreadcrumbItem Href="/">Home</MariloBreadcrumbItem>
            <MariloBreadcrumbItem Href="/navigation">Components</MariloBreadcrumbItem>
            <MariloBreadcrumbItem IsActive="true">Navigation</MariloBreadcrumbItem>
        </MariloBreadcrumb>
    </DemoSection>

    <DemoSection Title="Pagination" Code="@_paginationCode">
        <MariloPagination Page="@_page" PageChanged="@(p => _page = p)" Total="100" PageSize="10" />
        <p style="margin-top:8px;">Current page: @_page</p>
    </DemoSection>

    <DemoSection Title="Toolbar" Code="@_toolbarCode">
        <MariloToolbar>
            <MariloToolbarGroup>
                <MariloToolbarToggleButton IsActive="@_bold" IsActiveChanged="@(v => _bold = v)">Bold</MariloToolbarToggleButton>
                <MariloToolbarToggleButton IsActive="@_italic" IsActiveChanged="@(v => _italic = v)">Italic</MariloToolbarToggleButton>
                <MariloToolbarToggleButton IsActive="@_underline" IsActiveChanged="@(v => _underline = v)">Underline</MariloToolbarToggleButton>
            </MariloToolbarGroup>
            <MariloToolbarSeparator />
            <MariloToolbarButton OnClick="@(() => {})">Cut</MariloToolbarButton>
            <MariloToolbarButton OnClick="@(() => {})">Copy</MariloToolbarButton>
            <MariloToolbarButton OnClick="@(() => {})">Paste</MariloToolbarButton>
            <MariloToolbarSeparator />
            <MariloToolbarButton Disabled="true">Undo</MariloToolbarButton>
        </MariloToolbar>
        <p style="margin-top:8px;font-weight:@(_bold?"700":"400");font-style:@(_italic?"italic":"normal");text-decoration:@(_underline?"underline":"none");">
            Preview text with applied formatting.
        </p>
    </DemoSection>

    <DemoSection Title="Tree View" Code="@_treeCode">
        <MariloTreeView>
            <MariloTreeItem Title="Documents" IsExpanded="true">
                <MariloTreeItem Title="Reports" IsExpanded="false">
                    <MariloTreeItem Title="Q1 Report" />
                    <MariloTreeItem Title="Q2 Report" />
                </MariloTreeItem>
                <MariloTreeItem Title="Images" />
            </MariloTreeItem>
            <MariloTreeItem Title="Downloads" />
            <MariloTreeItem Title="Desktop" />
        </MariloTreeView>
    </DemoSection>

    <DemoSection Title="Menu" Code="@_menuCode">
        <div style="position:relative;display:inline-block;">
            <MariloButton OnClick="@(() => _menuOpen = !_menuOpen)">Open Menu</MariloButton>
            <MariloMenu IsOpen="@_menuOpen" OnClose="@(() => _menuOpen = false)">
                <MariloMenuItem OnClick="@(() => _menuOpen = false)">Edit</MariloMenuItem>
                <MariloMenuItem OnClick="@(() => _menuOpen = false)">Duplicate</MariloMenuItem>
                <MariloMenuItem OnClick="@(() => _menuOpen = false)" IsDisabled="true">Delete</MariloMenuItem>
            </MariloMenu>
        </div>
    </DemoSection>
</div>

@code {
    private int _page = 1;
    private bool _menuOpen;
    private bool _bold, _italic, _underline;

    private const string _breadcrumbCode = @"<MariloBreadcrumb>
    <MariloBreadcrumbItem Href=""/"">Home</MariloBreadcrumbItem>
    <MariloBreadcrumbItem Href=""/components"">Components</MariloBreadcrumbItem>
    <MariloBreadcrumbItem IsActive=""true"">Current Page</MariloBreadcrumbItem>
</MariloBreadcrumb>";

    private const string _paginationCode = @"<MariloPagination Page=""@_page""
    PageChanged=""@(p => _page = p)""
    Total=""100"" PageSize=""10"" />";

    private const string _toolbarCode = @"<MariloToolbar>
    <MariloToolbarGroup>
        <MariloToolbarToggleButton IsActive=""@_bold"" IsActiveChanged=""@(v => _bold = v)"">Bold</MariloToolbarToggleButton>
        <MariloToolbarToggleButton IsActive=""@_italic"" IsActiveChanged=""@(v => _italic = v)"">Italic</MariloToolbarToggleButton>
        <MariloToolbarToggleButton IsActive=""@_underline"" IsActiveChanged=""@(v => _underline = v)"">Underline</MariloToolbarToggleButton>
    </MariloToolbarGroup>
    <MariloToolbarSeparator />
    <MariloToolbarButton>Cut</MariloToolbarButton>
    <MariloToolbarButton>Copy</MariloToolbarButton>
    <MariloToolbarButton>Paste</MariloToolbarButton>
    <MariloToolbarSeparator />
    <MariloToolbarButton Disabled=""true"">Undo</MariloToolbarButton>
</MariloToolbar>";

    private const string _treeCode = @"<MariloTreeView>
    <MariloTreeItem Title=""Documents"" IsExpanded=""true"">
        <MariloTreeItem Title=""Reports"">
            <MariloTreeItem Title=""Q1 Report"" />
        </MariloTreeItem>
    </MariloTreeItem>
    <MariloTreeItem Title=""Downloads"" />
</MariloTreeView>";

    private const string _menuCode = @"<MariloButton OnClick=""@(() => _menuOpen = !_menuOpen)"">Open Menu</MariloButton>
<MariloMenu IsOpen=""@_menuOpen"" OnClose=""@(() => _menuOpen = false)"">
    <MariloMenuItem>Edit</MariloMenuItem>
    <MariloMenuItem>Duplicate</MariloMenuItem>
    <MariloMenuItem IsDisabled=""true"">Delete</MariloMenuItem>
</MariloMenu>";
}