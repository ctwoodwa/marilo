@page "/feedback"

<div class="demo-page">
    <h1>Feedback</h1>

    <DemoSection Title="Alerts" Code="@_alertsCode">
        <MariloAlert Severity="AlertSeverity.Info">This is an info alert.</MariloAlert>
        <MariloAlert Severity="AlertSeverity.Success">Operation completed successfully.</MariloAlert>
        <MariloAlert Severity="AlertSeverity.Warning">Please review your settings.</MariloAlert>
        <MariloAlert Severity="AlertSeverity.Critical">A critical error has occurred.</MariloAlert>
        <MariloAlert Severity="AlertSeverity.Info" IsDismissible="true" OnDismiss="@(() => {})">
            This alert can be dismissed.
        </MariloAlert>
    </DemoSection>

    <DemoSection Title="Progress" Code="@_progressCode">
        <div style="margin-bottom: 16px;">
            <p>Determinate: @_progress%</p>
            <MariloProgressBar Value="@_progress" />
        </div>
        <div>
            <p>Indeterminate:</p>
            <MariloProgressBar IsIndeterminate="true" />
        </div>
        <div class="demo-row" style="margin-top: 12px;">
            <MariloButton Size="ButtonSize.Small" OnClick="@(() => _progress = Math.Max(0, _progress - 10))">-10</MariloButton>
            <MariloButton Size="ButtonSize.Small" OnClick="@(() => _progress = Math.Min(100, _progress + 10))">+10</MariloButton>
        </div>
    </DemoSection>

    <DemoSection Title="Spinners" Code="@_spinnersCode">
        <div class="demo-row">
            <MariloSpinner Size="SpinnerSize.Small" />
            <MariloSpinner Size="SpinnerSize.Medium" />
            <MariloSpinner Size="SpinnerSize.Large" />
        </div>
    </DemoSection>

    <DemoSection Title="Skeletons" Code="@_skeletonsCode">
        <div class="demo-row">
            <MariloSkeleton Variant="SkeletonVariant.Text" Width="200px" Height="16px" />
            <MariloSkeleton Variant="SkeletonVariant.Circular" Width="48px" Height="48px" />
            <MariloSkeleton Variant="SkeletonVariant.Rectangular" Width="200px" Height="120px" />
        </div>
    </DemoSection>

    <DemoSection Title="Dialog" Code="@_dialogCode">
        <MariloButton OnClick="@(() => _dialogOpen = true)">Open Dialog</MariloButton>
        <MariloDialog @bind-Visible="_dialogOpen" Title="Example Dialog">
            <p>This is a dialog component rendered with pure HTML and CSS.</p>
            <MariloButton Variant="ButtonVariant.Primary" OnClick="@(() => _dialogOpen = false)">Close</MariloButton>
        </MariloDialog>
    </DemoSection>

    <DemoSection Title="Confirm Dialog" Code="@_confirmCode">
        <MariloButton Variant="ButtonVariant.Danger" OnClick="@(() => _confirmOpen = true)">Delete Item</MariloButton>
        <MariloConfirmDialog @bind-Visible="_confirmOpen"
                             Title="Confirm Delete"
                             Message="Are you sure you want to delete this item? This action cannot be undone."
                             IsDangerous="true"
                             ConfirmText="Delete"
                             OnConfirm="@(() => _confirmResult = "Confirmed!")"
                             OnCancel="@(() => _confirmResult = "Cancelled.")" />
        @if (!string.IsNullOrEmpty(_confirmResult))
        {
            <p style="margin-top: 8px;">Result: <strong>@_confirmResult</strong></p>
        }
    </DemoSection>
</div>

@code {
    private double _progress = 45;
    private bool _dialogOpen;
    private bool _confirmOpen;
    private string? _confirmResult;

    private const string _alertsCode = @"<MariloAlert Severity=""AlertSeverity.Info"">Info alert.</MariloAlert>
<MariloAlert Severity=""AlertSeverity.Success"">Success alert.</MariloAlert>
<MariloAlert Severity=""AlertSeverity.Warning"">Warning alert.</MariloAlert>
<MariloAlert Severity=""AlertSeverity.Critical"">Critical alert.</MariloAlert>
<MariloAlert Severity=""AlertSeverity.Info"" IsDismissible=""true"" OnDismiss=""@(() => {})"">
    Dismissible alert.
</MariloAlert>";

    private const string _progressCode = @"<MariloProgressBar Value=""@_progress"" />
<MariloProgressBar IsIndeterminate=""true"" />

@code { private double _progress = 45; }";

    private const string _spinnersCode = @"<MariloSpinner Size=""SpinnerSize.Small"" />
<MariloSpinner Size=""SpinnerSize.Medium"" />
<MariloSpinner Size=""SpinnerSize.Large"" />";

    private const string _skeletonsCode = @"<MariloSkeleton Variant=""SkeletonVariant.Text"" Width=""200px"" Height=""16px"" />
<MariloSkeleton Variant=""SkeletonVariant.Circular"" Width=""48px"" Height=""48px"" />
<MariloSkeleton Variant=""SkeletonVariant.Rectangular"" Width=""200px"" Height=""120px"" />";

    private const string _dialogCode = @"<MariloButton OnClick=""@(() => _dialogOpen = true)"">Open Dialog</MariloButton>
<MariloDialog @bind-Visible=""_dialogOpen"" Title=""Example Dialog"">
    <p>Dialog content here.</p>
    <MariloButton Variant=""ButtonVariant.Primary"" OnClick=""@(() => _dialogOpen = false)"">Close</MariloButton>
</MariloDialog>

@code { private bool _dialogOpen; }";

    private const string _confirmCode = @"<MariloConfirmDialog @bind-Visible=""_confirmOpen""
    Title=""Confirm Delete""
    Message=""Are you sure?""
    IsDangerous=""true""
    ConfirmText=""Delete"" />";
}