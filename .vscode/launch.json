{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Marilo Demo",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:demo",
      "program": "${workspaceFolder}/samples/Marilo.Demo/bin/Debug/net10.0/Marilo.Demo.dll",
      "args": ["--urls", "https://localhost:5301;http://localhost:5300"],
      "cwd": "${workspaceFolder}/samples/Marilo.Demo",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "PM Demo",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:pmdemo",
      "program": "${workspaceFolder}/samples/Marilo.PmDemo/Marilo.PmDemo.AppHost/bin/Debug/net10.0/Marilo.PmDemo.AppHost.dll",
      "args": [],
      "cwd": "${workspaceFolder}/samples/Marilo.PmDemo/Marilo.PmDemo.AppHost",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_ASPIRE_CONTAINER_RUNTIME": "podman",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "https://localhost:21101",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "https://localhost:22101"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
