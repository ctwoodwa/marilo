{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Marilo Demo",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet:build:demo+docs",
      "program": "${workspaceFolder}/samples/Marilo.Demo/bin/Debug/net10.0/Marilo.Demo.dll",
      "args": [],
      "cwd": "${workspaceFolder}/samples/Marilo.Demo",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Marilo Demo FluentUI",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:all",
      "program": "${workspaceFolder}/samples/Marilo.Demo.FluentUI/bin/Debug/net10.0/Marilo.Demo.FluentUI.dll",
      "args": [],
      "cwd": "${workspaceFolder}/samples/Marilo.Demo.FluentUI",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
