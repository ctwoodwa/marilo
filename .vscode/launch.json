{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Marilo Demo",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:demo",
      "program": "${workspaceFolder}/samples/Marilo.Demo/bin/Debug/net10.0/Marilo.Demo.dll",
      "args": ["--urls", "https://localhost:5301;http://localhost:5300"],
      "cwd": "${workspaceFolder}/samples/Marilo.Demo",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }    
  ]
}
