{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Marilo.Core/Marilo.Core.csproj",
            "Marilo.Components/Marilo.Components.csproj",
            "Marilo.Icons/Marilo.Icons.csproj",
            "Marilo.Providers.FluentUI/Marilo.Providers.FluentUI.csproj"
          ],
          "src": "../src"
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": [
          "articles/**/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "Marilo Documentation",
      "_appName": "Marilo",
      "_appFooter": "Marilo Component Library &mdash; MIT License",
      "_enableSearch": true
    }
  }
}
