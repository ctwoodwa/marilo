{
  "permissions": {
    "allow": [
      "Edit(.claude/orchestration/**)",
      "Write(.claude/orchestration/**)",
      "MultiEdit(.claude/orchestration/**)",
      "Edit(ICM/workspaces/**)",
      "Write(ICM/workspaces/**)",
      "MultiEdit(ICM/workspaces/**)",
      "Edit(workspaces/Marilo/workspaces/**)",
      "Write(workspaces/Marilo/workspaces/**)",
      "MultiEdit(workspaces/Marilo/workspaces/**)",
      "Edit(src/**)",
      "Write(src/**)",
      "MultiEdit(src/**)",
      "Edit(tests/**)",
      "Write(tests/**)",
      "MultiEdit(tests/**)",
      "Edit(samples/**)",
      "Write(samples/**)",
      "MultiEdit(samples/**)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "MultiEdit(docs/**)",
      "Edit(docfx/**)",
      "Write(docfx/**)",
      "MultiEdit(docfx/**)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch",
      "mcp__github__create_branch",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__add_issue_comment",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__get_file_contents"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/session-start.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/pre-read.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/pre-write.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/post-read.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/post-write.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.wolf/hooks/stop.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}